{%- doc -%}
  Heritage mega menu — nav columns or collection grid + promo banner.

  Compatible with Horizon header-menu render params.

  @param {object} parent_link - Top-level menu link with children
  @param {string} id - Unique menu grid id
  @param {object} [section] - Section object (Horizon compat)
  @param {object} [block] - Header menu block (required for promo banner)
  @param {number} [grid_columns_count] - Horizon compat (unused in heritage layout)
  @param {number} [grid_columns_count_tablet] - Horizon compat
  @param {number} [grid_columns_count_collection_images] - Horizon compat
  @param {string} [menu_content_type] - text | collection_images | featured_products | featured_collections
  @param {number} [content_aspect_ratio] - Horizon compat
  @param {number} [image_border_radius] - Image corner radius in px
{%- enddoc -%}

{% liquid
  assign menu_content_type = menu_content_type | default: 'text'
  assign image_border_radius = image_border_radius | default: 12

  assign block_settings = nil
  assign show_promo = false
  if block != blank
    assign block_settings = block.settings
    assign show_promo = true
    if block_settings.show_promo_banner == false
      assign show_promo = false
    endif
  endif

  if menu_content_type == 'collection_images'
    assign collection_links = parent_link.links | where: 'type', 'collection_link'
    assign catalog_links = parent_link.links | where: 'type', 'catalog_link'
    assign collection_list_links = parent_link.links | where: 'type', 'collections_link'
    if collection_links.size == 0 and catalog_links.size == 0 and collection_list_links.size == 0
      assign menu_content_type = 'text'
    endif
  endif

  assign link_count = parent_link.links.size
  assign column_break = link_count | plus: 1 | divided_by: 2
  assign use_collection_grid = false
  assign has_grandchildren = false
  assign collection_link_count = 0

  for link in parent_link.links
    if link.links != blank
      assign has_grandchildren = true
    endif
    if link.type == 'collection_link' or link.type == 'catalog_link' or link.type == 'collections_link'
      assign collection_link_count = collection_link_count | plus: 1
    endif
  endfor

  unless has_grandchildren
    if link_count > 0 and link_count <= 8 and collection_link_count == link_count
      assign use_collection_grid = true
    elsif menu_content_type == 'collection_images' and link_count > 0 and link_count <= 8
      assign use_collection_grid = true
    endif
  endunless
%}

<div
  class="mega-menu__heritage{% unless show_promo %} mega-menu__heritage--no-promo{% endunless %}"
  data-menu-grid-id="{{ id }}"
  style="--menu-image-border-radius: {{ image_border_radius }}px;"
>
  <div class="mega-menu__heritage-nav{% if use_collection_grid %} mega-menu__heritage-nav--grid{% endif %}">
    {% if use_collection_grid %}
      <div class="mega-menu__collection-grid" data-menu-list-id="{{ id }}">
        {% for link in parent_link.links %}
          {%- capture collection_image_sizes -%}
            {%- render 'util-mega-menu-img-sizes-attr',
              menu_content_type: 'collection_images',
              settings: settings,
              grid_columns: grid_columns_count,
              grid_columns_tablet: grid_columns_count_tablet,
              grid_columns_collection_images: grid_columns_count_collection_images,
              parent_links_size: parent_link.links.size,
              columns_per_item: 2
            -%}
          {%- endcapture -%}
          <a href="{{ link.url }}" class="mega-menu__collection-card">
            <span class="mega-menu__collection-media" style="--mega-radius: {{ image_border_radius }}px;">
              {% render 'link-featured-image',
                link: link,
                class: 'mega-menu__collection-image',
                sizes: collection_image_sizes
              %}
            </span>
            <span class="mega-menu__collection-title">
              <span>{{ link.title }}</span>
             <svg width="7" height="11" viewBox="0 0 7 11" fill="none" xmlns="http://www.w3.org/2000/svg">
<path fill-rule="evenodd" clip-rule="evenodd" d="M5.8925 5.8925L1.17833 10.6067L0 9.42833L4.125 5.30333L0 1.17833L1.17833 0L5.8925 4.71417C6.04873 4.87044 6.13649 5.08236 6.13649 5.30333C6.13649 5.5243 6.04873 5.73623 5.8925 5.8925Z" fill="black"/>
</svg>

            </span>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="mega-menu__text-columns" data-menu-list-id="{{ id }}">
        <div class="mega-menu__text-col">
          {% for link in parent_link.links %}
            {% if forloop.index <= column_break %}
              <div class="mega-menu__group">
                <a href="{{ link.url }}" class="mega-menu__group-heading">
                  <span>{{ link.title }}</span>
                 <svg width="7" height="11" viewBox="0 0 7 11" fill="none" xmlns="http://www.w3.org/2000/svg">
<path fill-rule="evenodd" clip-rule="evenodd" d="M5.8925 5.8925L1.17833 10.6067L0 9.42833L4.125 5.30333L0 1.17833L1.17833 0L5.8925 4.71417C6.04873 4.87044 6.13649 5.08236 6.13649 5.30333C6.13649 5.5243 6.04873 5.73623 5.8925 5.8925Z" fill="black"/>
</svg>

                </a>
                {% if link.links != blank %}
                  <ul class="mega-menu__group-links list-unstyled" role="list">
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}" class="mega-menu__child-link">{{ child_link.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="mega-menu__text-col">
          {% for link in parent_link.links %}
            {% if forloop.index > column_break %}
              <div class="mega-menu__group">
                <a href="{{ link.url }}" class="mega-menu__group-heading">
                  <span>{{ link.title }}</span>
                 <svg width="7" height="11" viewBox="0 0 7 11" fill="none" xmlns="http://www.w3.org/2000/svg">
<path fill-rule="evenodd" clip-rule="evenodd" d="M5.8925 5.8925L1.17833 10.6067L0 9.42833L4.125 5.30333L0 1.17833L1.17833 0L5.8925 4.71417C6.04873 4.87044 6.13649 5.08236 6.13649 5.30333C6.13649 5.5243 6.04873 5.73623 5.8925 5.8925Z" fill="black"/>
</svg>

                </a>
                {% if link.links != blank %}
                  <ul class="mega-menu__group-links list-unstyled" role="list">
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}" class="mega-menu__child-link">{{ child_link.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if show_promo and block_settings != blank %}
    {% render 'mega-menu-promo', settings: block_settings %}
  {% endif %}
</div>

{% style %}
  [data-menu-grid-id="{{ id }}"] {
    --menu-columns-desktop: {{ grid_columns_count | default: 6 }};
    --menu-columns-tablet: {{ grid_columns_count_tablet | default: 4 }};
  }

  [data-menu-list-id="{{ id }}"] {
    --menu-columns-desktop: 2;
    --menu-columns-tablet: 2;
  }
{% endstyle %}

{%- style -%}
  .mega-menu__heritage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 643px;
    gap: 0;
    align-items: stretch;
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    padding: 0;
    background: #fff;
  }

  .mega-menu__heritage--no-promo {
    grid-template-columns: 1fr;
    max-width: 960px;
  }
header .mega-menu.section {
    padding-top: 80px !important;
    display: block;
}
  .mega-menu__heritage-nav {
    min-width: 0;
    padding: 28px 28px 28px 40px;
  }

  .mega-menu__text-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
  }

  .mega-menu__text-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mega-menu__group-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    margin: 0;
    border-bottom: 1px solid #000 !important; 
    font-family: var(--menu-parent-font-family, var(--font-heading--family, inherit));
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--menu-parent-font-color, #111);
    text-decoration: none;
    text-transform: none;
  }

  .mega-menu__group-heading:hover {
    color: var(--menu-parent-active-font-color, #444);
  }

  .mega-menu__group-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 6px 0 0;
    padding: 0;
  }

  .mega-menu__child-link {
    font-family: var(--menu-child-font-family, inherit);
    font-size: 13px;
    line-height: 1.5;
    color: var(--menu-child-font-color, #333);
    text-decoration: none;
    display: block;
    padding: 4px 0;
  }

  .mega-menu__child-link:hover {
    color: var(--menu-child-active-font-color, #111);
  }

  .mega-menu__collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    max-width: 480px;
  }

  .mega-menu__collection-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .mega-menu__collection-media {
    display: block;
    aspect-ratio: 3 / 4;
    background: #e8e0d0;    border-radius: 8px;
    overflow: hidden;
  }

  .mega-menu__collection-media .mega-menu__collection-image,
  .mega-menu__collection-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .mega-menu__collection-card:hover .mega-menu__collection-image,
  .mega-menu__collection-card:hover img {
    transform: scale(1.05);
  }

  .mega-menu__collection-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: #111;
    padding: 8px 4px 0;
  }

  .mega-menu__chevron {
    flex-shrink: 0;
    color: #999;
  }

  /* Right promo panel */
  .hzn-mega-panel__right {
    padding: 24px 40px 24px 28px;
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  .hzn-mega-promo {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 411px;
    background: #c8b89a;
    width: 643px;
    max-width: 100%;
    margin-left: auto;
  }

  .hzn-mega-promo__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .hzn-mega-promo__overlay-text {
    position: relative;
    z-index: 2;
    padding: 24px 28px;
    max-width: 60%;
  }

  .hzn-mega-promo__heading {
    margin: 0 0 10px;
    font-weight: 500;
    font-style: italic;
    font-size: 35px;
    line-height: 120%;
    letter-spacing: 0;
    color: #111;
        font-family: Lora !important;
  }

  .hzn-mega-promo__sub {
    margin: 0 0 14px;
    font-family: 'Neue Montreal', var(--font-body--family, sans-serif);
    font-weight: 400;
    font-size: 14px;
        line-height: 1.4;    white-space: break-spaces;
    letter-spacing: 0.02em;
    color: #000;
    max-width: 340px;
    word-break: auto-phrase;
  }

  .hzn-mega-promo__payment {
    margin-bottom: 16px;
  }

  .hzn-mega-promo__payment-img {
    display: block;
    width: auto;
    max-width: 100%;
    height: 22px;
    object-fit: contain;
    object-position: left center;
  }

  .hzn-mega-promo__icon-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hzn-mega-promo__icon-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Neue Montreal', var(--font-body--family, sans-serif);
    font-size: 13px;
    font-weight: 500;
    line-height: 100%;
    letter-spacing: 0.02em;
    color: #222;
  }

  .hzn-mega-promo__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .hzn-mega-promo__icon-wrap img {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    .mega-menu__heritage {
      grid-template-columns: 1fr;
    }

    .mega-menu__heritage-nav {
      padding: 20px 24px;
      border-right: none;
    }

    .hzn-mega-panel__right {
      padding: 0 24px 24px;
    }

    .hzn-mega-promo {
      width: 100%;
      max-width: none;
      height: auto;
      min-height: 320px;
      margin-left: 0;
    }

    .hzn-mega-promo__overlay-text {
      max-width: 75%;
    }

    .mega-menu__text-columns {
      grid-template-columns: 1fr;
    }

    .mega-menu__collection-grid {
      max-width: none;
    }
  }
{%- endstyle -%}
