{% doc %}
  Resolves a colourway to a sibling product and prints data attributes
  so swatches can navigate to the correct colourway of the SAME dress.

  Never matches a product just because its title contains the colour name.
  That sent shoppers to a different item that happened to be a similar colour.

  @param {object} product - The product currently being rendered
  @param {string} color_label - Colour name shown on the swatch
  @param {object} [metafield_item] - Optional color metafield / metaobject entry
  @param {object} [option_value] - Optional product option value (combined listings)
  @param {string} [selected_color_value] - Currently selected colour on this product

  @example
  {% render 'color-swatch-attrs', product: product, color_label: color_label, metafield_item: item %}
{% enddoc %}

{%- liquid
  assign color_label_raw = color_label | strip
  assign color_down = color_label_raw | downcase | replace: '&', 'and' | replace: '  ', ' ' | strip
  assign color_handle = color_down | handleize
  assign color_handle_us = color_handle | replace: 'multicoloured', 'multicolored'
  assign color_handle_uk = color_handle | replace: 'multicolored', 'multicoloured'

  assign sibling = nil
  assign sibling_url = ''
  assign sibling_available = true
  assign is_current_color = false
  assign sibling_from_guess = false

  assign family = product.title | split: ' ' | first | handleize
  if family == blank
    assign family = product.handle | split: '-' | first
  endif

  if selected_color_value != blank
    assign selected_down = selected_color_value | downcase | replace: '&', 'and' | replace: '  ', ' ' | strip
    if selected_down == color_down
      assign is_current_color = true
    endif
  endif

  if option_value != blank and option_value.product_url != blank
    assign sibling_url = option_value.product_url
    if option_value.available == false
      assign sibling_available = false
    endif
  endif

  if metafield_item != blank
    if metafield_item.product.value != blank
      assign sibling = metafield_item.product.value
    elsif metafield_item.product != blank and metafield_item.product.url != blank
      assign sibling = metafield_item.product
    endif
    if sibling_url == blank
      if metafield_item.product_url != blank
        assign sibling_url = metafield_item.product_url
      elsif metafield_item.url != blank
        assign sibling_url = metafield_item.url
      endif
    endif
  endif

  if sibling == nil and is_current_color
    assign sibling = product
  endif

  if sibling == nil
    assign title_down = product.title | downcase | replace: '&', 'and'
    if title_down contains color_down
      assign sibling = product
    endif
  endif

  assign current_style = ''
  assign current_parts = product.handle | split: '-'
  for part in current_parts
    if part == 'midi' or part == 'maxi' or part == 'mini' or part == 'cape' or part == 'wrap' or part == 'woven' or part == 'skater' or part == 'jumpsuit' or part == 'trousers' or part == 'skirt' or part == 'jacket' or part == 'shorts' or part == 'headband' or part == 'earrings' or part == 'turban' or part == 'socks' or part == 'umbrella' or part == 'kente' or part == 'ankara' or part == 'shoulder'
      assign current_style = current_style | append: part | append: ','
    endif
  endfor

  if sibling == nil and color_handle != blank and family != blank
    assign guess_handles = family | append: '-' | append: color_handle | append: '-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle | append: '-midi-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle | append: '-maxi-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle | append: '-cape-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle | append: '-african-print-midi-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle | append: '-african-print-cape-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle | append: '-modern-ankara-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle_us | append: '-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle_uk | append: '-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle_uk | append: '-midi-dress'
    assign guess_handles = guess_handles | append: ',' | append: family | append: '-' | append: color_handle_us | append: '-midi-dress'

    assign guess_list = guess_handles | split: ','
    for guess in guess_list
      if sibling == nil and guess != blank and guess != product.handle
        assign candidate = all_products[guess]
        if candidate != blank and candidate.url != blank
          assign cand_family = candidate.title | split: ' ' | first | handleize
          if cand_family == family
            assign style_ok = true

            if product.type != blank and candidate.type != blank
              assign cur_type_down = product.type | downcase | strip
              assign cand_type_down = candidate.type | downcase | strip
              unless cur_type_down == cand_type_down
                assign style_ok = false
              endunless
            endif

            assign cand_style = ''
            assign cand_parts = candidate.handle | split: '-'
            for part in cand_parts
              if part == 'midi' or part == 'maxi' or part == 'mini' or part == 'cape' or part == 'wrap' or part == 'woven' or part == 'skater' or part == 'jumpsuit' or part == 'trousers' or part == 'skirt' or part == 'jacket' or part == 'shorts' or part == 'headband' or part == 'earrings' or part == 'turban' or part == 'socks' or part == 'umbrella' or part == 'kente' or part == 'ankara' or part == 'shoulder'
                assign cand_style = cand_style | append: part | append: ','
              endif
            endfor

            comment
              Only a conflicting style blocks the match. Handles like
              "oyin-red-and-yellow-dress" carry no style word at all and are
              still genuine colourways of the same dress.
            endcomment
            if style_ok and current_style != blank and cand_style != blank
              assign shared_style = false
              assign current_style_list = current_style | split: ','
              for marker in current_style_list
                if marker != blank
                  assign marker_needle = marker | append: ','
                  if cand_style contains marker_needle
                    assign shared_style = true
                  endif
                endif
              endfor
              unless shared_style
                assign style_ok = false
              endunless
            endif
            if style_ok
              assign sibling = candidate
              assign sibling_from_guess = true
            endif
          endif
        endif
      endif
    endfor
  endif

  if sibling != nil
    if sibling_from_guess
      assign sib_family = sibling.title | split: ' ' | first | handleize
      if sib_family == family
        assign sibling_url = sibling.url
        assign sibling_available = sibling.available
      else
        assign sibling = nil
      endif
    else
      assign sibling_url = sibling.url
      assign sibling_available = sibling.available
    endif
  endif

  if sibling_url == blank and is_current_color
    assign sibling_url = product.url
    assign sibling_available = product.available
  endif
-%}
{%- if sibling_url != blank -%}
  data-product-url="{{ sibling_url }}"
{%- endif -%}
data-color-available="{% if sibling_available %}true{% else %}false{% endif %}"
