  {% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {product} product - Product object
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product: product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product.media.size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

{% liquid
  if settings.background_color != blank
    render 'contrast-override', background_color: settings.background_color, section_id: section_id
  endif
%}

<div
  class="section-background{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"
></div>
<div
  class="product-information section section--{{ content_width }} spacing-style{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
  data-section-id="{{ section_id }}"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <product-component
    class="{{ product_grid_class }}"
    data-product-grid-content
    {% # theme-check-disable UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
    {% # theme-check-enable UnknownFilter %}
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {{ media_gallery }}
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ product_details }}
      {% endif %}
    {% endfor %}
  </product-component>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  .product-information__media .slideshow-controls__thumbnails-container {
    scroll-behavior: auto;
  }

  /* One image per swipe in the main product gallery */
  .product-information__media slideshow-slides {
    scroll-snap-type: x mandatory;
    scroll-behavior: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .product-information__media slideshow-slide {
    flex: 0 0 100% !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 2 / 3;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(.product-information--media-none) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(.product-information--media-none) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    --details-max-width: var(--sidebar-width);
    max-width: var(--details-max-width);
  }

  @media screen and (min-width: 1600px) {
    .product-information__grid--limit-details .product-details > .group-block {
      --details-max-width: 32rem;
    }
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }
{% endstylesheet %}

<script>
  (function () {
    function getGalleryRoot(node) {
      return (
        node.closest('.product-information__media') ||
        node.closest('media-gallery') ||
        node.closest('.product-information')
      );
    }

    function pauseInactiveGalleryMedia(gallery, activeSlide) {
      if (!gallery) return;

      gallery.querySelectorAll('deferred-media, product-model').forEach(function (mediaEl) {
        if (activeSlide && activeSlide.contains(mediaEl)) return;
        if (typeof mediaEl.pauseMedia === 'function') {
          mediaEl.pauseMedia();
        }
      });

      gallery.querySelectorAll('video').forEach(function (video) {
        if (activeSlide && activeSlide.contains(video)) return;
        video.pause();
      });
    }

    function playIframeVideo(iframe) {
      if (!iframe || !iframe.contentWindow) return;

      iframe.contentWindow.postMessage(
        iframe.dataset.videoType === 'youtube'
          ? '{"event":"command","func":"playVideo","args":""}'
          : '{"method":"play"}',
        '*'
      );
    }

    function slideHasVideo(slide) {
      if (!slide) return false;

      return Boolean(
        slide.matches('.product-media-container--video, .product-media-container--external_video') ||
          slide.querySelector(
            '.product-media-container--video, .product-media-container--external_video, deferred-media, video, iframe[data-video-type]'
          )
      );
    }

    function playVideoElement(video) {
      if (!video) return;
      video.muted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('muted', '');
      var playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(function () {});
      }
    }

    function playSlideVideo(slide) {
      if (!slide || !slideHasVideo(slide)) return;

      var deferred = slide.querySelector('deferred-media, product-model');
      if (deferred) {
        if (!deferred.getAttribute('data-media-loaded') && typeof deferred.loadContent === 'function') {
          deferred.loadContent(false);
        }

        if (typeof deferred.playMedia === 'function') {
          deferred.playMedia();
        }
      }

      slide.querySelectorAll('video').forEach(playVideoElement);

      var iframe = slide.querySelector('iframe[data-video-type]');
      if (iframe) {
        playIframeVideo(iframe);
      }
    }

    function playSlideVideoWithRetry(slide) {
      if (!slide || !slideHasVideo(slide)) return;

      playSlideVideo(slide);

      window.requestAnimationFrame(function () {
        playSlideVideo(slide);
      });

      [80, 180, 400, 800].forEach(function (delay) {
        window.setTimeout(function () {
          playSlideVideo(slide);
        }, delay);
      });

      var deferred = slide.querySelector('deferred-media, product-model');
      if (!deferred || deferred.__naVideoObserver) return;

      var observer = new MutationObserver(function () {
        playSlideVideo(slide);
      });

      observer.observe(deferred, { childList: true, subtree: true, attributes: true, attributeFilter: ['data-media-loaded'] });
      deferred.__naVideoObserver = observer;

      deferred.querySelectorAll('video').forEach(function (video) {
        if (video.readyState >= 2) {
          playVideoElement(video);
        } else {
          video.addEventListener(
            'loadeddata',
            function () {
              playVideoElement(video);
            },
            { once: true }
          );
        }
      });
    }

    function getActiveSlideIndex(slideshow) {
      if (!slideshow) return -1;

      if (typeof slideshow.current === 'number' && !isNaN(slideshow.current)) {
        return slideshow.current;
      }

      var slides = slideshow.querySelectorAll('slideshow-slide');
      var activeIndex = -1;
      var activeCount = 0;

      for (var i = 0; i < slides.length; i++) {
        if (slides[i].getAttribute('aria-hidden') === 'false') {
          activeIndex = i;
          activeCount++;
        }
      }

      if (activeCount !== 1) return -1;
      return activeIndex;
    }

    function getThumbnailControls(slideshow) {
      var gallery = getGalleryRoot(slideshow);
      if (!gallery) return null;

      return (
        gallery.querySelector('slideshow-controls[thumbnails]') ||
        slideshow.querySelector('slideshow-controls[thumbnails]')
      );
    }

    function getThumbnailsScrollContainer(controls) {
      if (!controls) return null;

      return (
        controls.querySelector('.slideshow-controls__thumbnails-container') ||
        controls.querySelector('scroll-hint.slideshow-controls__thumbnails-container')
      );
    }

    function centerThumbnail(slideshow, index, smooth) {
      if (!slideshow || index < 0) return;

      var controls = getThumbnailControls(slideshow);
      if (!controls) return;

      var thumbnails = controls.querySelectorAll('.slideshow-controls__thumbnail');
      if (!thumbnails.length || index >= thumbnails.length) return;

      thumbnails.forEach(function (thumb, thumbIndex) {
        thumb.setAttribute('aria-selected', thumbIndex === index ? 'true' : 'false');
      });

      var container = getThumbnailsScrollContainer(controls);
      var activeThumb = thumbnails[index];
      if (!container || !activeThumb) return;

      var maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;

      var containerRect = container.getBoundingClientRect();
      var thumbRect = activeThumb.getBoundingClientRect();
      var thumbCenterInScroll =
        thumbRect.left - containerRect.left + container.scrollLeft + thumbRect.width / 2;
      var targetScroll = thumbCenterInScroll - container.clientWidth / 2;

      targetScroll = Math.max(0, Math.min(maxScroll, targetScroll));

      if (Math.abs(container.scrollLeft - targetScroll) < 3) return;

      container.scrollTo({
        left: targetScroll,
        behavior: smooth ? 'smooth' : 'auto',
      });
    }

    var thumbnailCenterState = new WeakMap();

    function scheduleThumbnailCenter(slideshow, index, smooth) {
      if (!slideshow || index < 0) return;

      var state = thumbnailCenterState.get(slideshow) || {};
      state.pendingIndex = index;
      state.pendingSmooth = smooth;

      if (state.timer) {
        window.clearTimeout(state.timer);
      }

      state.timer = window.setTimeout(function () {
        state.timer = null;
        window.requestAnimationFrame(function () {
          centerThumbnail(slideshow, state.pendingIndex, state.pendingSmooth);
        });
      }, 48);

      thumbnailCenterState.set(slideshow, state);
    }

    function getActiveSlide(slideshow, event) {
      if (event && event.detail && event.detail.slide) {
        return event.detail.slide;
      }

      if (!slideshow) return null;

      var slides = slideshow.querySelectorAll('slideshow-slide');
      for (var i = 0; i < slides.length; i++) {
        if (slides[i].getAttribute('aria-hidden') === 'false') {
          return slides[i];
        }
      }

      return (
        slideshow.querySelector('slideshow-slide[aria-hidden="false"]') ||
        slideshow.querySelector('.product-media-container[aria-hidden="false"]')
      );
    }

    function handleActiveSlide(slideshow, event) {
      var gallery = getGalleryRoot(slideshow);
      var slide = getActiveSlide(slideshow, event);

      pauseInactiveGalleryMedia(gallery, slide);

      if (!slide || !slideHasVideo(slide)) return;

      playSlideVideoWithRetry(slide);
    }

    function onSlideshowSelect(event) {
      var slideshow = event.target;
      if (!(slideshow instanceof Element)) return;
      if (!slideshow.matches('slideshow-component')) return;
      if (!slideshow.closest('.product-information, .product-information__media, media-gallery')) return;

      var detail = event.detail || {};
      var index = typeof detail.index === 'number' ? detail.index : getActiveSlideIndex(slideshow);

      window.requestAnimationFrame(function () {
        if (detail.trigger === 'scroll' && index >= 0) {
          scheduleThumbnailCenter(slideshow, index, false);
        }

        handleActiveSlide(slideshow, event);
      });
    }

    function observeSlides(slideshow) {
      if (slideshow.__videoSlideObserver) return;

      var observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
          if (mutation.attributeName !== 'aria-hidden') return;
          var slide = mutation.target;
          if (!(slide instanceof Element)) return;
          if (slide.getAttribute('aria-hidden') !== 'false') return;
          if (!slide.matches('slideshow-slide, .product-media-container')) return;

          window.requestAnimationFrame(function () {
            handleActiveSlide(slideshow);
          });
        });
      });

      slideshow.querySelectorAll('slideshow-slide, .product-media-container').forEach(function (slide) {
        observer.observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] });
      });

      slideshow.__videoSlideObserver = observer;
    }

    function bindSingleSlideNavigation(slideshow) {
      var slidesEl = slideshow.querySelector('slideshow-slides');
      if (!slidesEl || slidesEl.dataset.naSingleSlideBound === 'true') return;

      var slides = Array.prototype.slice.call(slideshow.querySelectorAll('slideshow-slide'));
      if (slides.length <= 1) return;

      slidesEl.dataset.naSingleSlideBound = 'true';

      var SLIDE_ANIM_MS = 200;
      var SWIPE_THRESHOLD = 16;

      function easeOutCubic(t) {
        return 1 - Math.pow(1 - t, 3);
      }

      function setProgrammaticScroll(active) {
        if (active) {
          slidesEl.dataset.naProgrammaticScroll = 'true';
        } else {
          delete slidesEl.dataset.naProgrammaticScroll;
        }
      }

      function animateScrollTo(targetLeft, onDone) {
        var startLeft = slidesEl.scrollLeft;
        var distance = targetLeft - startLeft;

        if (Math.abs(distance) < 1) {
          setProgrammaticScroll(false);
          if (onDone) onDone();
          return;
        }

        if (slidesEl.__naSlideAnimFrame) {
          window.cancelAnimationFrame(slidesEl.__naSlideAnimFrame);
        }

        setProgrammaticScroll(true);
        var startTime = null;

        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          var progress = Math.min((timestamp - startTime) / SLIDE_ANIM_MS, 1);
          slidesEl.scrollLeft = startLeft + distance * easeOutCubic(progress);

          if (progress < 1) {
            slidesEl.__naSlideAnimFrame = window.requestAnimationFrame(step);
          } else {
            slidesEl.__naSlideAnimFrame = null;
            setProgrammaticScroll(false);
            if (onDone) onDone();
          }
        }

        slidesEl.__naSlideAnimFrame = window.requestAnimationFrame(step);
      }

      function getSlideScrollLeft(index) {
        var slide = slides[index];
        return slide ? slide.offsetLeft : 0;
      }

      function getDragBounds(index) {
        return {
          min: index > 0 ? getSlideScrollLeft(index - 1) : getSlideScrollLeft(index),
          max: index < slides.length - 1 ? getSlideScrollLeft(index + 1) : getSlideScrollLeft(index),
        };
      }
      function getNearestSlideIndex() {
        var scrollLeft = slidesEl.scrollLeft;
        var nearestIndex = 0;
        var minDistance = Infinity;

        slides.forEach(function (slide, index) {
          var distance = Math.abs(slide.offsetLeft - scrollLeft);
          if (distance < minDistance) {
            minDistance = distance;
            nearestIndex = index;
          }
        });

        return nearestIndex;
      }

      function goToSlideIndex(index, smooth) {
        var safeIndex = Math.max(0, Math.min(slides.length - 1, index));
        var targetLeft = getSlideScrollLeft(safeIndex);

        if (slidesEl.__naSlideAnimFrame) {
          window.cancelAnimationFrame(slidesEl.__naSlideAnimFrame);
          slidesEl.__naSlideAnimFrame = null;
        }

        function finish() {
          if (typeof slideshow.select === 'function') {
            try {
              slideshow.select(safeIndex, null, { animate: false });
            } catch (e) {}
          }

          scheduleThumbnailCenter(slideshow, safeIndex, false);
          handleActiveSlide(slideshow);
        }

        if (smooth) {
          animateScrollTo(targetLeft, finish);
        } else {
          setProgrammaticScroll(true);
          slidesEl.scrollLeft = targetLeft;
          setProgrammaticScroll(false);
          finish();
        }
      }

      var scrollEndTimer;
      slidesEl.addEventListener(
        'scroll',
        function () {
          if (slidesEl.dataset.naProgrammaticScroll === 'true') return;

          window.clearTimeout(scrollEndTimer);
          scrollEndTimer = window.setTimeout(function () {
            var nearestIndex = getNearestSlideIndex();
            var targetSlide = slides[nearestIndex];
            if (!targetSlide) return;

            if (Math.abs(slidesEl.scrollLeft - targetSlide.offsetLeft) > 2) {
              goToSlideIndex(nearestIndex, true);
            }
          }, 50);
        },
        { passive: true }
      );

      var touchStartX = 0;
      var touchStartY = 0;
      var touchStartScrollLeft = 0;
      var gestureStartIndex = 0;
      var touchAxis = null;

      slidesEl.addEventListener(
        'touchstart',
        function (event) {
          if (!event.touches.length) return;

          if (slidesEl.__naSlideAnimFrame) {
            window.cancelAnimationFrame(slidesEl.__naSlideAnimFrame);
            slidesEl.__naSlideAnimFrame = null;
            setProgrammaticScroll(false);
          }

          touchStartX = event.touches[0].clientX;
          touchStartY = event.touches[0].clientY;
          touchStartScrollLeft = slidesEl.scrollLeft;
          touchAxis = null;
          gestureStartIndex = getNearestSlideIndex();
        },
        { passive: true }
      );

      slidesEl.addEventListener(
        'touchmove',
        function (event) {
          if (!event.touches.length) return;

          var deltaX = event.touches[0].clientX - touchStartX;
          var deltaY = event.touches[0].clientY - touchStartY;

          if (touchAxis === null && (Math.abs(deltaX) > 6 || Math.abs(deltaY) > 6)) {
            touchAxis = Math.abs(deltaX) > Math.abs(deltaY) ? 'x' : 'y';
          }

          if (touchAxis === 'x') {
            event.preventDefault();
            var bounds = getDragBounds(gestureStartIndex);
            var nextScroll = touchStartScrollLeft - deltaX;
            slidesEl.scrollLeft = Math.max(bounds.min, Math.min(bounds.max, nextScroll));
          }
        },
        { passive: false }
      );

      slidesEl.addEventListener(
        'touchend',
        function (event) {
          if (touchAxis !== 'x' || !event.changedTouches.length) return;

          var deltaX = touchStartX - event.changedTouches[0].clientX;
          var targetIndex = gestureStartIndex;

          if (Math.abs(deltaX) >= SWIPE_THRESHOLD) {
            targetIndex = gestureStartIndex + (deltaX > 0 ? 1 : -1);
          }

          goToSlideIndex(targetIndex, true);
        },
        { passive: true }
      );

      slidesEl.addEventListener(
        'touchcancel',
        function () {
          if (touchAxis === 'x') {
            goToSlideIndex(gestureStartIndex, true);
          }
        },
        { passive: true }
      );
    }

    function bindProductGallery(scope) {
      var root = scope && scope.querySelector ? scope : document;

      root.querySelectorAll('.product-information slideshow-component, media-gallery slideshow-component').forEach(function (slideshow) {
        if (!slideshow.__videoAutoplayBound) {
          slideshow.__videoAutoplayBound = true;
          slideshow.addEventListener('slideshow:select', onSlideshowSelect);
        }
        bindSingleSlideNavigation(slideshow);
        observeSlides(slideshow);
        handleActiveSlide(slideshow);
      });
    }

    if (!window.__productGalleryVideoAutoplayBound) {
      window.__productGalleryVideoAutoplayBound = true;
      document.addEventListener('slideshow:select', onSlideshowSelect, true);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        bindProductGallery();
      });
    } else {
      bindProductGallery();
    }

    document.addEventListener('shopify:section:load', function (event) {
      bindProductGallery(event.target);
    });
  })();
</script>
