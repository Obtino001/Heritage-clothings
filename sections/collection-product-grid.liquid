{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = section.settings.columns_tablet
  assign columns_mobile = section.settings.columns_mobile
  assign products_per_page = section.settings.products_per_page | default: 18

  assign promo_block = nil
  for block in section.blocks
    if block.type == 'promo_banner'
      assign promo_block = block
      break
    endif
  endfor

  assign subcategory_count = 0
  for block in section.blocks
    if block.type == 'subcategory'
      assign subcategory_count = subcategory_count | plus: 1
    endif
  endfor

  assign parent_collection = section.settings.parent_collection
  assign on_parent_collection = false
  if parent_collection != blank and parent_collection.handle == collection.handle
    assign on_parent_collection = true
  endif

  assign page_title = collection.title
  if page_title == blank and collection.handle != blank
    assign page_title = collection.handle | replace: '-', ' '
  endif
-%}

<div
  id="CollectionGrid-{{ section.id }}"
  class="cg-section na-section"
  data-section-id="{{ section.id }}"
  data-columns="{{ columns_desktop }}"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  style="
    --na-padding-top: {{ section.settings.padding_top }}px;
    --na-padding-bottom: {{ section.settings.padding_bottom }}px;
    --na-gap: {{ section.settings.card_gap }}px;
    --na-image-radius: {{ section.settings.image_radius }}px;
    --na-badge-sale-bg: {{ section.settings.badge_sale_color }};
    --na-badge-new-bg: {{ section.settings.badge_new_color }};
    --na-sale-price-color: {{ section.settings.sale_price_color }};
    --na-rating-bg: {{ section.settings.rating_bg_color }};
    --cg-columns: {{ columns_desktop }};
    --cg-columns-tablet: {{ columns_tablet }};
    --cg-columns-mobile: {{ columns_mobile }};
    --cg-pagination-active: {{ section.settings.pagination_active_color }};
    --cg-pagination-text: {{ section.settings.pagination_text_color }};
  "
>
  <div class="page-width cg-section__inner">
    <header class="cg-header">
      <h1 class="cg-header__title">{{ page_title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="cg-header__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.show_subcategories and subcategory_count > 0 -%}
      <nav class="cg-subcats" aria-label="Subcategories">
        <ul class="cg-subcats__list" role="list">
          {%- if parent_collection != blank -%}
            <li class="cg-subcats__item">
              <a
                href="{{ parent_collection.url }}"
                class="cg-subcats__btn{% if on_parent_collection %} is-active{% endif %}"
                {% if on_parent_collection %}aria-current="page"{% endif %}
              >
                <span class="cg-subcats__circle cg-subcats__circle--all">
                  <span class="cg-subcats__all-text">{{ section.settings.all_subcategory_label | default: 'All' }}</span>
                  <span class="cg-subcats__check" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  </span>
                </span>
                <span class="cg-subcats__label">{{ section.settings.all_subcategory_label | default: 'All' }}</span>
              </a>
            </li>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'subcategory' -%}
              {%- liquid
                assign sub_collection = block.settings.collection
                assign sub_label = block.settings.label
                assign sub_image = block.settings.image
                if sub_label == blank and sub_collection != blank
                  assign sub_label = sub_collection.title
                endif
                if sub_image == blank and sub_collection != blank and sub_collection.image != blank
                  assign sub_image = sub_collection.image
                endif
                assign sub_is_active = false
                if sub_collection != blank and sub_collection.handle == collection.handle
                  assign sub_is_active = true
                endif
              -%}
              {%- if sub_collection != blank -%}
                <li class="cg-subcats__item" {{ block.shopify_attributes }}>
                  <a
                    href="{{ sub_collection.url }}"
                    class="cg-subcats__btn{% if sub_is_active %} is-active{% endif %}"
                    {% if sub_is_active %}aria-current="page"{% endif %}
                    aria-label="{{ sub_label | escape }}"
                  >
                    <span class="cg-subcats__circle">
                      {%- if sub_image != blank -%}
                        {{
                          sub_image
                          | image_url: width: 200
                          | image_tag:
                            class: 'cg-subcats__img',
                            loading: 'lazy',
                            widths: '100, 150, 200',
                            sizes: '80px',
                            alt: sub_label
                        }}
                      {%- else -%}
                        <span class="cg-subcats__placeholder">{{ sub_label | slice: 0, 1 }}</span>
                      {%- endif -%}
                      <span class="cg-subcats__check" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                      </span>
                    </span>
                    <span class="cg-subcats__label">{{ sub_label | escape }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

   <div class="collection_filter">
 {%- if section.settings.show_toolbar -%}
      <div class="cg-toolbar">
        {%- if section.settings.show_filters and collection.filters.size > 0 -%}
          <button type="button" class="cg-toolbar__btn" data-cg-filters-open aria-expanded="false" aria-controls="cg-filters-{{ section.id }}">
            <span>{{ section.settings.filters_label | default: 'Filters' }}</span>
            <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
          </button>
        {%- else -%}
          <span></span>
        {%- endif -%}

        {%- if section.settings.show_sort -%}
          <div class="cg-sort">
            <label class="visually-hidden" for="cg-sort-{{ section.id }}">Sort products</label>
            <select id="cg-sort-{{ section.id }}" class="cg-toolbar__btn cg-sort__select" data-cg-sort>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
            <svg class="cg-sort__icon" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_filters and collection.filters.size > 0 -%}
        <div class="cg-filters" id="cg-filters-{{ section.id }}" data-cg-filters hidden>
          <form class="cg-filters__form" action="{{ collection.url }}" method="get">
            {%- if collection.sort_by -%}
              <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
            {%- endif -%}
            {%- for filter in collection.filters -%}
              <div class="cg-filters__group">
                <p class="cg-filters__label">{{ filter.label }}</p>
                <div class="cg-filters__values">
                  {%- case filter.type -%}
                    {%- when 'list' -%}
                      {%- for value in filter.values -%}
                        <label class="cg-filters__option">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span>{{ value.label }} ({{ value.count }})</span>
                        </label>
                      {%- endfor -%}
                    {%- when 'price_range' -%}
                      <div class="cg-filters__price">
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                          placeholder="Min"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        >
                        <span>–</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                          placeholder="Max"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        >
                      </div>
                  {%- endcase -%}
                </div>
              </div>
            {%- endfor -%}
            <div class="cg-filters__actions">
              <button type="submit" class="cg-filters__apply">Apply filters</button>
              <a href="{{ collection.url }}" class="cg-filters__clear">Clear all</a>
            </div>
          </form>
        </div>
      {%- endif -%}
    {%- endif -%}
   </div>

    {%- paginate collection.products by products_per_page -%}
      {%- if collection.products_count > 0 -%}
        <div class="cg-grid" data-cg-grid>
          {%- assign product_index = 0 -%}
          {%- for product in collection.products -%}
            {%- assign product_index = product_index | plus: 1 -%}

            {%- if promo_block and product_index == promo_block.settings.insert_after -%}
              <div class="cg-promo cg-grid__promo" {{ promo_block.shopify_attributes }}>
                <div class="cg-promo__content">
                  {%- if promo_block.settings.heading != blank -%}
                    <h2 class="cg-promo__heading">{{ promo_block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if promo_block.settings.text != blank -%}
                    <p class="cg-promo__text">{{ promo_block.settings.text }}</p>
                  {%- endif -%}
                  {%- if promo_block.settings.show_payment_icons and promo_block.settings.payment_icons_image != blank -%}
                    <div class="cg-promo__payments">
                      {{
                        promo_block.settings.payment_icons_image
                        | image_url: width: 480
                        | image_tag:
                          class: 'cg-promo__payment-icons',
                          loading: 'lazy',
                          widths: '240, 360, 480',
                          sizes: '(max-width: 749px) 200px, 280px',
                          alt: 'Payment options'
                      }}
                    </div>
                  {%- endif -%}
                  <ul class="cg-promo__features" role="list">
                    {%- for i in (1..3) -%}
                      {%- assign feat_key = 'feature_' | append: i -%}
                      {%- assign feat_icon_key = feat_key | append: '_icon' -%}
                      {%- assign feat_text = promo_block.settings[feat_key] -%}
                      {%- assign feat_icon = promo_block.settings[feat_icon_key] -%}
                      {%- if feat_text != blank -%}
                        <li class="cg-promo__feature">
                          {%- if feat_icon != blank -%}
                            {{
                              feat_icon
                              | image_url: width: 64
                              | image_tag:
                                class: 'cg-promo__feature-icon',
                                loading: 'lazy',
                                width: 24,
                                height: 24,
                                alt: ''
                            }}
                          {%- else -%}
                            <span class="cg-promo__feature-dot" aria-hidden="true"></span>
                          {%- endif -%}
                          <span class="cg-promo__feature-text">{{ feat_text }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                  {%- if promo_block.settings.button_text != blank and promo_block.settings.button_link != blank -%}
                    <a href="{{ promo_block.settings.button_link }}" class="cg-promo__btn">{{ promo_block.settings.button_text }}</a>
                  {%- endif -%}
                </div>
                {%- liquid
                  assign promo_desktop_image = promo_block.settings.image
                  assign promo_mobile_image = promo_block.settings.mobile_image
                  if promo_mobile_image == blank
                    assign promo_mobile_image = promo_desktop_image
                  endif
                  if promo_desktop_image == blank
                    assign promo_desktop_image = promo_mobile_image
                  endif
                -%}
                {%- if promo_desktop_image != blank or promo_mobile_image != blank -%}
                  <div class="cg-promo__media">
                    {%- if promo_desktop_image != blank -%}
                      {{
                        promo_desktop_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'cg-promo__image cg-promo__image--desktop',
                          loading: 'lazy',
                          sizes: '(min-width: 750px) 40vw, 0px'
                      }}
                    {%- endif -%}
                    {%- if promo_mobile_image != blank -%}
                      {{
                        promo_mobile_image
                        | image_url: width: 800
                        | image_tag:
                          class: 'cg-promo__image cg-promo__image--mobile',
                          loading: 'lazy',
                          sizes: '(max-width: 749px) 100vw, 0px'
                      }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- liquid
              assign card_rating_count = 0
              if product.metafields.reviews.rating.value.rating_count != blank
                assign card_rating_count = product.metafields.reviews.rating.value.rating_count | plus: 0 | round
              elsif product.metafields.reviews.rating_count != blank
                assign card_rating_count = product.metafields.reviews.rating_count | plus: 0 | round
              elsif product.metafields.custom.review_count != blank
                assign card_rating_count = product.metafields.custom.review_count | plus: 0 | round
              endif
            -%}
            <div
              class="cg-card-wrap"
              data-rating-count="{{ card_rating_count }}"
              data-fallback-count="{{ card_rating_count }}"
              style="display: contents"
            >
              <span
                class="stamped-product-reviews-badge na-stamped-source"
                data-id="{{ product.id }}"
                data-product-sku="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                hidden
                aria-hidden="true"
              ></span>
              {% render 'pp-collection-product-card',
                product: product,
                section: section,
                card_index: product_index,
                columns_desktop: columns_desktop,
                rating_count: card_rating_count
              %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="cg-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="cg-pagination__arrow" href="{{ paginate.previous.url }}" aria-label="Previous page">
                <svg width="12" height="20" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.83875 8.83875L1.7675 15.91L0 14.1425L6.1875 7.955L0 1.7675L1.7675 0L8.83875 7.07125C9.07309 7.30566 9.20473 7.62354 9.20473 7.955C9.20473 8.28646 9.07309 8.60434 8.83875 8.83875Z" fill="currentColor"/></svg>
              </a>
            {%- else -%}
              <span class="cg-pagination__arrow cg-pagination__arrow--disabled" aria-hidden="true">
                <svg width="12" height="20" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.83875 8.83875L1.7675 15.91L0 14.1425L6.1875 7.955L0 1.7675L1.7675 0L8.83875 7.07125C9.07309 7.30566 9.20473 7.62354 9.20473 7.955C9.20473 8.28646 9.07309 8.60434 8.83875 8.83875Z" fill="currentColor"/></svg>
              </span>
            {%- endif -%}

            <div class="cg-pagination__pages">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="cg-pagination__page" href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span class="cg-pagination__page cg-pagination__page--current" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="cg-pagination__page cg-pagination__page--gap">{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.next -%}
              <a class="cg-pagination__arrow" href="{{ paginate.next.url }}" aria-label="Next page">
                <svg width="12" height="20" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M0.365985 8.83875L7.43723 15.91L9.20473 14.1425L3.01723 7.955L9.20473 1.7675L7.43723 0L0.365985 7.07125C0.131646 7.30566 1.90735e-06 7.62354 1.90735e-06 7.955C1.90735e-06 8.28646 0.131646 8.60434 0.365985 8.83875Z" fill="currentColor"/></svg>
              </a>
            {%- else -%}
              <span class="cg-pagination__arrow cg-pagination__arrow--disabled" aria-hidden="true">
                <svg width="12" height="20" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M0.365985 8.83875L7.43723 15.91L9.20473 14.1425L3.01723 7.955L9.20473 1.7675L7.43723 0L0.365985 7.07125C0.131646 7.30566 1.90735e-06 7.62354 1.90735e-06 7.955C1.90735e-06 8.28646 0.131646 8.60434 0.365985 8.83875Z" fill="currentColor"/></svg>
              </span>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="na-empty">{{ section.settings.empty_message }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>

  <div class="na-toast" data-na-toast role="status" aria-live="polite"></div>
  <div class="wishlist-toast" data-wishlist-toast role="status" aria-live="polite"></div>

  <div class="na-mobile-drawer" data-na-mobile-drawer aria-hidden="true">
    <div class="na-mobile-drawer__overlay" data-na-drawer-close></div>
    <div class="na-mobile-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cg-drawer-title-{{ section.id }}">
      <div class="na-mobile-drawer__header">
        <h3 class="visually-hidden" id="cg-drawer-title-{{ section.id }}">Quick add</h3>
        <button type="button" class="na-mobile-drawer__close" data-na-drawer-close aria-label="Close">
          Close <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="na-mobile-drawer__body">
        <div class="na-mobile-drawer__field" data-na-drawer-colors-wrap hidden>
          <p class="na-mobile-drawer__label">
            <span data-na-drawer-color-label>Colour</span>: <span data-na-drawer-color-value></span>
          </p>
          <div class="na-mobile-drawer__swatches" data-na-drawer-swatches role="list"></div>
        </div>
        <div class="na-mobile-drawer__field" data-na-drawer-sizes-wrap hidden>
          <p class="na-mobile-drawer__label">
            <span data-na-drawer-size-label>Size</span>: <span data-na-drawer-size-value></span>
          </p>
          <div class="na-mobile-drawer__sizes" data-na-drawer-sizes role="group"></div>
        </div>
        <button type="button" class="na-mobile-drawer__submit" data-na-drawer-submit disabled>Add To Cart</button>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .cg-section { padding-top: var(--na-padding-top); padding-bottom: var(--na-padding-bottom); }
  .cg-header { text-align: center; margin-bottom: 32px; }
  .cg-header__title { margin: 0 0 12px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 400; line-height: 1.15; color: #111; }
  .cg-header__description { max-width: 720px; margin: 0 auto; font-size: 15px; line-height: 1.6; color: #555; }
  .cg-subcats { margin-bottom: 28px; }
  .cg-subcats__list { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px 32px; list-style: none; margin: 0; padding: 0; }
  .cg-subcats__btn { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 0; border: none; background: none; cursor: pointer; color: #111; text-decoration: none; }
  .cg-subcats__circle { position: relative; width: 105px; height: 105px; border-radius: 50%; overflow: hidden; border: 2px solid transparent; transition: border-color 0.2s; }
  .cg-subcats__circle--all { display: flex; align-items: center; justify-content: center; background: #f3f3f3; }
  .cg-subcats__all-text { font-size: 14px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .cg-subcats__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cg-subcats__placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #f0f0f0; font-size: 24px; font-weight: 600; }
  .cg-subcats__check { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.45); color: #fff; opacity: 0; transition: opacity 0.2s; }
  .cg-subcats__btn.is-active .cg-subcats__circle { border-color: #111; }
  .cg-subcats__btn.is-active .cg-subcats__check { opacity: 1; }
  .cg-subcats__label { font-size: 13px; line-height: 1.3; max-width: 90px; text-align: center; }
  .cg-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .cg-toolbar__btn, .cg-sort__select { appearance: none; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border: 1px solid #111; border-radius: 10px; background: #fff; font-size: 14px; color: #111; cursor: pointer; }
  .cg-sort { position: relative; }
  .cg-sort__select { padding-right: 34px; }
  .cg-sort__icon { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; }
  .cg-filters { margin-bottom: 24px; padding: 20px; border: 1px solid #e5e5e5; border-radius: 12px; background: #fafafa;position: absolute; z-index: 99; width: 100%; }
  .collection_filter { position: relative; }
  .cg-filters__group { margin-bottom: 16px; }
  .cg-filters__label { margin: 0 0 8px; font-weight: 600; font-size: 14px; }
  .cg-filters__option { display: flex; align-items: center; gap: 8px; margin: 6px 0; font-size: 14px; }
  .cg-filters__price { display: flex; align-items: center; gap: 8px; }
  .cg-filters__price input { width: 100px; padding: 8px; border: 1px solid #ddd; border-radius: 6px; }
  .cg-filters__actions { display: flex; gap: 12px; margin-top: 16px; }
  .cg-filters__apply { padding: 10px 18px; border: none; border-radius: 999px; background: #111; color: #fff; cursor: pointer; }
  .cg-filters__clear { align-self: center; color: #111; }
  .cg-grid { display: grid; grid-template-columns: repeat(var(--cg-columns), minmax(0, 1fr)); gap: 80px 16px; }
  div .cg-grid__item, div .cg-grid .na-card { min-width: 0;    z-index: 9 !important; }
  .cg-grid__promo, .cg-promo { grid-column: span 2; display: grid; grid-template-columns: 1fr 1fr;  border-radius: var(--na-image-radius); overflow: hidden; background: #f7f1ea;    position: relative; }
  .cg-promo__content { padding: 50px 35px; display: flex; flex-direction: column; justify-content: center; gap: 12px; position: absolute; width: 100%; z-index: 9; }
  .cg-promo__heading { font-size: 35px; margin-bottom: 10px; font-family: Lora; font-weight: 500; font-style: italic; }
  .cg-promo__text { margin: 0; font-size: 14px; line-height: 1.5; color: #000; max-width: 350px; }
  .cg-promo__payments { display: block; }
  .cg-promo__payment-icons {display: block; max-width: 280px; width: auto; height: 18px; margin-bottom: 15px;}
  .cg-promo__features { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
