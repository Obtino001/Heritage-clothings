<script>
  (function () {
    if (window._cgMonsterCartSyncBound) return;
    window._cgMonsterCartSyncBound = true;

    var addRe = /\/cart\/add(\.js)?(\?|$)/;
    var mutationRe = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;
    var countTimer = null;
    var monsterTimer = null;

    function updateHeaderCartCount(cart) {
      if (!cart || typeof cart.item_count !== 'number') return;
      var count = cart.item_count;

      var selectors = [
        '.cart-bubble__text',
        '.cart-count-bubble span:not([aria-hidden])',
        '.cart-count-bubble span',
        '[ref="cartBubbleCount"]',
        '[data-cart-count]',
        '.cart-count',
        '.header__cart-count',
        '.cart-bubble-count',
        '.js-cart-count'
      ];

      selectors.forEach(function (sel) {
        document.querySelectorAll(sel).forEach(function (el) {
          el.textContent = String(count);
        });
      });

      document.querySelectorAll('.cart-bubble, .cart-count-bubble, .cart-bubble__background').forEach(function (el) {
        el.classList.toggle('visible', count > 0);
        el.classList.toggle('is-empty', count === 0);
        if (count > 0) {
          el.removeAttribute('hidden');
          el.style.display = '';
        } else {
          el.setAttribute('hidden', '');
        }
      });

      var cartIcon = document.querySelector('cart-icon');
      if (cartIcon) {
        try {
          if ('currentCartCount' in cartIcon) {
            cartIcon.currentCartCount = count;
          }
        } catch (e) {}
      }
    }

    function syncHeaderCount() {
      clearTimeout(countTimer);
      countTimer = setTimeout(function () {
        fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(updateHeaderCartCount)
          .catch(function () {});
      }, 350);
    }

    function refreshMonsterCart() {
      if (typeof window.monster_refresh !== 'function') return;
      clearTimeout(monsterTimer);
      monsterTimer = setTimeout(function () {
        try { window.monster_refresh(); } catch (e) {}
      }, 150);
    }

    function onCartMutation(url) {
      syncHeaderCount();
      if (addRe.test(url)) {
        refreshMonsterCart();
      }
    }

    if (window.fetch) {
      var cgOrigFetch = window.fetch;
      window.fetch = function (input) {
        var url = '';
        try {
          url = typeof input === 'string' ? input : String((input && input.url) || input || '');
        } catch (e) {}
        var result = cgOrigFetch.apply(this, arguments);
        if (mutationRe.test(url)) {
          result.then(function () { onCartMutation(url); }, function () {});
        }
        return result;
      };
    }

    if (window.XMLHttpRequest) {
      var cgOrigXhrOpen = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function (method, url) {
        try {
          var urlStr = String(url || '');
          if (urlStr && mutationRe.test(urlStr)) {
            this.addEventListener('load', function () { onCartMutation(urlStr); });
          }
        } catch (e) {}
        return cgOrigXhrOpen.apply(this, arguments);
      };
    }
  })();
</script>

<script>
  (function () {
    if (window._cgQuickAtcBound) return;
    window._cgQuickAtcBound = true;

    var desktopQuery = window.matchMedia('(min-width: 990px)');

    function norm(value) {
      return (value || '').toString().trim().toLowerCase();
    }

    function parseVariants(card) {
      var el = card.querySelector('[data-na-variants]');
      if (!el) return [];
      try { return JSON.parse(el.textContent); } catch (e) { return []; }
    }

    function optAt(variant, pos) {
      if (pos === '1' || pos === 1) return variant.option1 || '';
      if (pos === '2' || pos === 2) return variant.option2 || '';
      if (pos === '3' || pos === 3) return variant.option3 || '';
      return '';
    }

    function colorIsVariantOption(card, color) {
      if (!color) return false;
      if (card.dataset.colorPosition) return true;
      var needle = norm(color);
      return parseVariants(card).some(function (v) {
        return [v.option1, v.option2, v.option3].map(norm).indexOf(needle) !== -1;
      });
    }

    function findAvailableVariant(card, color, size) {
      var colorPos = card.dataset.colorPosition;
      var sizePos = card.dataset.sizePosition;
      var variants = parseVariants(card);
      var matchColor = color && colorIsVariantOption(card, color);
      var match = null;

      variants.forEach(function (v) {
        if (match || !v.available) return;
        var ok = true;
        if (matchColor) {
          if (colorPos) {
            ok = norm(optAt(v, colorPos)) === norm(color);
          } else {
            ok = [v.option1, v.option2, v.option3].map(norm).indexOf(norm(color)) !== -1;
          }
        }
        if (ok && size) {
          if (sizePos) {
            ok = norm(optAt(v, sizePos)) === norm(size);
          } else {
            ok = [v.option1, v.option2, v.option3].map(norm).indexOf(norm(size)) !== -1;
          }
        }
        if (ok) match = v;
      });

      return match;
    }

    function getSelections(card) {
      var sizeBtn = card.querySelector('.na-sizes__btn.is-selected');
      var swatch = card.querySelector('[data-swatch].is-active:not(.is-hidden)');
      return {
        size: sizeBtn ? sizeBtn.dataset.sizeValue : null,
        color: swatch ? swatch.dataset.colorValue : null
      };
    }

    function showToast(message) {
      var toast = document.querySelector('.cg-section [data-na-toast]') || document.querySelector('[data-na-toast]');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      clearTimeout(window._cgQuickAtcToastTimer);
      window._cgQuickAtcToastTimer = setTimeout(function () {
        toast.classList.remove('is-visible');
      }, 2500);
    }

    function addToCart(card, btn) {
      var sel = getSelections(card);
      var variant = findAvailableVariant(card, sel.color, sel.size);
      if (!variant) {
        showToast('Selected option is unavailable');
        return;
      }

      btn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id: parseInt(variant.id, 10), quantity: 1 })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          btn.disabled = false;
          if (data && data.status && data.status !== 200) {
            showToast(data.description || 'Could not add to cart');
            return;
          }
          showToast('Added to cart');
        })
        .catch(function () {
          btn.disabled = false;
          showToast('Could not add to cart');
        });
    }

    function ensureBtn(card) {
      var btn = card.querySelector('.na-quick-atc');
      if (btn) return btn;

      var media = card.querySelector('.na-card__media');
      if (!media) return null;

      btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'na-quick-atc';
      btn.textContent = 'Add To Cart';
      btn.setAttribute('aria-label', 'Add ' + (card.dataset.productTitle || 'product') + ' to cart');

      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        addToCart(card, btn);
      });

      media.appendChild(btn);
      return btn;
    }

    function updateQuickAtc(card) {
      if (!desktopQuery.matches) {
        card.classList.remove('na-quick-atc-visible');
        return;
      }

      var hasSwatches = card.querySelector('[data-swatch]');
      var hasSizes = card.querySelector('.na-sizes__btn');
      if (!hasSwatches || !hasSizes) return;

      var sel = getSelections(card);
      var show = !!(sel.size && sel.color);
      if (show) {
        show = !!findAvailableVariant(card, sel.color, sel.size);
      }

      if (show) ensureBtn(card);
      card.classList.toggle('na-quick-atc-visible', show);
    }

    document.addEventListener('click', function (e) {
      if (!e.target || typeof e.target.closest !== 'function') return;
      var trigger = e.target.closest('.na-sizes__btn, [data-swatch]');
      if (!trigger) return;

      var card = trigger.closest('[data-na-card]') || trigger.closest('.na-card');
      if (!card || !card.closest('.cg-section')) return;

      setTimeout(function () { updateQuickAtc(card); }, 0);
    }, true);
  })();
</script>

<script>
  (function () {
    if (window.__naStampedRatingReady) return;
    window.__naStampedRatingReady = true;

    function parseCount(value) {
      var n = parseInt(String(value || '').trim(), 10);
      return isNaN(n) ? null : n;
    }

    function getStampedCount(source) {
      if (!source) return null;
      var caption = source.querySelector('.stamped-badge-caption[data-reviews]');
      if (caption) {
        var fromAttr = parseCount(caption.getAttribute('data-reviews'));
        if (fromAttr !== null) return fromAttr;
      }
      var badge = source.querySelector('.stamped-badge[aria-label]');
      if (badge) {
        var match = String(badge.getAttribute('aria-label') || '').match(/(\d+)\s*reviews?/i);
        if (match) return parseCount(match[1]);
      }
      return null;
    }

    function getFallbackCount(container) {
      if (container.hasAttribute('data-fallback-count')) {
        return parseCount(container.getAttribute('data-fallback-count')) || 0;
      }
      var pill = container.querySelector('[data-na-rating-sync]');
      if (pill && pill.hasAttribute('data-fallback-count')) {
        return parseCount(pill.getAttribute('data-fallback-count')) || 0;
      }
      if (container.hasAttribute('data-rating-count')) {
        return parseCount(container.getAttribute('data-rating-count')) || 0;
      }
      return 0;
    }

    function applyCount(container, count) {
      if (count === null || count === undefined) return;

      if (container.classList.contains('cg-card-wrap')) {
        container.setAttribute('data-rating-count', String(count));
      }

      container.querySelectorAll('.na-rating-pill, .na-rating').forEach(function (el) {
        var span = el.querySelector('[data-na-rating-count]') || el.querySelector('span:last-of-type') || el.querySelector('span');
        if (count <= 0) {
          el.style.setProperty('display', 'none', 'important');
          el.setAttribute('hidden', '');
          return;
        }
        el.removeAttribute('hidden');
        el.style.removeProperty('display');
        if (span) span.textContent = String(count);
      });
    }

    function syncContainer(container, allowFallback) {
      var stamped = container.querySelector('.na-stamped-source');
      var stampedCount = getStampedCount(stamped);
      if (stampedCount !== null) {
        container.setAttribute('data-stamped-synced', 'true');
        applyCount(container, stampedCount);
        return;
      }
      if (allowFallback && !container.getAttribute('data-stamped-synced')) {
        applyCount(container, getFallbackCount(container));
      }
    }

    function loadStampedBadges() {
      if (!window.StampedFn) return;
      try {
        if (typeof StampedFn.loadBadges === 'function') StampedFn.loadBadges();
      } catch (e) {}
    }

    function observeContainer(container) {
      if (container.__naStampedObserved) return;
      container.__naStampedObserved = true;
      var stamped = container.querySelector('.na-stamped-source');
      if (!stamped || !window.MutationObserver) return;
      var observer = new MutationObserver(function () {
        syncContainer(container, false);
      });
      observer.observe(stamped, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['data-reviews', 'aria-label', 'class']
      });
    }

    function init(scope) {
      var root = scope && scope.querySelector ? scope : document;
      loadStampedBadges();
      root.querySelectorAll('.cg-card-wrap, [data-na-card]').forEach(function (container) {
        if (!container.querySelector('.na-stamped-source')) return;
        observeContainer(container);
        syncContainer(container, false);
      });
    }

    function boot(scope) {
      init(scope);
      window.setTimeout(function () { init(scope); }, 500);
      window.setTimeout(function () { init(scope); }, 1500);
      window.setTimeout(function () { init(scope); }, 3000);
      window.setTimeout(function () {
        var root = scope && scope.querySelector ? scope : document;
        root.querySelectorAll('.cg-card-wrap, [data-na-card]').forEach(function (container) {
          if (!container.querySelector('.na-stamped-source')) return;
          if (!container.getAttribute('data-stamped-synced')) {
            syncContainer(container, true);
          }
        });
      }, 4500);
    }

    window.naBootStampedRatings = boot;

    var stampedPoll = window.setInterval(function () {
      if (window.StampedFn) {
        window.clearInterval(stampedPoll);
        boot();
      }
    }, 200);

    window.setTimeout(function () { window.clearInterval(stampedPoll); }, 12000);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { boot(); });
    } else {
      boot();
    }

    document.addEventListener('shopify:section:load', function (event) {
      boot(event.target);
    });
  })();
</script>

