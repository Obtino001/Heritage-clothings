<section class="blog_stories_carousel_ blog_stories_grid_">
  <div class="page-width">
    <div class="blog_stories_carousel_header_">
      <h2 class="blog_stories_carousel_heading_">
        {{ section.settings.heading }}
      </h2>

    
    </div>

    <div class="blog_stories_grid_list_" style="--blog-grid-columns: {{ section.settings.columns_desktop }};">
      {% for article in blogs[section.settings.blog].articles limit: section.settings.posts_to_show %}
        <div class="blog_stories_carousel_card_">
          <a
            href="{{ article.url }}"
            class="blog_stories_carousel_image_wrap_"
          >
            {% if article.image %}
              {{
                article.image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'blog_stories_carousel_image_'
              }}
            {% endif %}
          </a>

          <div class="blog_stories_carousel_content_">
            <div class="top_header">
              <div class="blog_stories_carousel_meta_">
                <span class="blog_stories_carousel_tag_"> STYLE GUIDE </span>

                <span class="blog_stories_carousel_date_">
                  {{ article.published_at | date: '%d/%m/%Y' }}
                </span>
              </div>

              <h3 class="blog_stories_carousel_title_">
                {{ article.title }}
              </h3>

              <div class="blog_stories_carousel_excerpt_">
                {{ article.excerpt | strip_html | truncate: 90 }}
              </div>
            </div>

            <a
              href="{{ article.url }}"
              class="blog_stories_carousel_link_"
            >
              Read More
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .blog_stories_carousel_ {
    position: relative;
    padding: 80px 0;
  }

  .blog_stories_carousel_header_ {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 30px;
  }

  a.blog_stories_carousel_view_all_ {
    text-decoration: underline;
    font-family: Neue Montreal Med !important;
    font-weight: 500;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0%;
    color: #000000;
  }

  .blog_stories_carousel_heading_ {
    margin: 0;
    color: #000000;
    font-family: Lora;
    font-weight: 500;
    font-size: 34px;
    line-height: 100%;
    letter-spacing: 0%;
    text-transform: capitalize;
  }

  .blog_stories_grid_list_ {
    display: grid;
    grid-template-columns: repeat(var(--blog-grid-columns, 3), minmax(0, 1fr));
    gap: 20px;
  }

  .blog_stories_carousel_content_ {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: stretch;
  }

  span.blog_stories_carousel_tag_ {
    font-family: Neue Montreal;
    font-weight: 500;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 2%;
    color: #B8522E;
  }

  .blog_stories_carousel_title_ {
    font-family: Lora;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: 2%;
    color: #000000;
    margin: 13px 0;
  }

  .blog_stories_carousel_excerpt_ {
    margin-bottom: 37px;
    font-family: "Neue Montreal" !important;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: 2%;
    color: #000000;
  }

  a.blog_stories_carousel_link_ {
    font-family: Neue Montreal Med !important;
    font-weight: 500;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 2%;
    text-decoration: underline;
    color: #000000;
  }

  .blog_stories_carousel_card_ {
    background: #F5EFE6;
    border-radius: 10px;
    overflow: hidden;
    height: stretch;
    padding: 15px 15px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .blog_stories_carousel_image_ {
    width: 100%;
    display: block;
    aspect-ratio: 1.4;
    object-fit: cover;
    border-radius: 8px;
  }

  .blog_stories_carousel_meta_ {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px;
  }

  span.blog_stories_carousel_date_ {
    font-family: Neue Montreal;
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0%;
    color: #9D9D9D;
  }

  @media (max-width: 1024px) {
    .blog_stories_grid_list_ {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .blog_stories_grid_list_ {
      grid-template-columns: 1fr;
    }

    .blog_stories_carousel_heading_ {
      font-size: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Blog Stories Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories By Heritage"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Posts to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    }
  ],
  "presets": [
    {
      "name": "Blog Stories Grid"
    }
  ]
}
{% endschema %}
