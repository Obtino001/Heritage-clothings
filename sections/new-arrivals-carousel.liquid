<script>
  (function () {
  function initNewArrivals(section) {
    if (!section || section.dataset.naInit === 'true') return;
    section.dataset.naInit = 'true';

    var track = section.querySelector('[data-na-track]');
    var prevBtns = section.querySelectorAll('[data-na-prev]');
    var nextBtns = section.querySelectorAll('[data-na-next]');
    var progressBar = section.querySelector('[data-na-progress-bar]');
    var toast = section.querySelector('[data-na-toast]');
    var columns = parseFloat(section.dataset.columns) || 4;

    function getScrollAmount() {
      var card = section.querySelector('[data-na-card]');
      if (!card || !track) return 300;
      var style = getComputedStyle(track);
      var gap = parseFloat(style.gap) || 16;
      return card.offsetWidth + gap;
    }

    function updateCarousel() {
      if (!track || !progressBar) return;
      var maxScroll = track.scrollWidth - track.clientWidth;
      var visibleRatio = track.scrollWidth > 0 ? track.clientWidth / track.scrollWidth : 1;
      var scrollRatio = maxScroll > 0 ? track.scrollLeft / maxScroll : 0;
      progressBar.style.width = Math.max(visibleRatio * 100, 12) + '%';
      progressBar.style.marginLeft = scrollRatio * (100 - visibleRatio * 100) + '%';

      if (prevBtns.length) {
        prevBtns.forEach(function (btn) {
          btn.disabled = track.scrollLeft <= 2;
        });
      }
      if (nextBtns.length) {
        nextBtns.forEach(function (btn) {
          btn.disabled = track.scrollLeft >= maxScroll - 2;
        });
      }
    }

    prevBtns.forEach(function (prevBtn) {
      if (!track) return;
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
    });

    nextBtns.forEach(function (nextBtn) {
      if (!track) return;
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });
    });

    function getCards() {
      return Array.prototype.slice.call(section.querySelectorAll('[data-na-card]'));
    }

    function getNearestCardIndex() {
      var cards = getCards();
      if (!cards.length || !track) return 0;

      var scrollLeft = track.scrollLeft;
      var nearestIndex = 0;
      var minDistance = Infinity;

      cards.forEach(function (card, index) {
        var distance = Math.abs(card.offsetLeft - scrollLeft);
        if (distance < minDistance) {
          minDistance = distance;
          nearestIndex = index;
        }
      });

      return nearestIndex;
    }

    function scrollToCardIndex(index) {
      var cards = getCards();
      if (!cards.length || !track) return;

      var targetIndex = Math.max(0, Math.min(cards.length - 1, index));
      track.scrollTo({ left: cards[targetIndex].offsetLeft, behavior: 'smooth' });
    }

    function initMobileSwipe() {
      if (!track) return;

      var mobileQuery = window.matchMedia('(max-width: 989px)');
      var touchStartX = 0;
      var touchStartY = 0;
      var gestureStartIndex = 0;
      var touchAxis = null;

      function onTouchStart(event) {
        if (!mobileQuery.matches || !event.touches.length) return;

        touchStartX = event.touches[0].clientX;
        touchStartY = event.touches[0].clientY;
        touchAxis = null;
        gestureStartIndex = getNearestCardIndex();
      }

      function onTouchMove(event) {
        if (!mobileQuery.matches || !event.touches.length) return;

        var deltaX = event.touches[0].clientX - touchStartX;
        var deltaY = event.touches[0].clientY - touchStartY;

        if (touchAxis === null && (Math.abs(deltaX) > 8 || Math.abs(deltaY) > 8)) {
          touchAxis = Math.abs(deltaX) > Math.abs(deltaY) ? 'x' : 'y';
        }

        if (touchAxis === 'x') {
          event.preventDefault();
        }
      }

      function onTouchEnd(event) {
        if (!mobileQuery.matches || touchAxis !== 'x') return;

        var deltaX = touchStartX - event.changedTouches[0].clientX;
        if (Math.abs(deltaX) < 30) {
          scrollToCardIndex(gestureStartIndex);
          return;
        }

        scrollToCardIndex(gestureStartIndex + (deltaX > 0 ? 1 : -1));
      }

      track.addEventListener('touchstart', onTouchStart, { passive: true });
      track.addEventListener('touchmove', onTouchMove, { passive: false });
      track.addEventListener('touchend', onTouchEnd, { passive: true });
      track.addEventListener('touchcancel', onTouchEnd, { passive: true });
    }

    if (track) {
      track.addEventListener('scroll', updateCarousel, { passive: true });
      window.addEventListener('resize', updateCarousel);
      initMobileSwipe();
      updateCarousel();
    }

    function showToast(message) {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      clearTimeout(showToast._timer);
      showToast._timer = setTimeout(function () {
        toast.classList.remove('is-visible');
      }, 2500);
    }

  section.querySelectorAll('[data-na-card]').forEach(function (card) {
    initCardVariantPicker(card, section, showToast);
  });

  initMobileDrawer(section, showToast);
  }

  function normValue(value) {
    return (value || '').toString().trim().toLowerCase();
  }

  function naGetCartUrls(section) {
    var addUrl = (section && section.dataset.cartAddUrl) || '/cart/add.js';
    var dataUrl = /\/add\.js(?:\?.*)?$/.test(addUrl)
      ? addUrl.replace(/\/add\.js(?:\?.*)?$/, '.js')
      : '/cart.js';
    return { add: addUrl, data: dataUrl };
  }

  function naGetCartDrawer() {
    return document.querySelector('cart-drawer-component');
  }

  function naGetCartDrawerSectionId() {
    var drawerEl = naGetCartDrawer();
    if (!drawerEl) return null;
    var wrap = drawerEl.closest('.shopify-section');
    if (wrap && wrap.id && wrap.id.indexOf('shopify-section-') === 0) {
      return wrap.id.replace('shopify-section-', '');
    }
    return null;
  }

  function naMonsterRefresh() {
    if (typeof window.monster_refresh === 'function') {
      try {
        window.monster_refresh();
        return true;
      } catch (e) {}
    }
    return false;
  }

  function naOpenCartDrawer() {
    if (naMonsterRefresh()) return;
    var themeDrawer = document.querySelector('theme-drawer#cart-drawer');
    if (themeDrawer && typeof themeDrawer.open === 'function') {
      try { themeDrawer.open(); return; } catch (e) {}
    }
    var cartDrawer = naGetCartDrawer();
    if (cartDrawer && typeof cartDrawer.open === 'function') {
      try { cartDrawer.open(); return; } catch (e) {}
    }
    document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open'));
    var cartLink = document.querySelector('a.header-actions__action[href*="/cart"], a.action__cart[href*="/cart"]');
    if (cartLink && !themeDrawer) window.location.href = cartLink.href;
  }

  function naDispatchPlainCartUpdate(cart) {
    var itemCount = cart && typeof cart.item_count === 'number' ? cart.item_count : 1;
    document.dispatchEvent(new CustomEvent('cart:update', {
      bubbles: true,
      detail: { data: { itemCount: itemCount, source: 'product-form-component' } }
    }));
    document.dispatchEvent(new CustomEvent('cart:refresh', {
      bubbles: true,
      detail: { source: 'new-arrivals-carousel' }
    }));
  }

  function naSectionIdOf(el) {
    if (!el) return null;
    var wrap = el.closest('.shopify-section');
    if (wrap && wrap.id && wrap.id.indexOf('shopify-section-') === 0) {
      return wrap.id.replace('shopify-section-', '');
    }
    return null;
  }

  function naGetCartSectionIds() {
    var ids = [];
    var drawerId = naSectionIdOf(naGetCartDrawer());
    if (drawerId) ids.push(drawerId);

    var iconId = naSectionIdOf(document.querySelector('cart-icon'));
    if (iconId && ids.indexOf(iconId) === -1) ids.push(iconId);

    var bubbleId = naSectionIdOf(document.querySelector('.cart-bubble, .cart-count-bubble, [data-cart-count]'));
    if (bubbleId && ids.indexOf(bubbleId) === -1) ids.push(bubbleId);

    return ids;
  }

  function naGetSectionWrap(sectionId) {
    if (!sectionId) return null;
    var byId = document.getElementById('shopify-section-' + sectionId);
    if (byId) return byId;
    var drawerEl = naGetCartDrawer();
    return drawerEl ? drawerEl.closest('.shopify-section') : null;
  }

  function naInjectSectionHTML(sectionId, html) {
    if (!sectionId || typeof html !== 'string') return false;
    var wrap = naGetSectionWrap(sectionId);
    if (!wrap) return false;
    if (wrap.querySelector('theme-drawer, cart-drawer-component')) return false;

    try {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.getElementById('shopify-section-' + sectionId);
      wrap.innerHTML = fresh ? fresh.innerHTML : html;
      return true;
    } catch (e) {
      try { wrap.innerHTML = html; return true; } catch (e2) { return false; }
    }
  }

  function naUpdateHeaderCartCount(cart) {
    if (!cart || typeof cart.item_count !== 'number') return;
    var count = cart.item_count;

    var selectors = [
      '.cart-bubble__text',
      '.cart-count-bubble span:not([aria-hidden])',
      '.cart-count-bubble span',
      '[ref="cartBubbleCount"]',
      '[data-cart-count]',
      '.cart-count',
      '.header__cart-count',
      '.cart-bubble-count',
      '.js-cart-count'
    ];

    selectors.forEach(function (sel) {
      document.querySelectorAll(sel).forEach(function (el) {
        el.textContent = String(count);
      });
    });

    document.querySelectorAll('.cart-bubble, .cart-count-bubble, .cart-bubble__background').forEach(function (el) {
      el.classList.toggle('visible', count > 0);
      el.classList.toggle('is-empty', count === 0);
      if (count > 0) {
        el.removeAttribute('hidden');
        el.style.display = '';
      } else {
        el.setAttribute('hidden', '');
      }
    });

    var cartIcon = document.querySelector('cart-icon');
    if (cartIcon) {
      try {
        if ('currentCartCount' in cartIcon) {
          cartIcon.currentCartCount = count;
        }
      } catch (e) {}
    }
  }

  function naFireCartEvents(section, cart, openDrawer) {
    var urls = naGetCartUrls(section);

    function finish(cartData) {
      naUpdateHeaderCartCount(cartData);

      import('@theme/events')
        .then(function (mod) {
          if (mod && typeof mod.CartUpdateEvent === 'function') {
            document.dispatchEvent(new mod.CartUpdateEvent(cartData, 'new-arrivals-carousel', {
              itemCount: cartData ? cartData.item_count : undefined,
              source: 'new-arrivals-carousel',
              sections: {}
            }));
          } else {
            naDispatchPlainCartUpdate(cartData);
          }
        })
        .catch(function () { naDispatchPlainCartUpdate(cartData); })
        .then(function () {
          if (openDrawer) setTimeout(naOpenCartDrawer, 100);
        });
    }

    if (cart) {
      finish(cart);
      return;
    }

    fetch(urls.data, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(finish)
      .catch(function () { finish(null); });
  }

  function naAddVariantToCart(section, variantId, openDrawer, onError) {
    var urls = naGetCartUrls(section);
    var sectionIds = naGetCartSectionIds();
    var body = { id: parseInt(variantId, 10), quantity: 1 };
    if (sectionIds.length) body.sections = sectionIds.join(',');

    return fetch(urls.add, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body)
    })
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (data.status && data.status !== 200) {
          if (onError) onError(data.description || 'Could not add to cart');
          return false;
        }

        if (data.sections) {
          sectionIds.forEach(function (id) {
            if (data.sections[id]) {
              naInjectSectionHTML(id, data.sections[id]);
            }
          });
        }

        naFireCartEvents(section, null, openDrawer);
        return true;
      })
      .catch(function () {
        if (onError) onError('Could not add to cart');
        return false;
      });
  }

  function getVariantOption(variant, position) {
    if (position === '1' || position === 1) return variant.option1 || '';
    if (position === '2' || position === 2) return variant.option2 || '';
    if (position === '3' || position === 3) return variant.option3 || '';
    return '';
  }

  function parseCardVariants(card) {
    var el = card.querySelector('[data-na-variants]');
    if (!el) return [];
    try { return JSON.parse(el.textContent); } catch (e) { return []; }
  }

  function parseColorMap(card) {
    var el = card.querySelector('[data-na-color-map]');
    if (!el) return [];
    try { return JSON.parse(el.textContent); } catch (e) { return []; }
  }

  function getDefaultCardImage(card) {
    var img = card.querySelector('[data-na-main-image]');
    if (!img) return null;
    return {
      src: img.dataset.naDefaultSrc || img.getAttribute('src') || '',
      srcset: img.dataset.naDefaultSrcset || img.getAttribute('srcset') || ''
    };
  }

  function setCardImage(card, imageSrc, imageSrcset) {
    var img = card.querySelector('[data-na-main-image]');
    if (!img || !imageSrc) return;

    img.removeAttribute('srcset');
    img.src = imageSrc;

    if (imageSrcset) {
      img.srcset = imageSrcset;
    }
  }

  function resetCardImage(card) {
    var def = getDefaultCardImage(card);
    if (def && def.src) {
      setCardImage(card, def.src, def.srcset);
    }
  }

  function findColorMapImage(card, colorValue) {
    var map = parseColorMap(card);
    var needle = normValue(colorValue);
    var entry = map.find(function (item) {
      return normValue(item.label) === needle;
    });
    if (!entry) return null;
    if (entry.main) {
      return { src: entry.main, srcset: entry.mainSrcset || '' };
    }
    if (entry.thumb) {
      return { src: entry.thumb, srcset: '' };
    }
    return null;
  }

  function findVariantImage(card, colorValue, sizeValue) {
    var variants = parseCardVariants(card);
    var sizePos = card.dataset.sizePosition;
    var colorPos = card.dataset.colorPosition;
    var colorNeedle = normValue(colorValue);
    var sizeNeedle = normValue(sizeValue);

    var match = variants.find(function (v) {
      var sizeOk = !sizeValue || normValue(getVariantOption(v, sizePos)) === sizeNeedle;
      var colorOk = !colorValue || normValue(getVariantOption(v, colorPos)) === colorNeedle;
      return sizeOk && colorOk && v.image;
    });
    if (match) return { src: match.image, srcset: match.srcset || '' };
    return null;
  }

  function findMediaImage(card, colorValue) {
    var mediaEl = card.querySelector('[data-na-media]');
    if (!mediaEl || !colorValue) return null;
    try {
      var needle = normValue(colorValue);
      var mediaItems = JSON.parse(mediaEl.textContent);
      var exact = mediaItems.find(function (m) {
        return m.alt && normValue(m.alt) === needle;
      });
      if (exact) {
        return { src: exact.src, srcset: exact.srcset || '' };
      }
    } catch (e) {}
    return null;
  }

  function resolveMainImage(card, colorValue, sizeValue, activeSwatch) {
    activeSwatch = activeSwatch || card.querySelector('[data-swatch].is-active:not(.is-hidden)');

    if (activeSwatch) {
      if (activeSwatch.dataset.swatchHasImage === 'false') {
        return null;
      }
      if (activeSwatch.dataset.imageSrc) {
        return {
          src: activeSwatch.dataset.imageSrc,
          srcset: activeSwatch.dataset.imageSrcset || ''
        };
      }
    }

    var linked = cardHasLinkedVariants(card);

    if (linked && (colorValue || sizeValue)) {
      var fromVariant = findVariantImage(card, colorValue, sizeValue);
      if (fromVariant) return fromVariant;
    }

    var fromMap = findColorMapImage(card, colorValue);
    if (fromMap) return fromMap;

    if (colorValue) {
      var fromVariantColor = findVariantImage(card, colorValue, null);
      if (fromVariantColor) return fromVariantColor;
      var fromMedia = findMediaImage(card, colorValue);
      if (fromMedia) return fromMedia;
    }

    return null;
  }

  function cardHasLinkedVariants(card) {
    if (!card.dataset.sizePosition || !card.dataset.colorPosition) return false;
    return parseCardVariants(card).some(function (v) {
      return getVariantOption(v, card.dataset.colorPosition) && getVariantOption(v, card.dataset.sizePosition);
    });
  }

  function shouldMatchColorAsVariant(card, colorValue) {
    if (!colorValue) return false;
    if (card.dataset.colorPosition) return true;

    var needle = normValue(colorValue);
    if (!needle) return false;

    if (!card._naOptionValueLookup) {
      card._naOptionValueLookup = {};
      parseCardVariants(card).forEach(function (variant) {
        [variant.option1, variant.option2, variant.option3].forEach(function (optionValue) {
          var normalized = normValue(optionValue);
          if (normalized) {
            card._naOptionValueLookup[normalized] = true;
          }
        });
      });
    }

    return !!card._naOptionValueLookup[needle];
  }

  function variantMatchesOptions(variant, card, colorValue, sizeValue) {
    var colorPos = card.dataset.colorPosition;
    var sizePos = card.dataset.sizePosition;
    var optionValues = [variant.option1, variant.option2, variant.option3].map(function (value) {
      return normValue(value);
    });

    if (colorValue && shouldMatchColorAsVariant(card, colorValue)) {
      var colorNeedle = normValue(colorValue);
      var colorOk = false;
      if (colorPos) {
        colorOk = normValue(getVariantOption(variant, colorPos)) === colorNeedle;
      } else {
        colorOk = optionValues.indexOf(colorNeedle) !== -1;
      }
      if (!colorOk) return false;
    }

    if (sizeValue) {
      var sizeNeedle = normValue(sizeValue);
      var sizeOk = false;
      if (sizePos) {
        sizeOk = normValue(getVariantOption(variant, sizePos)) === sizeNeedle;
      } else {
        sizeOk = optionValues.indexOf(sizeNeedle) !== -1;
      }
      if (!sizeOk) return false;
    }

    return true;
  }

  function findSelectedVariant(card, colorValue, sizeValue) {
    var variants = parseCardVariants(card);
    var availableMatch = variants.find(function (variant) {
      return variantMatchesOptions(variant, card, colorValue, sizeValue) && variant.available;
    });
    if (availableMatch) return availableMatch;

    return variants.find(function (variant) {
      return variantMatchesOptions(variant, card, colorValue, sizeValue);
    }) || null;
  }

  function siblingProductUrl(card) {
    var swatch = card.querySelector('[data-swatch].is-active');
    var url = swatch && swatch.dataset.productUrl;
    if (!url || !card.dataset.productUrl) return null;
    try {
      var dest = new URL(url, window.location.origin);
      var cur = new URL(card.dataset.productUrl, window.location.origin);
      if (dest.pathname.replace(/\/$/, '') !== cur.pathname.replace(/\/$/, '')) return dest.href;
    } catch (e) {}
    return null;
  }

  function isVariantAvailableForSelection(card, colorValue, sizeValue) {
    return parseCardVariants(card).some(function (variant) {
      return variantMatchesOptions(variant, card, colorValue, sizeValue) && variant.available;
    });
  }

  function variantExistsForSelection(card, colorValue, sizeValue) {
    return parseCardVariants(card).some(function (variant) {
      return variantMatchesOptions(variant, card, colorValue, sizeValue);
    });
  }

  function getMobileDrawer(section) {
    if (!section) return null;
    var sectionId = section.dataset.sectionId;
    if (sectionId) {
      var byId = document.getElementById('na-mobile-drawer-' + sectionId);
      if (byId) return byId;
    }
    return section.querySelector('[data-na-mobile-drawer]')
      || document.querySelector('[data-na-drawer-section="' + sectionId + '"]');
  }

  function mountMobileDrawerAfterPageWrapper(section) {
    var drawer = getMobileDrawer(section);
    if (!drawer || drawer.dataset.naMounted === 'true') return;

    var pageWrapper = document.querySelector('.page-wrapper');
    if (pageWrapper) {
      pageWrapper.insertAdjacentElement('afterend', drawer);
      drawer.dataset.naMounted = 'true';
    }
  }

  function initMobileDrawer(section, showToast) {
    mountMobileDrawerAfterPageWrapper(section);
    var drawer = getMobileDrawer(section);
    if (!drawer) return;

    var mobileQuery = window.matchMedia('(max-width: 989px)');
    var activeCard = null;
    var drawerState = { color: null, size: null };

    var colorsWrap = drawer.querySelector('[data-na-drawer-colors-wrap]');
    var swatchesEl = drawer.querySelector('[data-na-drawer-swatches]');
    var sizesWrap = drawer.querySelector('[data-na-drawer-sizes-wrap]');
    var sizesEl = drawer.querySelector('[data-na-drawer-sizes]');
    var colorLabelEl = drawer.querySelector('[data-na-drawer-color-label]');
    var colorValueEl = drawer.querySelector('[data-na-drawer-color-value]');
    var sizeLabelEl = drawer.querySelector('[data-na-drawer-size-label]');
    var sizeValueEl = drawer.querySelector('[data-na-drawer-size-value]');
    var submitBtn = drawer.querySelector('[data-na-drawer-submit]');

    function closeDrawer() {
      var active = document.activeElement;
      if (active && drawer.contains(active) && typeof active.blur === 'function') {
        active.blur();
      }
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('na-drawer-open');
      activeCard = null;
      drawerState = { color: null, size: null };
    }

    function updateDrawerSubmit() {
      if (!activeCard || !submitBtn) return;

      var hasColors = !colorsWrap.hidden;
      var hasSizes = !sizesWrap.hidden;
      var variant = findSelectedVariant(activeCard, drawerState.color, drawerState.size);
      var ready = true;

      if (hasColors && !drawerState.color) ready = false;
      if (hasSizes && !drawerState.size) ready = false;
      if (ready && variant && !variant.available) ready = false;
      if (ready && !hasColors && !hasSizes) {
        variant = parseCardVariants(activeCard).find(function (item) { return item.available; }) || parseCardVariants(activeCard)[0];
        ready = !!(variant && variant.available);
      }

      submitBtn.disabled = !ready;
    }

    function applyDrawerFilters() {
      if (!activeCard) return;

      var linked = cardHasLinkedVariants(activeCard);

      swatchesEl.querySelectorAll('[data-na-drawer-swatch]').forEach(function (btn) {
        var color = btn.dataset.colorValue;
        var show = !drawerState.size || !linked || variantExistsForSelection(activeCard, color, drawerState.size);
        btn.hidden = !show;
        if (!show && btn.classList.contains('is-active')) {
          btn.classList.remove('is-active');
          drawerState.color = null;
          if (colorValueEl) colorValueEl.textContent = '';
        }
      });

      sizesEl.querySelectorAll('[data-na-drawer-size]').forEach(function (btn) {
        var size = btn.dataset.sizeValue;
        var show = !drawerState.color || !linked || variantExistsForSelection(activeCard, drawerState.color, size);
        btn.hidden = !show;

        var available = isVariantAvailableForSelection(activeCard, drawerState.color, size);
        btn.disabled = !available;
        btn.classList.toggle('is-unavailable', !available);

        if (!show && btn.classList.contains('is-active')) {
          btn.classList.remove('is-active');
          drawerState.size = null;
          if (sizeValueEl) sizeValueEl.textContent = '';
        }
      });

      if (drawerState.size && !swatchesEl.querySelector('[data-na-drawer-swatch].is-active:not([hidden])')) {
        var firstColor = swatchesEl.querySelector('[data-na-drawer-swatch]:not([hidden])');
        if (firstColor) firstColor.click();
      }

      if (!sizesWrap.hidden) {
        var activeSizeBtn = sizesEl.querySelector('[data-na-drawer-size].is-active:not([hidden])');
        if (activeSizeBtn && (activeSizeBtn.disabled || activeSizeBtn.hidden)) {
          activeSizeBtn.classList.remove('is-active');
          drawerState.size = null;
          if (sizeValueEl) sizeValueEl.textContent = '';
        }

        if (drawerState.color || colorsWrap.hidden) {
          var validActiveSize = sizesEl.querySelector('[data-na-drawer-size].is-active:not([hidden]):not(:disabled)');
          if (!validActiveSize) {
            var firstAvailableSize = sizesEl.querySelector('[data-na-drawer-size]:not([hidden]):not(:disabled)');
            if (firstAvailableSize) {
              sizesEl.querySelectorAll('[data-na-drawer-size]').forEach(function (item) {
                item.classList.remove('is-active');
              });
              firstAvailableSize.classList.add('is-active');
              drawerState.size = firstAvailableSize.dataset.sizeValue;
              if (sizeValueEl) sizeValueEl.textContent = firstAvailableSize.textContent.trim();
            }
          }
        }
      }

      updateDrawerSubmit();
    }

    function getCardSwatchForColor(card, colorValue) {
      var needle = normValue(colorValue);
      var match = null;
      card.querySelectorAll('[data-swatch]').forEach(function (swatch) {
        if (!match && normValue(swatch.dataset.colorValue) === needle) {
          match = swatch;
        }
      });
      return match;
    }

    function appendDrawerSwatchVisual(btn, options) {
      var imageSrc = options.imageSrc;
      var hex = options.hex;
      var isMulti = options.isMulti;

      if (imageSrc) {
        var img = document.createElement('img');
        img.src = imageSrc;
        img.alt = options.label || '';
        img.loading = 'lazy';
        btn.appendChild(img);
        return;
      }

      var colorBlock = document.createElement('span');
      colorBlock.className = 'na-mobile-drawer__swatch-color';
      if (isMulti) {
        colorBlock.classList.add('na-mobile-drawer__swatch-color--multi');
      } else if (hex) {
        colorBlock.style.backgroundColor = hex;
      }
      btn.appendChild(colorBlock);
    }

    function buildDrawerSwatchButton(entry, cardSwatch) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'na-mobile-drawer__swatch';
      btn.dataset.naDrawerSwatch = 'true';
      btn.dataset.colorValue = entry.label;
      btn.setAttribute('role', 'listitem');
      btn.setAttribute('aria-label', entry.label);

      var imageSrc = entry.thumb || entry.main || (cardSwatch && cardSwatch.dataset.imageSrc) || null;
      var hex = entry.hex || (cardSwatch && cardSwatch.style.backgroundColor) || '';
      var isMulti = entry.isMulti || (cardSwatch && cardSwatch.classList.contains('na-swatch--multi'));

      appendDrawerSwatchVisual(btn, {
        imageSrc: imageSrc,
        hex: hex,
        isMulti: isMulti,
        label: entry.label
      });

      btn.addEventListener('click', function () {
        swatchesEl.querySelectorAll('[data-na-drawer-swatch]').forEach(function (item) {
          item.classList.remove('is-active');
        });
        btn.classList.add('is-active');
        drawerState.color = entry.label;
        if (colorValueEl) colorValueEl.textContent = entry.label;
        applyDrawerFilters();
      });

      return btn;
    }

    function buildDrawerContent(card) {
      drawerState = { color: null, size: null };
      swatchesEl.innerHTML = '';
      sizesEl.innerHTML = '';

      var colorMap = parseColorMap(card);
      var cardSwatches = card.querySelectorAll('[data-swatch]');
      var cardSizes = card.querySelectorAll('.na-sizes__btn');
      var hasColors = colorMap.length > 0 || cardSwatches.length > 0;
      var hasSizes = cardSizes.length > 0;

      if (colorLabelEl) {
        colorLabelEl.textContent = card.dataset.colorOptionName || 'Colour';
      }
      if (sizeLabelEl) {
        sizeLabelEl.textContent = card.dataset.sizeOptionName || 'Size';
      }
      if (colorValueEl) colorValueEl.textContent = '';
      if (sizeValueEl) sizeValueEl.textContent = '';

      colorsWrap.hidden = !hasColors;
      sizesWrap.hidden = !hasSizes;

      if (hasColors) {
        var swatchEntries = [];

        if (cardSwatches.length > 0) {
          cardSwatches.forEach(function (swatch) {
            swatchEntries.push({
              label: swatch.dataset.colorValue,
              thumb: swatch.dataset.imageSrc || null,
              main: swatch.dataset.imageSrc || null,
              hex: swatch.style.backgroundColor || null,
              isMulti: swatch.classList.contains('na-swatch--multi'),
              cardSwatch: swatch
            });
          });
        } else if (colorMap.length > 0) {
          colorMap.forEach(function (entry) {
            swatchEntries.push({
              label: entry.label,
              thumb: entry.thumb,
              main: entry.main,
              hex: entry.hex,
              isMulti: entry.isMulti,
              cardSwatch: getCardSwatchForColor(card, entry.label)
            });
          });
        }

        swatchEntries.forEach(function (entry) {
          var btn = buildDrawerSwatchButton(entry, entry.cardSwatch);
          swatchesEl.appendChild(btn);

          var defaultColor = card.dataset.defaultColor;
          var cardActive = entry.cardSwatch && entry.cardSwatch.classList.contains('is-active');
          var isDefault = defaultColor && normValue(entry.label) === normValue(defaultColor);
          if (cardActive || isDefault) {
            btn.classList.add('is-active');
            drawerState.color = entry.label;
            if (colorValueEl) colorValueEl.textContent = entry.label;
          }
        });

        if (!drawerState.color && swatchEntries.length) {
          var firstBtn = swatchesEl.querySelector('[data-na-drawer-swatch]');
          if (firstBtn) {
            firstBtn.classList.add('is-active');
            drawerState.color = firstBtn.dataset.colorValue;
            if (colorValueEl) colorValueEl.textContent = drawerState.color;
          }
        }
      }

      if (hasSizes) {
        var defaultSize = card.dataset.defaultSize;
        var matchedDefaultSize = false;

        cardSizes.forEach(function (sizeBtn) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'na-mobile-drawer__size';
          btn.dataset.naDrawerSize = 'true';
          btn.dataset.sizeValue = sizeBtn.dataset.sizeValue;
          btn.textContent = sizeBtn.querySelector('.na-sizes__label')
            ? sizeBtn.querySelector('.na-sizes__label').textContent.trim()
            : sizeBtn.dataset.sizeValue;
          btn.disabled = false;
          btn.classList.remove('is-unavailable');

          btn.addEventListener('click', function () {
            if (btn.disabled || btn.hidden) return;
            sizesEl.querySelectorAll('[data-na-drawer-size]').forEach(function (item) {
              item.classList.remove('is-active');
            });
            btn.classList.add('is-active');
            drawerState.size = sizeBtn.dataset.sizeValue;
            if (sizeValueEl) sizeValueEl.textContent = btn.textContent;
            applyDrawerFilters();
          });

          sizesEl.appendChild(btn);

          if (defaultSize && normValue(sizeBtn.dataset.sizeValue) === normValue(defaultSize)) {
            btn.classList.add('is-active');
            drawerState.size = sizeBtn.dataset.sizeValue;
            if (sizeValueEl) sizeValueEl.textContent = btn.textContent;
            matchedDefaultSize = true;
          }
        });
      }

      applyDrawerFilters();

      if (hasSizes && !drawerState.size) {
        var firstAvailableSize = sizesEl.querySelector('[data-na-drawer-size]:not([hidden]):not(:disabled)');
        if (firstAvailableSize) {
          firstAvailableSize.classList.add('is-active');
          drawerState.size = firstAvailableSize.dataset.sizeValue;
          if (sizeValueEl) sizeValueEl.textContent = firstAvailableSize.textContent.trim();
          updateDrawerSubmit();
        }
      }
    }

    function openDrawer(card) {
      if (!mobileQuery.matches || !card) return;
      activeCard = card;
      buildDrawerContent(card);
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.classList.add('na-drawer-open');
    }

    section.querySelectorAll('[data-na-mobile-add]').forEach(function (btn) {
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        if (!mobileQuery.matches) return;
        openDrawer(btn.closest('[data-na-card]'));
      });
    });

    drawer.querySelectorAll('[data-na-drawer-close]').forEach(function (btn) {
      btn.addEventListener('click', closeDrawer);
    });

    if (submitBtn) {
      submitBtn.addEventListener('click', function () {
        if (!activeCard || submitBtn.disabled) return;

        var variant = findSelectedVariant(activeCard, drawerState.color, drawerState.size);
        if (!variant) {
          variant = parseCardVariants(activeCard).find(function (item) { return item.available; })
            || parseCardVariants(activeCard)[0];
        }
        if (!variant || !variant.available) {
          var otherUrl = siblingProductUrl(activeCard);
          if (otherUrl) {
            window.location.href = otherUrl;
            return;
          }
          showToast('Selected option is unavailable');
          return;
        }

        submitBtn.disabled = true;
        naAddVariantToCart(section, variant.id, true, function (message) {
          showToast(message);
          submitBtn.disabled = false;
        }).then(function (added) {
          if (added) {
            showToast('Added to cart');
            closeDrawer();
          }
        });
      });
    }
  }

  function initCardVariantPicker(card, section, showToast) {
    var linked = cardHasLinkedVariants(card);
    var sizePos = card.dataset.sizePosition;
    var colorPos = card.dataset.colorPosition;
    var sizesWrap = card.querySelector('[data-na-sizes]');
    var hasSwatches = card.querySelector('[data-swatch]');
    var state = { size: null, color: null };

    function getVariants() { return parseCardVariants(card); }

    function applyFilters() {
      if (!linked) return;

      card.querySelectorAll('[data-swatch]').forEach(function (swatch) {
        var color = swatch.dataset.colorValue;
        var show = !state.size || variantExistsForSelection(card, color, state.size);
        swatch.classList.toggle('is-hidden', !show);
        if (!show && swatch.classList.contains('is-active')) {
          swatch.classList.remove('is-active');
        }
      });

      if (state.size) {
        var activeSwatch = card.querySelector('[data-swatch].is-active:not(.is-hidden)');
        if (!activeSwatch) {
          var firstColor = card.querySelector('[data-swatch]:not(.is-hidden)');
          if (firstColor) selectColor(firstColor, false);
        }
      }

      if (sizesWrap) {
        sizesWrap.querySelectorAll('.na-sizes__btn').forEach(function (btn) {
          var size = btn.dataset.sizeValue;
          var show = !state.color || variantExistsForSelection(card, state.color, size);
          btn.classList.toggle('is-hidden', !show);

          var available = isVariantAvailableForSelection(card, state.color, size);
          btn.classList.toggle('na-sizes__btn--disabled', !available);
          btn.disabled = !available;
          if (!show && btn.classList.contains('is-selected')) {
            btn.classList.remove('is-selected');
            state.size = null;
          }
        });
      }
    }

    function updateImageFromSelection(activeSwatch) {
      var image = resolveMainImage(card, state.color, state.size, activeSwatch);
      if (image && image.src) {
        setCardImage(card, image.src, image.srcset);
      } else {
        resetCardImage(card);
      }
    }

    var quickAtcBtn = null;
    var desktopQuery = window.matchMedia('(min-width: 990px)');

    function getEffectiveColor() {
      if (state.color) return state.color;
      var active = card.querySelector('[data-swatch].is-active:not(.is-hidden)');
      return active ? active.dataset.colorValue : null;
    }

    function ensureQuickAtcBtn() {
      if (quickAtcBtn) return quickAtcBtn;
      var media = card.querySelector('.na-card__media');
      if (!media) return null;

      quickAtcBtn = document.createElement('button');
      quickAtcBtn.type = 'button';
      quickAtcBtn.className = 'na-quick-atc';
      quickAtcBtn.textContent = 'Add To Cart';
      quickAtcBtn.setAttribute('aria-label', 'Add ' + (card.dataset.productTitle || 'product') + ' to cart');

      quickAtcBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var variant = findSelectedVariant(card, getEffectiveColor(), state.size);
        if (!variant || !variant.available) {
          var otherUrl = siblingProductUrl(card);
          if (otherUrl) {
            window.location.href = otherUrl;
            return;
          }
          showToast('Selected option is unavailable');
          return;
        }

        quickAtcBtn.disabled = true;
        naAddVariantToCart(section, variant.id, true, function (message) {
          showToast(message);
          quickAtcBtn.disabled = false;
        }).then(function (added) {
          quickAtcBtn.disabled = false;
          if (added) {
            showToast('Added to cart');
          }
        });
      });

      media.appendChild(quickAtcBtn);
      return quickAtcBtn;
    }

    function updateQuickAtc() {
      if (!desktopQuery.matches || !hasSwatches || !sizesWrap) {
        card.classList.remove('na-quick-atc-visible');
        return;
      }

      var color = getEffectiveColor();
      var show = !!(state.size && color);

      if (show) {
        var variant = findSelectedVariant(card, color, state.size);
        show = !!(variant && variant.available);
      }

      if (show) ensureQuickAtcBtn();
      card.classList.toggle('na-quick-atc-visible', show);
    }

    function selectColor(swatch, runFilters) {
      card.querySelectorAll('[data-swatch]').forEach(function (s) { s.classList.remove('is-active'); });
      swatch.classList.add('is-active');
      state.color = swatch.dataset.colorValue;
      if (swatch.dataset.productUrl) {
        card.querySelectorAll('.na-card__image-link, .na-card__title a').forEach(function (link) {
          link.href = swatch.dataset.productUrl;
        });
      }

      if (runFilters !== false) applyFilters();

      var activeSwatch = card.querySelector('[data-swatch].is-active:not(.is-hidden)') || swatch;
      updateImageFromSelection(activeSwatch);
      updateQuickAtc();
    }

    function selectSize(btn, runFilters) {
      if (btn.disabled || btn.classList.contains('is-hidden')) return;
      sizesWrap.querySelectorAll('.na-sizes__btn').forEach(function (b) {
        b.classList.remove('is-selected');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-selected');
      btn.setAttribute('aria-pressed', 'true');
      sizesWrap.classList.add('has-selection');
      state.size = btn.dataset.sizeValue;
      if (runFilters !== false) applyFilters();
      updateImageFromSelection(card.querySelector('[data-swatch].is-active:not(.is-hidden)'));
      updateQuickAtc();
    }

    card.querySelectorAll('[data-swatch]').forEach(function (swatch) {
      swatch.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (swatch.classList.contains('is-hidden')) return;
        selectColor(swatch);
      });
    });

    if (sizesWrap) {
      sizesWrap.querySelectorAll('.na-sizes__btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (btn.disabled || btn.classList.contains('is-hidden')) return;

          selectSize(btn);

          if (hasSwatches || linked) {
            return;
          }

          var variantId = btn.dataset.variantId;
          if (!variantId) return;

          naAddVariantToCart(section, variantId, true, function (message) {
            showToast(message);
          }).then(function (added) {
            if (added) {
              showToast('Added to cart — Size ' + (btn.getAttribute('title') || btn.dataset.sizeValue || btn.textContent.trim()));
            }
          });
        });
      });
    }
  }

  function naInitCartCountSync() {
    if (window._naCartCountSyncBound) return;
    window._naCartCountSyncBound = true;

    var mutationRe = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;
    var syncTimer = null;

    function refreshHeaderCount() {
      clearTimeout(syncTimer);
      syncTimer = setTimeout(function () {
        fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (cart) {
            naUpdateHeaderCartCount(cart);
          })
          .catch(function () {});
      }, 350);
    }

    if (window.fetch) {
      var naOrigFetch = window.fetch;
      window.fetch = function (input) {
        var url = '';
        try {
          url = typeof input === 'string' ? input : String((input && input.url) || input || '');
        } catch (e) {}
        var result = naOrigFetch.apply(this, arguments);
        if (mutationRe.test(url)) {
          result.then(refreshHeaderCount, function () {});
        }
        return result;
      };
    }

    if (window.XMLHttpRequest) {
      var naOrigXhrOpen = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function (method, url) {
        try {
          if (url && mutationRe.test(String(url))) {
            this.addEventListener('load', refreshHeaderCount);
          }
        } catch (e) {}
        return naOrigXhrOpen.apply(this, arguments);
      };
    }
  }

  document.querySelectorAll('.na-section').forEach(initNewArrivals);
  naInitCartCountSync();

  document.addEventListener('shopify:section:load', function (e) {
    var section = e.target.querySelector('.na-section') || e.target;
    if (section.classList && section.classList.contains('na-section')) {
      section.dataset.naInit = '';
      initNewArrivals(section);
    }
  });
  })();
</script>

<script>
  (function () {
    var STORAGE_KEY = 'heritage_wishlist';

    function readWishlist() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      } catch (e) {
        return [];
      }
    }

    function writeWishlist(items) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      } catch (e) {}
      document.dispatchEvent(
        new CustomEvent('heritage:wishlist:update', {
          detail: { items: items, count: items.length }
        })
      );
      syncWishlistUI();
    }

    function syncWishlistUI() {
      var items = readWishlist();
      var ids = items.map(function (item) { return String(item.id); });

      document.querySelectorAll('[data-wishlist-btn]').forEach(function (btn) {
        var productId = btn.dataset.productId;
        if (!productId) return;
        var active = ids.indexOf(String(productId)) !== -1;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.setAttribute('aria-label', active ? 'Remove from wishlist' : 'Add to wishlist');
      });

      document.querySelectorAll('[data-wishlist-count]').forEach(function (el) {
        el.textContent = items.length;
        el.classList.toggle('is-empty', items.length === 0);
      });
    }

    function getProductFromBtn(btn) {
      return {
        id: String(btn.dataset.productId || ''),
        handle: btn.dataset.productHandle || '',
        title: btn.dataset.productTitle || '',
        image: btn.dataset.productImage || '',
        price: btn.dataset.productPrice || '',
        url: btn.dataset.productUrl || ''
      };
    }

    function showWishlistToast(added) {
      var toast = document.querySelector('[data-wishlist-toast]');
      if (!toast) return;
      toast.textContent = added ? 'Added to wishlist' : 'Removed from wishlist';
      toast.classList.add('is-visible');
      clearTimeout(window._heritageWishlistToastTimer);
      window._heritageWishlistToastTimer = setTimeout(function () {
        toast.classList.remove('is-visible');
      }, 2200);
    }

    if (!window.HeritageWishlist) {
      window.HeritageWishlist = {
        getAll: readWishlist,
        count: function () { return readWishlist().length; },
        has: function (id) {
          return readWishlist().some(function (item) {
            return String(item.id) === String(id);
          });
        },
        add: function (product) {
          if (!product || !product.id) return false;
          if (this.has(product.id)) return false;
          var items = readWishlist();
          items.push(Object.assign({}, product, { id: String(product.id), addedAt: Date.now() }));
          writeWishlist(items);
          return true;
        },
        remove: function (id) {
          writeWishlist(readWishlist().filter(function (item) {
            return String(item.id) !== String(id);
          }));
        },
        toggle: function (product) {
          if (!product || !product.id) return false;
          if (this.has(product.id)) {
            this.remove(product.id);
            return false;
          }
          return this.add(product);
        },
        clear: function () { writeWishlist([]); },
        sync: syncWishlistUI
      };
    } else if (!window.HeritageWishlist.sync) {
      window.HeritageWishlist.sync = syncWishlistUI;
    }

    if (!window._heritageWishlistClickBound) {
      window._heritageWishlistClickBound = true;

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-wishlist-btn]');
        if (!btn || !window.HeritageWishlist) return;

        e.preventDefault();
        e.stopPropagation();

        var product = getProductFromBtn(btn);
        if (!product.id) return;

        var added = window.HeritageWishlist.toggle(product);
        syncWishlistUI();
        showWishlistToast(added);
      });
    }

    syncWishlistUI();
    document.addEventListener('shopify:section:load', syncWishlistUI);
    document.addEventListener('heritage:wishlist:update', syncWishlistUI);
  })();
</script>

<script>
  (function () {
    if (window.__naStampedRatingReady) {
      if (typeof window.naBootStampedRatings === 'function') window.naBootStampedRatings();
      return;
    }
    window.__naStampedRatingReady = true;

    function parseCount(value) {
      var n = parseInt(String(value || '').trim(), 10);
      return isNaN(n) ? null : n;
    }

    function getStampedCount(source) {
      if (!source) return null;
      var caption = source.querySelector('.stamped-badge-caption[data-reviews]');
      if (caption) {
        var fromAttr = parseCount(caption.getAttribute('data-reviews'));
        if (fromAttr !== null) return fromAttr;
      }
      var badge = source.querySelector('.stamped-badge[aria-label]');
      if (badge) {
        var match = String(badge.getAttribute('aria-label') || '').match(/(\d+)\s*reviews?/i);
        if (match) return parseCount(match[1]);
      }
      return null;
    }

    function getFallbackCount(container) {
      if (container.hasAttribute('data-fallback-count')) {
        return parseCount(container.getAttribute('data-fallback-count')) || 0;
      }
      var pill = container.querySelector('[data-na-rating-sync]');
      if (pill && pill.hasAttribute('data-fallback-count')) {
        return parseCount(pill.getAttribute('data-fallback-count')) || 0;
      }
      if (container.hasAttribute('data-rating-count')) {
        return parseCount(container.getAttribute('data-rating-count')) || 0;
      }
      return 0;
    }

    function applyCount(container, count) {
      if (count === null || count === undefined) return;

      if (container.classList.contains('cg-card-wrap')) {
        container.setAttribute('data-rating-count', String(count));
      }

      container.querySelectorAll('.na-rating-pill, .na-rating').forEach(function (el) {
        var span = el.querySelector('[data-na-rating-count]') || el.querySelector('span:last-of-type') || el.querySelector('span');
        if (count <= 0) {
          el.style.setProperty('display', 'none', 'important');
          el.setAttribute('hidden', '');
          return;
        }
        el.removeAttribute('hidden');
        el.style.removeProperty('display');
        if (span) span.textContent = String(count);
      });
    }

    function syncContainer(container, allowFallback) {
      var stamped = container.querySelector('.na-stamped-source');
      var stampedCount = getStampedCount(stamped);
      if (stampedCount !== null) {
        container.setAttribute('data-stamped-synced', 'true');
        applyCount(container, stampedCount);
        return;
      }
      if (allowFallback && !container.getAttribute('data-stamped-synced')) {
        applyCount(container, getFallbackCount(container));
      }
    }

    function loadStampedBadges() {
      if (!window.StampedFn) return;
      try {
        if (typeof StampedFn.loadBadges === 'function') StampedFn.loadBadges();
      } catch (e) {}
    }

    function observeContainer(container) {
      if (container.__naStampedObserved) return;
      container.__naStampedObserved = true;
      var stamped = container.querySelector('.na-stamped-source');
      if (!stamped || !window.MutationObserver) return;
      var observer = new MutationObserver(function () {
        syncContainer(container, false);
      });
      observer.observe(stamped, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['data-reviews', 'aria-label', 'class']
      });
    }

    function init(scope) {
      var root = scope && scope.querySelector ? scope : document;
      loadStampedBadges();
      root.querySelectorAll('.cg-card-wrap, [data-na-card]').forEach(function (container) {
        if (!container.querySelector('.na-stamped-source')) return;
        observeContainer(container);
        syncContainer(container, false);
      });
    }

    function boot(scope) {
      init(scope);
      window.setTimeout(function () { init(scope); }, 500);
      window.setTimeout(function () { init(scope); }, 1500);
      window.setTimeout(function () { init(scope); }, 3000);
      window.setTimeout(function () {
        var root = scope && scope.querySelector ? scope : document;
        root.querySelectorAll('.cg-card-wrap, [data-na-card]').forEach(function (container) {
          if (!container.querySelector('.na-stamped-source')) return;
          if (!container.getAttribute('data-stamped-synced')) {
            syncContainer(container, true);
          }
        });
      }, 4500);
    }

    window.naBootStampedRatings = boot;

    var stampedPoll = window.setInterval(function () {
      if (window.StampedFn) {
        window.clearInterval(stampedPoll);
        boot();
      }
    }, 200);

    window.setTimeout(function () { window.clearInterval(stampedPoll); }, 12000);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { boot(); });
    } else {
      boot();
    }

    document.addEventListener('shopify:section:load', function (event) {
      boot(event.target);
    });
  })();
</script>

