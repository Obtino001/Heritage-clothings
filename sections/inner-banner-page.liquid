{% assign block_settings = block.settings %}

<div
  class="inner-banner-page{% if block_settings.background_image != blank %} inner-banner-page--has-image{% endif %}"
  style="
    --inner-banner-page-bg: {{ block_settings.background_color | default: '#F9F3EB' }};
    --inner-banner-page-heading-color: {{ block_settings.heading_color | default: '#1A1A1A' }};
    --inner-banner-page-overlay: {{ block_settings.image_overlay_opacity | default: 0 }}%;
    --inner-banner-page-decor-opacity: {{ block_settings.decoration_opacity | default: 100 }}%;
    --inner-banner-page-radius: {{ block_settings.border_radius | default: 12 }}px;
    --inner-banner-page-min-height: {{ block_settings.banner_height | default: 180 }}px;
    padding-top: {{ block_settings.padding_top | default: 0 }}px;
    padding-bottom: {{ block_settings.padding_bottom | default: 0 }}px;
    padding-left: {{ block_settings.padding_left | default: 0 }}px;
    padding-right: {{ block_settings.padding_right | default: 0 }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="inner-banner-page__inner">
    {% if block_settings.background_image != blank %}
      <div
        class="inner-banner-page__background"
        style="
          --inner-banner-page-image-position: {{ block_settings.background_position | default: 'center center' }};
        "
      >
        {{
          block_settings.background_image
          | image_url: width: 2400
          | image_tag:
            widths: '600, 900, 1200, 1800, 2400',
            sizes: '100vw',
            alt: '',
            class: 'inner-banner-page__background-image',
            loading: 'lazy'
        }}
      </div>
      <div class="inner-banner-page__overlay" aria-hidden="true"></div>
    {% endif %}

    {% if block_settings.show_decorations %}
      <div class="inner-banner-page__decor inner-banner-page__decor--left" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <path d="M-10 210 C30 170, 55 130, 70 95 C85 60, 95 30, 105 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M70 95 C55 88, 40 82, 22 78" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M70 95 C82 102, 98 108, 118 112" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M55 130 C42 122, 28 118, 12 116" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M55 130 C68 138, 84 144, 100 148" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M40 158 C30 150, 18 146, 5 144" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <ellipse cx="22" cy="78" rx="14" ry="7" transform="rotate(-25 22 78)" fill="currentColor" opacity="0.9"/>
          <ellipse cx="118" cy="112" rx="16" ry="8" transform="rotate(35 118 112)" fill="currentColor" opacity="0.9"/>
          <ellipse cx="12" cy="116" rx="13" ry="6.5" transform="rotate(-15 12 116)" fill="currentColor" opacity="0.85"/>
          <ellipse cx="100" cy="148" rx="15" ry="7.5" transform="rotate(20 100 148)" fill="currentColor" opacity="0.85"/>
          <ellipse cx="5" cy="144" rx="12" ry="6" transform="rotate(-10 5 144)" fill="currentColor" opacity="0.8"/>
          <ellipse cx="85" cy="60" rx="11" ry="5.5" transform="rotate(40 85 60)" fill="currentColor" opacity="0.75"/>
        </svg>
      </div>

      <div class="inner-banner-page__decor inner-banner-page__decor--right" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <path d="M210 -10 C170 30, 145 70, 130 105 C115 140, 105 170, 95 195" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M130 105 C145 98, 160 92, 178 88" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M130 105 C118 112, 102 118, 82 122" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M145 70 C158 78, 172 82, 188 84" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M145 70 C132 62, 116 56, 100 52" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M160 42 C170 50, 182 54, 195 56" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <ellipse cx="178" cy="88" rx="14" ry="7" transform="rotate(25 178 88)" fill="currentColor" opacity="0.9"/>
          <ellipse cx="82" cy="122" rx="16" ry="8" transform="rotate(-35 82 122)" fill="currentColor" opacity="0.9"/>
          <ellipse cx="188" cy="84" rx="13" ry="6.5" transform="rotate(15 188 84)" fill="currentColor" opacity="0.85"/>
          <ellipse cx="100" cy="52" rx="15" ry="7.5" transform="rotate(-20 100 52)" fill="currentColor" opacity="0.85"/>
          <ellipse cx="195" cy="56" rx="12" ry="6" transform="rotate(10 195 56)" fill="currentColor" opacity="0.8"/>
          <ellipse cx="115" cy="140" rx="11" ry="5.5" transform="rotate(-40 115 140)" fill="currentColor" opacity="0.75"/>
        </svg>
      </div>
    {% endif %}

    {% assign heading = block_settings.heading | default: 'About Us' %}
    {% if heading != blank %}
      <h2 class="inner-banner-page__heading">{{ heading | escape }}</h2>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .inner-banner-page {
    width: 100%;
  }

  .inner-banner-page__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--inner-banner-page-min-height);
    background-color: var(--inner-banner-page-bg);
    border-radius: var(--inner-banner-page-radius);
    overflow: hidden;
    isolation: isolate;
  }

  .inner-banner-page__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .inner-banner-page__background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--inner-banner-page-image-position);
    display: block;
  }

  .inner-banner-page__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--inner-banner-page-bg);
    opacity: calc(var(--inner-banner-page-overlay) / 100);
    pointer-events: none;
  }

  .inner-banner-page__decor {
    position: absolute;
    z-index: 2;
    color: #ffffff;
    opacity: calc(var(--inner-banner-page-decor-opacity) / 100);
    pointer-events: none;
  }

  .inner-banner-page__decor svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .inner-banner-page__decor--left {
    left: 0;
    bottom: 0;
    width: min(38%, 220px);
    height: min(85%, 170px);
    transform: translate(-8%, 8%);
  }

  .inner-banner-page__decor--right {
    right: 0;
    top: 0;
    width: min(38%, 220px);
    height: min(85%, 170px);
    transform: translate(8%, -8%);
  }

  .inner-banner-page__heading {
    position: relative;
    z-index: 3;
    margin: 0;
    padding: 1.5rem 2rem;
    color: var(--inner-banner-page-heading-color);
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .inner-banner-page__decor--left {
      width: min(32%, 280px);
      height: min(90%, 200px);
    }

    .inner-banner-page__decor--right {
      width: min(32%, 280px);
      height: min(90%, 200px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Inner banner page",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Us"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9F3EB",
      "info": "Used as the banner fill. Also tints over a background image when overlay is set."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Replaces the solid color when added."
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Adds a color wash over the image to keep text readable."
    },
    {
      "type": "header",
      "content": "Decorations"
    },
    {
      "type": "checkbox",
      "id": "show_decorations",
      "label": "Show leaf decorations",
      "default": true
    },
    {
      "type": "range",
      "id": "decoration_opacity",
      "label": "Decoration opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A1A"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Inner banner page"
    }
  ]
}
{% endschema %}
