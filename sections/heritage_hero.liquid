          </span>
          </span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="heritage_hero_heading_">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      <div class="heritage_hero_buttons_">
        {% if section.settings.button_1_text != blank %}
          <a
            href="{{ section.settings.button_1_link }}"
            class="heritage_hero_button_ heritage_hero_button_primary_"
          >
            {{ section.settings.button_1_text }}
          </a>
        {% endif %}

        {% if section.settings.button_2_text != blank %}
          <a
            href="{{ section.settings.button_2_link }}"
            class="heritage_hero_button_ heritage_hero_button_secondary_"
          >
            {{ section.settings.button_2_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
            .heritage_hero_ {
          position: relative;
        }

        .text_rating_wrap{
          display: flex;
          align-items: center;
          gap: 5px;
        }

        .heritage_hero_image_wrap_ {
          position: relative;

          overflow: hidden;
        }

        .heritage_hero_image_wrap_ .mob{
          display: none;
        }

        .heritage_hero_ .trust_pilot_icon_txt{
          display: flex;
          align-items: center;
      }

        /* Background video support: reuse the same classes as the image
           so all existing sizing / responsive rules apply unchanged,
           just add the crop + interaction fixes videos need. */
        .heritage_hero_image_wrap_ .heritage_hero_bg_video_ {
          width: 100%;
          object-fit: cover;
          pointer-events: none;
        }

        .heritage_hero_image_wrap_ video.heritage_hero_image_ {
          display: block;
        }

        .heritage_hero_image_wrap_ video.mob {
          width: 100%;
          object-fit: cover;
        }

        .heritage_hero_overlay_ {
          position: absolute;
          inset: 0;
          z-index: 1;
          pointer-events: none;
        }

        /* Content alignment — driven by the "Content alignment" setting via
           data-content-position on the section root. Left is the original
           default and is intentionally left un-overridden below so existing
           sections render pixel-identical to before this option existed. */
        .heritage_hero_[data-content-position='center'] .page-width {
          justify-content: center;
        }

        .heritage_hero_[data-content-position='center'] .heritage_hero_content_ {
          align-items: center;
          text-align: center;
        }

        .heritage_hero_[data-content-position='center'] .heritage_hero_rating_ {
          justify-content: center;
        }

        .heritage_hero_[data-content-position='center'] .heritage_hero_buttons_ {
          justify-content: center;
        }

        .heritage_hero_[data-content-position='right'] .page-width {
          justify-content: end;
        }

        .heritage_hero_[data-content-position='right'] .heritage_hero_content_ {
          align-items: flex-end;
          text-align: right;
        }

        .heritage_hero_[data-content-position='right'] .heritage_hero_rating_ {
          justify-content: flex-end;
        }

        .heritage_hero_[data-content-position='right'] .heritage_hero_buttons_ {
          justify-content: flex-end;
        }


          .heritage_hero_ .page-width {
      position: absolute;
      inset: 0;

      z-index: 2;

      display: flex;
