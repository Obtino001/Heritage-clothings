    },
    {
      "type": "image_picker",
      "id": "mob",
      "label": "Mobile Image"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video",
      "info": "Optional. Upload a short, muted MP4 to use as the background instead of the mobile image above. Plays automatically, muted and looping."
    },

    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "Excellent 4.8 out of 5 Ratings on Trustpilot"
    },

    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Wear Your Heritage.<br><em>Boldly.</em>"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Primary Button Text",
      "default": "Shop New In"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Secondary Button Text",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
