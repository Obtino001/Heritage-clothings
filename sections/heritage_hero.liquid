{% liquid
  assign desktop_poster_image = section.settings.desktop_image | default: section.settings.desktop_video.preview_image
  assign mobile_poster_image = section.settings.mob | default: section.settings.mobile_video.preview_image
  assign desktop_poster_url = ''
  assign mobile_poster_url = ''

  if desktop_poster_image != blank
    assign desktop_poster_url = desktop_poster_image | image_url: width: 2800
  endif
  if mobile_poster_image != blank
    assign mobile_poster_url = mobile_poster_image | image_url: width: 1400
  endif
%}

{% if desktop_poster_url != blank %}
  <link rel="preload" as="image" href="{{ desktop_poster_url }}" media="(min-width: 750px)" fetchpriority="high">
{% endif %}
{% if mobile_poster_url != blank %}
  <link rel="preload" as="image" href="{{ mobile_poster_url }}" media="(max-width: 749px)" fetchpriority="high">
{% endif %}

<section class="heritage_hero_" data-content-position="{{ section.settings.content_position | default: 'left' }}">
  {% comment %}
    A video uploaded through the theme editor is not usable via video_tag
    the instant it's uploaded — Shopify needs to finish transcoding it into
    streaming renditions first, which can take a few minutes depending on
    file size. Calling video_tag before that finishes throws:
    "Setting 'x' value does not point to an applicable shopify-hosted video resource."
    `.duration` alone is NOT a reliable readiness signal — it's basic file
    metadata that's available almost immediately after upload, well before
    Shopify finishes generating the actual streaming renditions (`.sources`)
    that video_tag needs. So readiness is checked via `.sources.size > 0`
    instead. Until sources exist (or if no video is uploaded at all) the
    section safely falls back to the image.
  {% endcomment %}
  {% assign desktop_video_ready = false %}
  {% if section.settings.desktop_video != blank and section.settings.desktop_video.sources.size > 0 %}
    {% assign desktop_video_ready = true %}
  {% endif %}

  {% assign mobile_video_ready = false %}
  {% if section.settings.mobile_video != blank and section.settings.mobile_video.sources.size > 0 %}
    {% assign mobile_video_ready = true %}
  {% endif %}

  <div class="heritage_hero_image_wrap_">
    {% if desktop_video_ready %}
      {{
        section.settings.desktop_video
        | video_tag:
          image_size: '2800x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'heritage_hero_image_ heritage_hero_bg_video_',
          poster: desktop_poster_url
      }}
    {% elsif section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2800
        | image_tag: class: 'heritage_hero_image_', loading: 'eager', fetchpriority: 'high'
      }}
    {% endif %}

    {% if mobile_video_ready %}
      {{
        section.settings.mobile_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'mob heritage_hero_bg_video_',
          poster: mobile_poster_url
      }}
    {% elsif section.settings.mob != blank %}
      {{
        section.settings.mob
        | image_url: width: 1400
        | image_tag: class: 'mob', loading: 'eager', fetchpriority: 'high', alt: ''
      }}
    {% endif %}

    {% if section.settings.enable_overlay %}
      <div
        class="heritage_hero_overlay_"
        style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      ></div>
    {% endif %}
  </div>

  <div class="page-width">
    <div class="heritage_hero_content_">
      {% if section.settings.rating_text != blank %}
        <div class="heritage_hero_rating_">
          <span class="heritage_hero_stars_">
            <svg xmlns="http://www.w3.org/2000/svg" width="102" height="18" viewBox="0 0 102 18" fill="none">
