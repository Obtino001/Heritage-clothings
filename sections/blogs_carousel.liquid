<section class="blog_stories_carousel_" style="padding-top: {{ section.settings.section_padding_top }}px; padding-bottom: {{ section.settings.section_padding_bottom }}px;">
  <div class="page-width">
    <div class="blog_stories_carousel_header_">
      {% if section.settings.heading_tag == 'h3' %}
        <h3 class="blog_stories_carousel_heading_" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h3>
      {% else %}
        <h2 class="blog_stories_carousel_heading_" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.show_view_all %}
        <a href="{{ blogs[section.settings.blog].url }}" class="blog_stories_carousel_view_all_" style="color: {{ section.settings.view_all_color }};">{{ section.settings.view_all_text }}</a>
      {% endif %}
    </div>
  </div>

  <div class="blog_stories_carousel_slider_wrap_">
    <div class="page-width">
      <button class="blog_stories_carousel_prev_" aria-label="Previous slide">
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="16" viewBox="0 0 10 16" fill="none">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M0.366084 8.83875L7.43733 15.91L9.20483 14.1425L3.01733 7.955L9.20483 1.7675L7.43733 0L0.366084 7.07125C0.131745 7.30566 0.000101089 7.62354 0.000101089 7.955C0.000101089 8.28646 0.131745 8.60434 0.366084 8.83875Z" fill="black"/>
        </svg>
      </button>

      <div class="blog_stories_carousel_slider_ swiper"
        data-slides-desktop="{{ section.settings.slides_desktop }}"
        data-slides-tablet="{{ section.settings.slides_tablet }}">
        <div class="swiper-wrapper">
          {% assign image_inner_radius = section.settings.card_radius | minus: 2 %}
          {% if image_inner_radius < 0 %}{% assign image_inner_radius = 0 %}{% endif %}
          {% for article in blogs[section.settings.blog].articles limit: section.settings.posts_to_show %}
            <div class="blog_stories_carousel_card_ swiper-slide" style="background: {{ section.settings.card_bg_color }}; border-radius: {{ section.settings.card_radius }}px;">
              <a href="{{ article.url }}" class="blog_stories_carousel_image_wrap_">
                {% if article.image %}
                  {% capture image_style %}aspect-ratio: {{ section.settings.image_aspect_ratio }}; border-radius: {{ image_inner_radius }}px;{% endcapture %}
                  {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'blog_stories_carousel_image_', style: image_style }}
                {% else %}
                  <div class="blog_stories_carousel_image_ blog_stories_carousel_image_placeholder_" style="aspect-ratio: {{ section.settings.image_aspect_ratio }}; border-radius: {{ image_inner_radius }}px;"></div>
                {% endif %}
              </a>

              <div class="blog_stories_carousel_content_">
                <div class="top_header">
                  <div class="blog_stories_carousel_meta_">
                    {% if section.settings.show_tag %}
                      <span class="blog_stories_carousel_tag_" style="color: {{ section.settings.tag_color }};">{{ section.settings.tag_label }}</span>
                    {% endif %}
                    {% if section.settings.show_date %}
                      <span class="blog_stories_carousel_date_" style="color: {{ section.settings.date_color }};">{{ article.published_at | date: '%d/%m/%Y' }}</span>
                    {% endif %}
                  </div>

                  <h3 class="blog_stories_carousel_title_" style="color: {{ section.settings.title_color }};">{{ article.title }}</h3>

                  {% if section.settings.show_excerpt %}
                    <div class="blog_stories_carousel_excerpt_" style="color: {{ section.settings.excerpt_color }};">{{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}</div>
                  {% endif %}
                </div>

                {% if section.settings.show_read_more %}
                  <a href="{{ article.url }}" class="blog_stories_carousel_link_" style="color: {{ section.settings.read_more_color }};">{{ section.settings.read_more_text }}</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <button class="blog_stories_carousel_next_" aria-label="Next slide">
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="16" viewBox="0 0 10 16" fill="none">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M8.83875 8.83875L1.7675 15.91L0 14.1425L6.1875 7.955L0 1.7675L1.7675 0L8.83875 7.07125C9.07309 7.30566 9.20473 7.62354 9.20473 7.955C9.20473 8.28646 9.07309 8.60434 8.83875 8.83875Z" fill="black"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .blog_stories_carousel_ {
    position: relative;
  }

  .blog_stories_carousel_slider_wrap_ .page-width {
    display: flex;
    align-items: center;
    position: relative;
    gap: 0;
  }

  .blog_stories_carousel_slider_wrap_ {
    position: relative;
  }

  .blog_stories_carousel_header_ {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 30px;
  }

  a.blog_stories_carousel_view_all_ {
    text-decoration: underline;
    font-family: "Neue Montreal Med" !important;
    font-weight: 500;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0%;
  }

  .blog_stories_carousel_heading_ {
    margin: 0;
    font-family: Lora;
    font-weight: 500;
    font-size: 34px;
    line-height: 100%;
    letter-spacing: 0%;
    text-transform: capitalize;
  }

  .blog_stories_carousel_content_ {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: stretch;
  }

  span.blog_stories_carousel_tag_ {
    font-family: "Neue Montreal";
    font-weight: 500;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 2%;
  }

  .blog_stories_carousel_title_ {
    font-family: Lora;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: 2%;
    margin: 13px 0;
  }

  .blog_stories_carousel_excerpt_ {
    margin-bottom: 37px;
    font-family: "Neue Montreal" !important;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: 2%;
  }

  a.blog_stories_carousel_link_ {
    font-family: "Neue Montreal Med" !important;
    font-weight: 500;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 2%;
    text-decoration: underline;
  }

  .blog_stories_carousel_card_ {
    overflow: hidden;
    height: stretch;
    padding: 15px 15px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .blog_stories_carousel_image_ {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .blog_stories_carousel_image_placeholder_ {
    background: #e5ddd0;
  }

  .blog_stories_carousel_meta_ {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px 15px;
  }

  .blog_stories_carousel_prev_,
  .blog_stories_carousel_next_ {
    width: 25px;
    background: none;
    border: none;
    cursor: pointer;
    position: absolute;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog_stories_carousel_prev_ {
    left: -15px;
  }

  .blog_stories_carousel_next_ {
    right: -15px;
  }

  .blog_stories_carousel_prev_.swiper-button-disabled,
  .blog_stories_carousel_next_.swiper-button-disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  span.blog_stories_carousel_date_ {
    font-family: "Neue Montreal";
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0%;
  }

  @media (min-width: 1400px) {
    .blog_stories_carousel_prev_ {
      left: -15px;
    }

    .blog_stories_carousel_next_ {
      right: -15px;
    }
  }

  @media (max-width: 1024px) {
    .blog_stories_carousel_prev_,
    .blog_stories_carousel_next_ {
      display: none;
    }
  }

  @media (max-width: 500px) {
    .blog_stories_carousel_slider_wrap_ .page-width {
      padding-right: 0;
    }

    .blog_stories_carousel_heading_ {
      margin: 0;
      font-size: 24px;
    }
  }
</style>

<script>
  (function () {
    function setupSwiperInstance(sliderEl) {
      if (!sliderEl || sliderEl.classList.contains('swiper-initialized')) return;
      var wrap = sliderEl.closest('.blog_stories_carousel_slider_wrap_');
      if (!wrap) return;

      var slidesDesktop = parseFloat(sliderEl.dataset.slidesDesktop) || 3;
      var slidesTablet = parseFloat(sliderEl.dataset.slidesTablet) || 2;

      new Swiper(sliderEl, {
        slidesPerView: 1.15,
        spaceBetween: 15,
        navigation: {
          nextEl: wrap.querySelector('.blog_stories_carousel_next_'),
          prevEl: wrap.querySelector('.blog_stories_carousel_prev_'),
        },
        breakpoints: {
          768: { slidesPerView: slidesTablet },
          990: { slidesPerView: slidesDesktop },
        },
      });
    }

    function initAll() {
      document
        .querySelectorAll('.blog_stories_carousel_slider_:not(.swiper-initialized)')
        .forEach(setupSwiperInstance);
    }

    function bootWhenReady() {
      if (typeof Swiper === 'undefined') {
        setTimeout(bootWhenReady, 100);
        return;
      }
      initAll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootWhenReady);
    } else {
      bootWhenReady();
    }
  })();
</script>

{% schema %}
{
  "name": "Blog Stories Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories By Heritage" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ], "default": "h2" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 3, "max": 12, "step": 1, "default": 6, "label": "Posts to show" },

    {
      "type": "header",
      "content": "View all link"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All" },

    {
      "type": "header",
      "content": "Card content toggles"
    },
    { "type": "checkbox", "id": "show_tag", "label": "Show tag label", "default": true },
    { "type": "text", "id": "tag_label", "label": "Tag label", "default": "STYLE GUIDE" },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "range", "id": "excerpt_length", "min": 40, "max": 200, "step": 5, "default": 90, "label": "Excerpt length (characters)" },
    { "type": "checkbox", "id": "show_read_more", "label": "Show 'Read more' link", "default": true },
    { "type": "text", "id": "read_more_text", "label": "Read more text", "default": "Read More" },

    {
      "type": "header",
      "content": "Layout"
    },
    { "type": "range", "id": "slides_desktop", "min": 1, "max": 5, "step": 1, "default": 3, "label": "Slides visible - Desktop" },
    { "type": "range", "id": "slides_tablet", "min": 1, "max": 3, "step": 1, "default": 2, "label": "Slides visible - Tablet" },
    { "type": "select", "id": "image_aspect_ratio", "label": "Image aspect ratio", "options": [
        { "value": "1", "label": "Square (1:1)" },
        { "value": "1.4", "label": "Landscape (1.4:1)" },
        { "value": "1.78", "label": "Widescreen (16:9)" },
        { "value": "0.8", "label": "Portrait (4:5)" }
      ], "default": "1.4" },
    { "type": "range", "id": "card_radius", "min": 0, "max": 30, "step": 1, "default": 10, "label": "Card corner radius (px)" },
    { "type": "range", "id": "section_padding_top", "min": 0, "max": 160, "step": 4, "default": 80, "label": "Section top padding (px)" },
    { "type": "range", "id": "section_padding_bottom", "min": 0, "max": 160, "step": 4, "default": 80, "label": "Section bottom padding (px)" },

    {
      "type": "header",
      "content": "Colors"
    },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "color", "id": "view_all_color", "label": "View all link color", "default": "#000000" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#F5EFE6" },
    { "type": "color", "id": "tag_color", "label": "Tag color", "default": "#B8522E" },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#000000" },
    { "type": "color", "id": "excerpt_color", "label": "Excerpt color", "default": "#000000" },
    { "type": "color", "id": "date_color", "label": "Date color", "default": "#9D9D9D" },
    { "type": "color", "id": "read_more_color", "label": "Read more link color", "default": "#000000" }
  ],
  "presets": [
    {
      "name": "Blog Stories Carousel",
      "category": "Blog"
    }
  ]
}
{% endschema %}
