{% comment %}
  Section: Complete The Look - Accessories Collection Grid
  Features: 4-collection grid, customizable via schema settings
{% endcomment %}

<section class="accessories-section" id="accessories-{{ section.id }}">
  <div class="page-width">

    <div class="accessories-header">
      <h2 class="accessories-title">{{ section.settings.heading }}</h2>
    </div>

    <div class="collection-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        {% if collection != blank %}
          <div class="collection-card" {{ block.shopify_attributes }}>
            <a href="{{ collection.url }}" class="collection-card__link" aria-label="Shop {{ collection.title }}">

              <div class="collection-card__image-wrap">
                {% if block.settings.custom_image != blank %}
                  <img
                    src="{{ block.settings.custom_image | img_url: '600x800', crop: 'center' }}"
                    alt="{{ block.settings.custom_image.alt | default: collection.title | escape }}"
                    width="600"
                    height="800"
                    loading="lazy"
                    class="collection-card__image"
                  >
                {% elsif collection.featured_image != blank %}
                  <img
                    src="{{ collection.featured_image | img_url: '600x800', crop: 'center' }}"
                    alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                    width="600"
                    height="800"
                    loading="lazy"
                    class="collection-card__image"
                  >
                {% else %}
                  <div class="collection-card__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              </div>

              <div class="collection-card__overlay">
                <div class="collection-card__info">
                  <h3 class="collection-card__title">
                    {% if block.settings.custom_title != blank %}
                      {{ block.settings.custom_title }}
                    {% else %}
                      {{ collection.title }}
                    {% endif %}
                  </h3>
                  <div class="border_divider_line"></div>
                  <span class="collection-card__cta">
                    {{ section.settings.button_label }}
                    
                  </span>
                </div>
              </div>

            </a>
          </div>
        {% else %}
          {% comment %} Placeholder when no collection is selected {% endcomment %}
          <div class="collection-card collection-card--placeholder" {{ block.shopify_attributes }}>
            <div class="collection-card__image-wrap">
              {% if block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | img_url: '600x800', crop: 'center' }}"
                  alt="{{ block.settings.custom_image.alt | escape }}"
                  width="600"
                  height="800"
                  loading="lazy"
                  class="collection-card__image"
                >
              {% else %}
                <div class="collection-card__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
            <div class="collection-card__overlay">
              <div class="collection-card__info">
                <h3 class="collection-card__title">
                  {{ block.settings.custom_title | default: 'Collection' }}
                </h3>
                <span class="collection-card__cta">
                  {{ section.settings.button_label }}
                </span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
 .accessories-section {
    padding: 87px 0px 98px;
}
 
  .accessories-section .accessories-header {
    margin-bottom: 35px;
  }

 .accessories-section .accessories-title {
    font-family: Lora;
    font-weight: 500;
    font-size: 34px;
    line-height: 100%;
    letter-spacing: 0%;
    text-transform: capitalize;
    color: #000000;
        text-align: center;
}

  /* ── Grid ─────────────────────────────────────── */
   .accessories-section .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }

 
  /* ── Card ─────────────────────────────────────── */
   .accessories-section .collection-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 3 / 4;

  }

   .accessories-section .collection-card__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* ── Image ────────────────────────────────────── */
   .accessories-section .collection-card__image-wrap {
    position: absolute;
    inset: 0;
  }

  .accessories-section .collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .accessories-section .collection-card__link:hover .collection-card__image {
    transform: scale(1.04);
  }

  .accessories-section .collection-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e3db;
  }

   .accessories-section .collection-card__placeholder .placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  /* ── Overlay & text ───────────────────────────── */
 .accessories-section .collection-card__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: flex-end;
    padding: 22px 21px;
}
   .accessories-section .collection-card__info {
    display: flex;
    flex-direction: column;
    
  }
.accessories-section .border_divider_line {
    height: 1.5px;
    width: 47px;
    background: #B8522E;
        margin: 2px 0 0 0;
}
 .accessories-section .collection-card__title {
    font-family: Lora;
    font-weight: 500;
    font-style: Medium;
    font-size: 26px;
    leading-trim: NONE;
    line-height: 100%;
    letter-spacing: 0%;
    text-transform: capitalize;
    margin: 0;
    color: #fff;
}

  .accessories-section .collection-card__cta {
    font-family: Neue Montreal !important;
    font-weight: 500;
    font-style: Medium;
    font-size: 14px;
    leading-trim: NONE;
    line-height: 111.00000000000001%;
    letter-spacing: 0%;
    text-decoration: underline;
    text-decoration-style: solid;
    text-decoration-offset: 0%;
    text-decoration-thickness: 0%;
    text-decoration-skip-ink: auto;
    color: #fff;
    margin: 21px 0 0;
}

  .accessories-section  .collection-card__link:hover .collection-card__cta {
    border-color: #ffffff;
  }

   @media (max-width: 1280px) {
  .accessories-section {
    padding: 80px 0;
}
   }
   @media (max-width: 1024px) {
   .accessories-section .collection-card__cta {
    margin: 10px 0 0;
}
   }
   @media (max-width: 900px) {
    .accessories-section .collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
     .accessories-section .collection-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .accessories-section .accessories-title {
    font-size: 24px;
}
.accessories-section .collection-card__title {
    font-size: 22px;
}

.accessories-section .collection-card__cta {
    font-size: 12px;
}
    .accessories-section .collection-grid {
        gap: 6px;
    }
    .accessories-section .collection-card__overlay {
    padding: 15px 12px;
}
.accessories-section .border_divider_line {
    width: 37px;
}
    .accessories-section {
        padding: 80px 0 70px;
    }
    .accessories-section .accessories-header {
    margin-bottom: 18px;
}
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Heritage Collections",
  "tag": "section",
  "class": "accessories-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Complete The Look With Our Accessories"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Shop Button Label",
      "default": "Shop Now"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (overrides collection title)",
          "info": "Leave blank to use the collection's own title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (overrides collection image)",
          "info": "Leave blank to use the collection's featured image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heritage Collections",
      "blocks": [
        {
          "type": "collection_item",
          "settings": {
            "custom_title": "Headwraps"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "custom_title": "Earrings"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "custom_title": "Socks"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "custom_title": "Umbrellas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
