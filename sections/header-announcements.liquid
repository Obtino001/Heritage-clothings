

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
  ></script>
{% endif %}

{% style %}
  .announcement-bar__slides {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .announcement-bar__slides > * {
    grid-area: 1 / 1;
  }

  .announcement-bar__slide[aria-hidden='true'],
  .announcement-bar__slide[hidden] {
    display: none !important;
  }

  .announcement-bar__slides > *:has(.announcement-bar__slide[aria-hidden='true']),
  .announcement-bar__slides > *:has(.announcement-bar__slide[hidden]) {
    display: none !important;
  }
{% endstyle %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- liquid
  assign countdown_end = section.settings.end_datetime | strip
  if countdown_end == blank
    assign countdown_end = '2026-09-15 23:59'
  endif
  assign countdown_heading = section.settings.countdown_heading | default: 'Sale ends in'
  assign show_countdown = false
  if section.settings.countdown_visibility != 'hidden' and countdown_end != blank
    assign show_countdown = true
  endif
-%}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}{% if show_countdown %} announcement-bar--has-countdown{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <div class="announcement-bar__row">
    {%- if show_countdown -%}
      {% render 'heritage-countdown',
        style: 'bar',
        heading: countdown_heading,
        end_datetime: countdown_end,
        hide_when_ended: section.settings.hide_when_ended,
        ended_message: section.settings.ended_message
      %}
    {%- endif -%}

    <announcement-bar-component
      class="announcement-bar__slider"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="announcement-bar__slides">
        {% content_for 'blocks' %}
      </div>
    </announcement-bar-component>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 20px;
    width: 100%;
  }

  .announcement-bar--has-countdown .announcement-bar__slider {
    flex: 1 1 220px;
    min-width: 0;
  }

  .announcement-bar--has-countdown .announcement-bar__slides {
    max-width: 420px;
    width: auto;
    flex: 1 1 auto;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar--has-countdown .announcement-bar__row {
      flex-direction: column;
      gap: 6px;
    }

    .announcement-bar--has-countdown .announcement-bar__slider,
    .announcement-bar--has-countdown .announcement-bar__slides {
      width: 100%;
      max-width: 100%;
    }
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
    position: relative;
    isolation: isolate;
  }

  .announcement-bar__slides > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .announcement-bar__slide {
    width: 100%;
    max-width: 100%;
    overflow: visible;
    content-visibility: visible;
    view-timeline-name: none;
    contain-intrinsic-size: none;
  }

  .announcement-bar .announcement-bar__slide[aria-hidden='true'],
  .announcement-bar .announcement-bar__slide[hidden] {
    display: none !important;
  }

  .announcement-bar__slides > *:has(.announcement-bar__slide[aria-hidden='true']),
  .announcement-bar__slides > *:has(.announcement-bar__slide[hidden]) {
    display: none !important;
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:names.sale_countdown"
    },
    {
      "type": "select",
      "id": "countdown_visibility",
      "label": "t:settings.countdown_visibility",
      "options": [
        {
          "value": "show",
          "label": "t:settings.show"
        },
        {
          "value": "hidden",
          "label": "t:options.hidden"
        }
      ],
      "default": "show"
    },
    {
      "type": "text",
      "id": "countdown_heading",
      "label": "t:settings.countdown_heading",
      "default": "Sale ends in"
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "t:settings.end_datetime",
      "default": "2026-09-15 23:59",
      "info": "t:info.end_datetime"
    },
    {
      "type": "checkbox",
      "id": "hide_when_ended",
      "label": "t:settings.hide_when_ended",
      "default": true
    },
    {
      "type": "text",
      "id": "ended_message",
      "label": "t:settings.ended_message",
      "default": "This sale has ended"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
