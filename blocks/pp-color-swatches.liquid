{%- liquid
  assign block_settings = block.settings
  assign product = closest.product | default: product
  assign current_variant = product.selected_or_first_available_variant

  assign color_map = 'dark green:#2e7d32,light blue:#87ceeb,sky blue:#87ceeb,dark brown:#5d4037,purple multi:#9c27b0,black:#111111,white:#ffffff,red:#e53935,blue:#2196f3,green:#4caf50,yellow:#ffeb3b,orange:#ff9800,pink:#e91e63,purple:#9c27b0,magenta:#e040fb,brown:#795548,beige:#f5f5dc,grey:#9e9e9e,gray:#9e9e9e,navy:#1a237e,teal:#009688,cream:#fffdd0,gold:#d4af37,silver:#c0c0c0,burgundy:#800020,maroon:#800000,coral:#ff7f50,mint:#98ff98,olive:#808000,khaki:#f0e68c,ivory:#fffff0,tan:#d2b48c,charcoal:#36454f,wine:#722f37,bronze:#cd7f32,copper:#b87333,lilac:#c8a2c8,lavender:#e6e6fa,peach:#ffcba4,rose:#ff007f,nude:#e3bc9a'
  assign color_map_pairs = color_map | split: ','

  assign option_name_clean = block_settings.option_name | strip
  if option_name_clean != blank
    assign option_name_clean = option_name_clean | remove: ':' | strip
  endif

  assign color_option = nil
  if option_name_clean != blank
    assign option_name_down = option_name_clean | downcase
    for option in product.options_with_values
      assign opt_down = option.name | downcase | strip
      if opt_down == option_name_down
        assign color_option = option
        break
      endif
    endfor
  endif

  if color_option == nil
    for option in product.options_with_values
      assign option_down = option.name | downcase | strip
      if option_down == 'color' or option_down == 'colour' or option_down == 'colors' or option_down == 'colours'
        assign color_option = option
        break
      endif
    endfor
  endif

  if color_option == nil
    assign size_option = nil
    for option in product.options_with_values
      assign opt_name_down = option.name | downcase | strip
      if opt_name_down == 'size'
        assign size_option = option
      endif
    endfor
    for option in product.options_with_values
      assign skip_size_option = false
      if size_option and option.position == size_option.position
        assign skip_size_option = true
      endif
      unless skip_size_option
        assign option_has_swatches = false
        for value in option.values
          if value.swatch.color != blank or value.swatch.image != blank
            assign option_has_swatches = true
            break
          endif
        endfor
        assign option_down = option.name | downcase | strip
        if option_has_swatches or option_down == 'color' or option_down == 'colour'
          assign color_option = option
          break
        endif
      endunless
    endfor
  endif

  assign mf_colors = nil
  if product.metafields.shopify['color-pattern'].value != blank
    assign mf_colors = product.metafields.shopify['color-pattern'].value
  elsif product.metafields.shopify.color.value != blank
    assign mf_colors = product.metafields.shopify.color.value
  elsif product.metafields.custom.colors.value != blank
    assign mf_colors = product.metafields.custom.colors.value
  endif

  assign sibling_collection = product.metafields.stiletto.siblings_collection.value
  assign sibling_option_name = product.metafields.stiletto.sibling_option_name.value | strip
  assign linked_color_products = product.metafields.custom.products_color.value

  assign color_mode = 'none'
  if linked_color_products != blank
    assign color_mode = 'linked'
  elsif sibling_collection != blank and sibling_option_name != blank
    assign color_mode = 'siblings'
  elsif color_option != nil
    assign color_mode = 'option'
  elsif mf_colors != blank
    assign color_mode = 'metafield'
  endif

  assign label_name = block_settings.label_name | default: 'Colour'
  assign selected_color_value = ''

  if color_mode == 'linked'
    assign selected_color_value = product.metafields.custom.color_name.value | default: product.metafields.custom.color_name | strip
    if selected_color_value == blank
      assign selected_color_value = product.title
    endif
  elsif color_mode == 'siblings'
    assign selected_color_value = sibling_option_name
  elsif color_mode == 'option'
    assign label_name = color_option.name
    case color_option.position
      when 1
        assign selected_color_value = current_variant.option1
      when 2
        assign selected_color_value = current_variant.option2
      when 3
        assign selected_color_value = current_variant.option3
    endcase
  elsif color_mode == 'metafield'
    assign featured_alt = product.featured_media.alt | default: '' | downcase | strip
    for item in mf_colors
      assign item_label = item.label | default: item
      assign item_down = item_label | downcase | strip
      if featured_alt == item_down
        assign selected_color_value = item_label
        break
      endif
    endfor
    if selected_color_value == blank
      assign first_item = mf_colors | first
      assign selected_color_value = first_item.label | default: first_item
    endif
  endif
-%}

{%- if color_mode != 'none' -%}
  <div
    class="pp-color-swatches"
    id="pp-color-swatches-{{ block.id }}"
    data-color-mode="{{ color_mode }}"
    data-current-handle="{{ product.handle }}"
    {% if color_mode == 'option' %}data-option-position="{{ color_option.position }}"{% endif %}
    style="
      --pp-cs-thumb-width: {{ block_settings.thumbnail_width }}px;
      --pp-cs-thumb-radius: {{ block_settings.thumbnail_radius }}px;
      --pp-cs-border-width: {{ block_settings.selected_border_width }}px;
      --pp-cs-gap: {{ block_settings.thumbnail_gap }}px;
    "
    {{ block.shopify_attributes }}
  >
    <p class="pp-color-swatches__label">
      <span class="pp-color-swatches__label-name">{{ label_name }}:</span>
      <span class="pp-color-swatches__value" data-color-label>{{ selected_color_value }}</span>
    </p>

    <div class="pp-color-swatches__list" role="list" aria-label="{{ label_name }} options">
      {%- if color_mode == 'linked' -%}
        {%- liquid
          assign current_color_label = product.metafields.custom.color_name.value | default: product.metafields.custom.color_name | strip | default: product.title
          assign current_color_image = current_variant.featured_media.preview_image | default: current_variant.image | default: product.featured_media.preview_image | default: product.featured_image
          assign current_color_url = current_variant.url | default: product.url
        -%}
        <a
          href="{{ current_color_url }}"
          class="pp-color-swatches__item is-selected{% unless product.available %} is-unavailable{% endunless %}"
          role="listitem"
          title="{{ current_color_label | escape }}"
          aria-current="page"
          aria-label="{{ current_color_label | escape }}{% unless product.available %} (sold out){% endunless %}"
        >
          {%- if current_color_image -%}
            {{
              current_color_image
              | image_url: width: 240
              | image_tag:
                widths: '120, 180, 240',
                sizes: '(max-width: 749px) 72px, 96px',
                alt: current_color_label,
                class: 'pp-color-swatches__img',
                loading: 'eager'
            }}
          {%- else -%}
            <span class="pp-color-swatches__fallback">{{ current_color_label | slice: 0, 1 }}</span>
          {%- endif -%}
        </a>
        {%- for linked_product in linked_color_products -%}
          {%- liquid
            assign is_current_linked = false
            if linked_product.id == product.id or linked_product.handle == product.handle
              assign is_current_linked = true
            endif
            assign linked_label = linked_product.metafields.custom.color_name.value | default: linked_product.metafields.custom.color_name | strip
            if linked_label == blank
              assign linked_label = linked_product.title
            endif
            assign linked_variant = linked_product.selected_or_first_available_variant
            assign linked_image = linked_variant.featured_media.preview_image | default: linked_variant.image | default: linked_product.featured_media.preview_image | default: linked_product.featured_image
            assign linked_url = linked_variant.url | default: linked_product.url
            assign show_linked = true
            if is_current_linked
              assign show_linked = false
            endif
            if block_settings.hide_unavailable and linked_product.available == false
              assign show_linked = false
            endif
          -%}
          {%- if show_linked and linked_url != blank -%}
            <a
              href="{{ linked_url }}"
              class="pp-color-swatches__item{% unless linked_product.available %} is-unavailable{% endunless %}"
              role="listitem"
              title="{{ linked_label | escape }}{% unless linked_product.available %} (sold out){% endunless %}"
              aria-label="{{ linked_label | escape }}{% unless linked_product.available %} (sold out){% endunless %}"
            >
              {%- if linked_image -%}
                {{
                  linked_image
                  | image_url: width: 240
                  | image_tag:
                    widths: '120, 180, 240',
                    sizes: '(max-width: 749px) 72px, 96px',
                    alt: linked_label,
                    class: 'pp-color-swatches__img',
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="pp-color-swatches__fallback">{{ linked_label | slice: 0, 1 }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif color_mode == 'siblings' -%}
        {%- for sibling_product in sibling_collection.products -%}
          {%- liquid
            assign sibling_label = sibling_product.metafields.stiletto.sibling_option_name.value | strip
            assign sibling_image = sibling_product.featured_media.preview_image
            assign sibling_selected = false
            if sibling_product.id == product.id
              assign sibling_selected = true
            endif

            assign show_sibling = true
            if sibling_label == blank
              assign show_sibling = false
            elsif block_settings.hide_unavailable and sibling_product.available == false
              assign show_sibling = false
            endif
          -%}

          {%- if show_sibling -%}
            <button
              type="button"
              class="pp-color-swatches__item{% if sibling_selected %} is-selected{% endif %}{% unless sibling_product.available %} is-unavailable{% endunless %}"
              role="listitem"
              title="{{ sibling_label | escape }}{% unless sibling_product.available %} (sold out){% endunless %}"
              aria-label="{{ sibling_label | escape }}{% unless sibling_product.available %} (sold out){% endunless %}"
              aria-pressed="{% if sibling_selected %}true{% else %}false{% endif %}"
              data-color-swatch
              data-option-value="{{ sibling_label | escape }}"
              data-product-url="{{ sibling_product.url }}"
              data-color-available="{% if sibling_product.available %}true{% else %}false{% endif %}"
              {% if sibling_image %}
                data-image-src="{{ sibling_image | image_url: width: 1200 }}"
                data-image-srcset="{{ sibling_image | image_url: width: 600 }} 600w, {{ sibling_image | image_url: width: 1200 }} 1200w"
              {% endif %}
            >
              {%- if sibling_image -%}
                {{
                  sibling_image
                  | image_url: width: 240
                  | image_tag:
                    widths: '120, 180, 240',
                    sizes: '(max-width: 749px) 72px, 96px',
                    alt: sibling_label,
                    class: 'pp-color-swatches__img',
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="pp-color-swatches__fallback">{{ sibling_label | slice: 0, 1 }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif color_mode == 'option' -%}
        {%- for value in color_option.values -%}
          {%- liquid
            assign swatch_variant = nil
            assign swatch_image = nil
            assign value_available = false

            if value.swatch.image
              assign swatch_image = value.swatch.image
            endif

            for variant in product.variants
              assign color_matches = false
              if color_option.position == 1 and variant.option1 == value
                assign color_matches = true
              elsif color_option.position == 2 and variant.option2 == value
                assign color_matches = true
              elsif color_option.position == 3 and variant.option3 == value
                assign color_matches = true
              endif

              if color_matches
                if swatch_variant == nil
                  assign swatch_variant = variant
                endif
                if variant.available
                  assign value_available = true
                endif
                if variant.featured_image
                  assign swatch_image = variant.featured_image
                  assign swatch_variant = variant
                endif
              endif
            endfor

            assign value_down = value | downcase | strip
            if swatch_image == nil
              for media in product.media
                assign media_alt_down = media.alt | default: '' | downcase | strip
                if media_alt_down == value_down
                  assign swatch_image = media.preview_image
                  break
                endif
              endfor
            endif

            assign is_selected = false
            if value == selected_color_value
              assign is_selected = true
            endif

            assign show_swatch = true
            if block_settings.hide_unavailable and value_available == false
              assign show_swatch = false
            endif
          -%}

          {%- if show_swatch -%}
            <button
              type="button"
              class="pp-color-swatches__item{% if is_selected %} is-selected{% endif %}{% unless value_available %} is-unavailable{% endunless %}"
              role="listitem"
              title="{{ value }}{% unless value_available %} (sold out){% endunless %}"
              aria-label="{{ value }}{% unless value_available %} (sold out){% endunless %}"
              aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
              data-color-swatch
              data-option-value="{{ value | escape }}"
              data-variant-id="{{ swatch_variant.id }}"
              {% render 'color-swatch-attrs', product: product, color_label: value, option_value: value, selected_color_value: selected_color_value %}
              {% if swatch_image %}
                data-image-src="{{ swatch_image | image_url: width: 1200 }}"
                data-image-srcset="{{ swatch_image | image_url: width: 600 }} 600w, {{ swatch_image | image_url: width: 1200 }} 1200w"
              {% endif %}
            >
              {%- if swatch_image -%}
                {{
                  swatch_image
                  | image_url: width: 240
                  | image_tag:
                    widths: '120, 180, 240',
                    sizes: '(max-width: 749px) 72px, 96px',
                    alt: value,
                    class: 'pp-color-swatches__img',
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="pp-color-swatches__fallback">{{ value | slice: 0, 1 }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}

      {%- else -%}
        {%- for item in mf_colors -%}
          {%- liquid
            assign color_label = item.label | default: item
            assign color_hex = ''
            assign swatch_image = nil

            if item.color != blank
              assign color_hex = item.color
            endif
            if item.image != blank
              assign swatch_image = item.image
            elsif item.pattern != blank
              assign swatch_image = item.pattern
            elsif item.swatch != blank and item.swatch.image != blank
              assign swatch_image = item.swatch.image
            endif

            assign color_down = color_label | downcase | strip

            if swatch_image == nil
              for media in product.media
                assign media_alt_down = media.alt | default: '' | downcase | strip
                if media_alt_down == color_down
                  assign swatch_image = media.preview_image
                  break
                endif
              endfor
            endif

            if swatch_image == nil
              for variant in product.variants
                if variant.featured_image
                  assign v1 = variant.option1 | downcase
                  assign v2 = variant.option2 | downcase
                  assign v3 = variant.option3 | downcase
                  if v1 == color_down or v2 == color_down or v3 == color_down
                    assign swatch_image = variant.featured_image
                    break
                  endif
                endif
              endfor
            endif

            if color_hex == ''
              for pair in color_map_pairs
                assign pair_parts = pair | split: ':'
                if color_down == pair_parts[0]
                  assign color_hex = pair_parts[1]
                  break
                endif
              endfor
            endif

            assign is_selected = false
            if color_label == selected_color_value
              assign is_selected = true
            endif

            assign is_multi = false
            if color_down contains 'multi' or color_down contains 'geometric' or color_down contains 'print' or color_down contains 'pattern' or color_down contains 'floral' or color_down contains 'stripe' or color_down contains 'abstract'
              assign is_multi = true
            endif
          -%}

          <button
            type="button"
            class="pp-color-swatches__item{% if is_selected %} is-selected{% endif %}{% if is_multi %} pp-color-swatches__item--multi{% elsif color_hex != '' and swatch_image == nil %} pp-color-swatches__item--hex{% endif %}"
            role="listitem"
            title="{{ color_label }}"
            aria-label="{{ color_label }}"
            aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
            data-color-swatch
            data-option-value="{{ color_label | escape }}"
            {% render 'color-swatch-attrs', product: product, color_label: color_label, metafield_item: item, selected_color_value: selected_color_value %}
            {% if swatch_image %}
              data-image-src="{{ swatch_image | image_url: width: 1200 }}"
              data-image-srcset="{{ swatch_image | image_url: width: 600 }} 600w, {{ swatch_image | image_url: width: 1200 }} 1200w"
            {% endif %}
            {% if color_hex != '' and is_multi == false and swatch_image == nil %}
              style="background-color: {{ color_hex }};"
            {% endif %}
          >
            {%- if swatch_image -%}
              {{
                swatch_image
                | image_url: width: 240
                | image_tag:
                  widths: '120, 180, 240',
                  sizes: '(max-width: 749px) 72px, 96px',
                  alt: color_label,
                  class: 'pp-color-swatches__img',
                  loading: 'lazy'
              }}
            {%- elsif color_hex == '' -%}
              <span class="pp-color-swatches__fallback">{{ color_label | slice: 0, 1 }}</span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-pp-media-map>
    [
      {%- for media in product.media -%}
        {
          "src": "{{ media | image_url: width: 1200 }}",
          "srcset": "{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w",
          "alt": {{ media.alt | default: '' | json }},
          "id": {{ media.id }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <script>
    (function () {
      var root = document.getElementById('pp-color-swatches-{{ block.id }}');
      if (!root) return;

      var colorMode = root.dataset.colorMode;
      if (colorMode === 'linked') {
        var list = root.querySelector('.pp-color-swatches__list');
        if (!list) return;

        var currentHandle = (root.dataset.currentHandle || '').toLowerCase();
        var pagePath = (window.location.pathname || '').replace(/\/$/, '').toLowerCase();
        var items = Array.prototype.slice.call(list.querySelectorAll('.pp-color-swatches__item'));

        function isCurrentSwatch(item) {
          var href = (item.getAttribute('href') || '').split('?')[0].replace(/\/$/, '').toLowerCase();
          if (item.classList.contains('is-selected')) return true;
          if (currentHandle && href.indexOf('/products/' + currentHandle) !== -1) return true;
          return href === pagePath;
        }

        var current = null;
        for (var i = 0; i < items.length; i++) {
          if (isCurrentSwatch(items[i])) {
            current = items[i];
            break;
          }
        }

        items.forEach(function (item) {
          var active = item === current;
          item.classList.toggle('is-selected', active);
          if (active) item.setAttribute('aria-current', 'page');
          else item.removeAttribute('aria-current');
        });

        if (current && list.firstElementChild !== current) {
          list.insertBefore(current, list.firstElementChild);
        }
        return;
      }
      var optionPosition = parseInt(root.dataset.optionPosition, 10);
      var swatches = root.querySelectorAll('[data-color-swatch]');
      var labelEl = root.querySelector('[data-color-label]');
      var variants = {{ product.variants | json }};
      var mediaMap = [];
      var mediaEl = root.querySelector('[data-pp-media-map]');
      if (mediaEl) {
        try { mediaMap = JSON.parse(mediaEl.textContent); } catch (e) {}
      }

      function getScope() {
        return root.closest('product-information')
          || root.closest('[id^="shopify-section-"]')
          || root.closest('.shopify-section')
          || root.closest('.product')
          || document;
      }

      function normValue(v) {
        return (v || '').toString().toLowerCase().replace(/&/g, 'and').replace(/\s+/g, ' ').trim();
      }

      function isColorOptionName(name) {
        var n = normValue(name);
        return n === 'color' || n === 'colour' || n === 'colors' || n === 'colours';
      }

      function sameProductPath(url) {
        if (!url) return true;
        try {
          var dest = new URL(url, window.location.origin);
          return dest.pathname.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, '');
        } catch (e) {
          return url === window.location.pathname;
        }
      }

      function markUnavailableSwatches() {
        swatches.forEach(function (swatch) {
          if (swatch.dataset.colorAvailable === 'false') {
            swatch.classList.add('is-unavailable');
            var label = swatch.getAttribute('aria-label') || swatch.title || '';
            if (label && label.indexOf('sold out') === -1) {
              swatch.setAttribute('aria-label', label + ' (sold out)');
              swatch.setAttribute('title', (swatch.title || label) + ' (sold out)');
            }
          }
        });
      }

      function getSelectedOptions() {
        var scope = getScope();
        var sel = {};
        var picker = scope.querySelector('variant-picker');
        if (!picker) return sel;

        picker.querySelectorAll('select').forEach(function (select, index) {
          if (select.value) sel[index + 1] = select.value;
        });

        picker.querySelectorAll('fieldset').forEach(function (fieldset) {
          var checked = fieldset.querySelector('input[type="radio"]:checked');
          var pos = parseInt(fieldset.dataset.fieldsetIndex, 10);
          if (checked && !Number.isNaN(pos)) sel[pos + 1] = checked.value;
          else if (checked && checked.dataset.inputId) {
            var parts = checked.dataset.inputId.split('-');
            if (parts[0]) sel[parseInt(parts[0], 10)] = checked.value;
          }
        });

        return sel;
      }

      function findVariant(sel) {
        return variants.find(function (v) {
          return (!sel[1] || v.option1 === sel[1])
            && (!sel[2] || v.option2 === sel[2])
            && (!sel[3] || v.option3 === sel[3]);
        }) || null;
      }

      function setFormVariantId(variantId) {
        if (!variantId) return;
        getScope().querySelectorAll(
          'product-form-component input[name="id"], form[action*="/cart/add"] input[name="id"]'
        ).forEach(function (input) {
          input.value = String(variantId);
        });
      }

      function syncNativePicker(value) {
        if (colorMode !== 'option') return;
        var picker = getScope().querySelector('variant-picker');
        if (!picker) return;

        var matched = null;
        picker.querySelectorAll('input[type="radio"]').forEach(function (radio) {
          if (radio.value !== value) return;
          if (isColorOptionName(radio.dataset.optionName)) matched = radio;
          else if (!matched) matched = radio;
        });

        if (matched && !matched.checked) {
          matched.checked = true;
          matched.dispatchEvent(new Event('change', { bubbles: true }));
        }

        picker.querySelectorAll('select').forEach(function (select) {
          for (var i = 0; i < select.options.length; i++) {
            if (select.options[i].value === value && select.selectedIndex !== i) {
              select.selectedIndex = i;
              select.dispatchEvent(new Event('change', { bubbles: true }));
              break;
            }
          }
        });
      }

      function findMediaByColor(colorValue) {
        var needle = normValue(colorValue);
        return mediaMap.find(function (m) {
          return m.alt && normValue(m.alt) === needle;
        });
      }

      function updateGallery(variant, swatch, colorValue) {
        var scope = getScope();
        var mediaId = variant && variant.featured_media && variant.featured_media.id;

        if (mediaId) {
          var gallery = scope.querySelector('media-gallery') || document.querySelector('media-gallery');
          if (gallery && typeof gallery.setActiveMedia === 'function') {
            gallery.setActiveMedia(mediaId, true);
            return;
          }
        }

        var src = swatch && swatch.dataset.imageSrc;
        var srcset = swatch && swatch.dataset.imageSrcset;

        if (!src && colorValue) {
          var fromMap = findMediaByColor(colorValue);
          if (fromMap) {
            src = fromMap.src;
            srcset = fromMap.srcset;
            mediaId = fromMap.id;
          }
        }

        if (mediaId) {
          var galleryEl = scope.querySelector('media-gallery') || document.querySelector('media-gallery');
          if (galleryEl && typeof galleryEl.setActiveMedia === 'function') {
            galleryEl.setActiveMedia(mediaId, true);
            return;
          }
        }

        if (!src) return;

        scope.querySelectorAll(
          '.product-media-container img, .product__media img, .pp-main-slide.is-active img, slideshow-slide[aria-hidden="false"] img, [data-main-image] img'
        ).forEach(function (img) {
          img.src = src;
          if (srcset) img.srcset = srcset;
        });
      }

      function setActiveSwatch(swatch, fromUser) {
        if (!swatch) return;

        var productUrl = swatch.dataset.productUrl;
        if (fromUser !== false && productUrl && !sameProductPath(productUrl)) {
          window.location.href = productUrl;
          return;
        }

        swatches.forEach(function (item) {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        swatch.classList.add('is-selected');
        swatch.setAttribute('aria-pressed', 'true');

        var value = swatch.dataset.optionValue;
        if (labelEl) labelEl.textContent = value;

        if (colorMode === 'option') {
          if (fromUser !== false) syncNativePicker(value);
          var sel = getSelectedOptions();
          if (optionPosition) sel[optionPosition] = value;
          var match = findVariant(sel);
          if (match) {
            setFormVariantId(match.id);
            updateGallery(match, swatch, value);
          } else if (swatch.dataset.variantId) {
            setFormVariantId(swatch.dataset.variantId);
            updateGallery(null, swatch, value);
          }
        } else if (swatch.dataset.variantId) {
          setFormVariantId(swatch.dataset.variantId);
          updateGallery(null, swatch, value);
        } else {
          updateGallery(null, swatch, value);
        }
      }

      markUnavailableSwatches();

      swatches.forEach(function (swatch) {
        swatch.addEventListener('click', function () {
          setActiveSwatch(swatch, true);
        });
      });

      if (colorMode === 'option') {
        function onExternalVariantChange(event) {
          var detail = event.detail || {};
          var variant = detail.variant || (detail.data && detail.data.variant);
          if (!variant) return;
          var value = variant['option' + optionPosition];
          if (!value) return;
          swatches.forEach(function (swatch) {
            if (swatch.dataset.optionValue === value) setActiveSwatch(swatch, false);
          });
        }
        document.addEventListener('variant:change', onExternalVariantChange);
        document.addEventListener('variant:update', onExternalVariantChange);
      }
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="pp-color-swatches pp-color-swatches--empty" {{ block.shopify_attributes }}>
    <p class="pp-color-swatches__empty-title">Colour swatches — no colour data found</p>
    <p class="pp-color-swatches__empty-text">
      This product only has: <strong>{{ product.options | join: ', ' }}</strong>.
      Add colours via metafield <code>custom.products_color</code> (list of products)
      and <code>custom.color_name</code> on each product.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .pp-color-swatches {
    width: 100%;
    margin: 20px 0 8px;
  }

  .pp-color-swatches--empty {
    padding: 14px 16px;
    border: 1px dashed #cccccc;
    border-radius: 8px;
    background: #fafafa;
  }

  .pp-color-swatches__empty-title {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 700;
    color: #111111;
  }

  .pp-color-swatches__empty-text {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: #555555;
  }

  .pp-color-swatches__empty-text code {
    font-size: 11px;
    background: #eeeeee;
    padding: 1px 4px;
    border-radius: 3px;
  }

  .pp-color-swatches__label {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.4;
    color: #111111;
  }

  .pp-color-swatches__label-name {
    font-weight: 700;
  }

  .pp-color-swatches__value {
    font-weight: 400;
  }

  .pp-color-swatches__list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--pp-cs-gap, 12px);
  }

  .pp-color-swatches__item {
    position: relative;
    display: block;
    width: var(--pp-cs-thumb-width, 88px);
    aspect-ratio: 4 / 4.6;
    padding: 0;
    border: var(--pp-cs-border-width, 2px) solid transparent;
    border-radius: var(--pp-cs-thumb-radius, 14px);
    background: #f5f5f5;
    overflow: visible;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  }

  .pp-color-swatches__item.is-selected {
    order: -1;
    border-color: #111111;
    box-shadow: 0 0 0 1px #111111;
  }

  .pp-color-swatches__item.is-unavailable {
    opacity: 0.55;
    cursor: pointer;
  }

  .pp-color-swatches__item.is-unavailable::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top left,
      transparent calc(50% - 1px),
      #111111 calc(50% - 1px),
      #111111 calc(50% + 1px),
      transparent calc(50% + 1px)
    );
    pointer-events: none;
  }

  .pp-color-swatches__item:not(.is-selected):not(:disabled):hover {
    border-color: #cccccc;
  }

  .pp-color-swatches__item--multi {
    background: linear-gradient(135deg, #e53935 0%, #4caf50 33%, #2196f3 66%, #ffeb3b 100%) !important;
  }

  .pp-color-swatches__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }

  .pp-color-swatches__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 18px;
    font-weight: 600;
    color: #111111;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Colour swatches",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label_name",
      "label": "Label",
      "default": "Colour",
      "info": "Shown as Colour: [name]. Current name comes from metafield custom.color_name."
    },
    {
      "type": "text",
      "id": "option_name",
      "label": "Option name",
      "info": "Leave blank. Colours load from metafield custom.products_color. Only used if that list is empty."
    },
    {
      "type": "checkbox",
      "id": "hide_unavailable",
      "label": "Hide sold out colours",
      "default": false
    },
    {
      "type": "range",
      "id": "thumbnail_width",
      "label": "Thumbnail width",
      "min": 56,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "Thumbnail corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "selected_border_width",
      "label": "Selected border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "label": "Gap between thumbnails",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Colour swatches",
      "category": "Product"
    }
  ]
}
{% endschema %}
