{%- liquid
  assign block_settings = block.settings
  assign product = closest.product | default: product
  assign current_variant = product.selected_or_first_available_variant

  assign color_map = 'dark green:#2e7d32,light blue:#87ceeb,sky blue:#87ceeb,dark brown:#5d4037,purple multi:#9c27b0,black:#111111,white:#ffffff,red:#e53935,blue:#2196f3,green:#4caf50,yellow:#ffeb3b,orange:#ff9800,pink:#e91e63,purple:#9c27b0,magenta:#e040fb,brown:#795548,beige:#f5f5dc,grey:#9e9e9e,gray:#9e9e9e,navy:#1a237e,teal:#009688,cream:#fffdd0,gold:#d4af37,silver:#c0c0c0,burgundy:#800020,maroon:#800000,coral:#ff7f50,mint:#98ff98,olive:#808000,khaki:#f0e68c,ivory:#fffff0,tan:#d2b48c,charcoal:#36454f,wine:#722f37,bronze:#cd7f32,copper:#b87333,lilac:#c8a2c8,lavender:#e6e6fa,peach:#ffcba4,rose:#ff007f,nude:#e3bc9a'
  assign color_map_pairs = color_map | split: ','

  assign option_name_clean = block_settings.option_name | strip
  if option_name_clean != blank
    assign option_name_clean = option_name_clean | remove: ':' | strip
  endif

  assign color_option = nil
  if option_name_clean != blank
    assign option_name_down = option_name_clean | downcase
    for option in product.options_with_values
      assign opt_down = option.name | downcase | strip
      if opt_down == option_name_down
        assign color_option = option
        break
      endif
    endfor
  endif

  if color_option == nil
    for option in product.options_with_values
      assign option_down = option.name | downcase | strip
      if option_down == 'color' or option_down == 'colour' or option_down == 'colors' or option_down == 'colours'
        assign color_option = option
        break
      endif
    endfor
  endif

  if color_option == nil
    assign size_option = nil
    for option in product.options_with_values
      assign opt_name_down = option.name | downcase | strip
      if opt_name_down == 'size'
        assign size_option = option
      endif
    endfor
    for option in product.options_with_values
      assign skip_size_option = false
      if size_option and option.position == size_option.position
        assign skip_size_option = true
      endif
      unless skip_size_option
        assign option_has_swatches = false
        for value in option.values
          if value.swatch.color != blank or value.swatch.image != blank
            assign option_has_swatches = true
            break
          endif
        endfor
        assign option_down = option.name | downcase | strip
        if option_has_swatches or option_down == 'color' or option_down == 'colour'
          assign color_option = option
          break
        endif
      endunless
    endfor
  endif

  assign mf_colors = nil
  if product.metafields.shopify['color-pattern'].value != blank
    assign mf_colors = product.metafields.shopify['color-pattern'].value
  elsif product.metafields.shopify.color.value != blank
    assign mf_colors = product.metafields.shopify.color.value
  elsif product.metafields.custom.colors.value != blank
    assign mf_colors = product.metafields.custom.colors.value
  endif

  assign color_mode = 'none'
  if color_option != nil
    assign color_mode = 'option'
  elsif mf_colors != blank
    assign color_mode = 'metafield'
  endif

  assign label_name = block_settings.label_name | default: 'Colour'
  assign selected_color_value = ''

  if color_mode == 'option'
    assign label_name = color_option.name
    case color_option.position
      when 1
        assign selected_color_value = current_variant.option1
      when 2
        assign selected_color_value = current_variant.option2
      when 3
        assign selected_color_value = current_variant.option3
    endcase
  elsif color_mode == 'metafield'
    assign featured_alt = product.featured_media.alt | default: '' | downcase | strip
    for item in mf_colors
      assign item_label = item.label | default: item
      assign item_down = item_label | downcase | strip
      if featured_alt == item_down
        assign selected_color_value = item_label
        break
      endif
    endfor
    if selected_color_value == blank
      assign first_item = mf_colors | first
      assign selected_color_value = first_item.label | default: first_item
    endif
  endif
-%}

{%- if color_mode != 'none' -%}
  <div
    class="pp-color-swatches"
    id="pp-color-swatches-{{ block.id }}"
    data-color-mode="{{ color_mode }}"
    {% if color_mode == 'option' %}data-option-position="{{ color_option.position }}"{% endif %}
    style="
      --pp-cs-thumb-width: {{ block_settings.thumbnail_width }}px;
      --pp-cs-thumb-radius: {{ block_settings.thumbnail_radius }}px;
      --pp-cs-border-width: {{ block_settings.selected_border_width }}px;
      --pp-cs-gap: {{ block_settings.thumbnail_gap }}px;
    "
    {{ block.shopify_attributes }}
  >
    <p class="pp-color-swatches__label">
      <span class="pp-color-swatches__label-name">{{ label_name }}:</span>
      <span class="pp-color-swatches__value" data-color-label>{{ selected_color_value }}</span>
    </p>

    <div class="pp-color-swatches__list" role="list" aria-label="{{ label_name }} options">
      {%- if color_mode == 'option' -%}
        {%- for value in color_option.values -%}
          {%- liquid
            assign swatch_variant = nil
            assign swatch_image = nil
            assign value_available = false

            if value.swatch.image
              assign swatch_image = value.swatch.image
            endif

            for variant in product.variants
              assign color_matches = false
              if color_option.position == 1 and variant.option1 == value
                assign color_matches = true
              elsif color_option.position == 2 and variant.option2 == value
                assign color_matches = true
              elsif color_option.position == 3 and variant.option3 == value
                assign color_matches = true
              endif

              if color_matches
                if swatch_variant == nil
                  assign swatch_variant = variant
                endif
                if variant.available
                  assign value_available = true
                endif
                if variant.featured_image
                  assign swatch_image = variant.featured_image
                  assign swatch_variant = variant
                endif
              endif
            endfor

            assign value_down = value | downcase | strip
            if swatch_image == nil
              for media in product.media
                assign media_alt_down = media.alt | default: '' | downcase | strip
                if media_alt_down == value_down
                  assign swatch_image = media.preview_image
                  break
                endif
              endfor
            endif

            assign is_selected = false
            if value == selected_color_value
              assign is_selected = true
            endif

            assign show_swatch = true
            if block_settings.hide_unavailable and value_available == false
              assign show_swatch = false
            endif
          -%}

          {%- if show_swatch -%}
            <button
              type="button"
              class="pp-color-swatches__item{% if is_selected %} is-selected{% endif %}{% unless value_available %} is-unavailable{% endunless %}"
              role="listitem"
              title="{{ value }}"
              aria-label="{{ value }}{% unless value_available %} (sold out){% endunless %}"
              aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
              data-color-swatch
              data-option-value="{{ value | escape }}"
              data-variant-id="{{ swatch_variant.id }}"
              {% if swatch_image %}
                data-image-src="{{ swatch_image | image_url: width: 1200 }}"
                data-image-srcset="{{ swatch_image | image_url: width: 600 }} 600w, {{ swatch_image | image_url: width: 1200 }} 1200w"
              {% endif %}
              {% unless value_available %}disabled{% endunless %}
            >
              {%- if swatch_image -%}
                {{
                  swatch_image
                  | image_url: width: 240
                  | image_tag:
                    widths: '120, 180, 240',
                    sizes: '(max-width: 749px) 72px, 96px',
                    alt: value,
                    class: 'pp-color-swatches__img',
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="pp-color-swatches__fallback">{{ value | slice: 0, 1 }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}

      {%- else -%}
        {%- for item in mf_colors -%}
          {%- liquid
            assign color_label = item.label | default: item
            assign color_hex = ''
            assign swatch_image = nil
            assign swatch_url = ''

            if item.color != blank
              assign color_hex = item.color
            endif
            if item.image != blank
              assign swatch_image = item.image
            elsif item.pattern != blank
              assign swatch_image = item.pattern
            elsif item.swatch != blank and item.swatch.image != blank
              assign swatch_image = item.swatch.image
            endif

            if item.product != blank and item.product.value.url != blank
              assign swatch_url = item.product.value.url
            elsif item.product_url != blank
              assign swatch_url = item.product_url
            elsif item.url != blank
              assign swatch_url = item.url
            endif

            assign color_down = color_label | downcase | strip

            if swatch_image == nil
              for media in product.media
                assign media_alt_down = media.alt | default: '' | downcase | strip
                if media_alt_down == color_down
                  assign swatch_image = media.preview_image
                  break
                endif
              endfor
            endif

            if swatch_image == nil
              for variant in product.variants
                if variant.featured_image
                  assign v1 = variant.option1 | downcase
                  assign v2 = variant.option2 | downcase
                  assign v3 = variant.option3 | downcase
                  if v1 == color_down or v2 == color_down or v3 == color_down
                    assign swatch_image = variant.featured_image
                    break
                  endif
                endif
              endfor
            endif

            if color_hex == ''
              for pair in color_map_pairs
                assign pair_parts = pair | split: ':'
                if color_down == pair_parts[0]
                  assign color_hex = pair_parts[1]
                  break
                endif
              endfor
            endif

            assign is_selected = false
            if color_label == selected_color_value
              assign is_selected = true
            endif

            assign is_multi = false
            if color_down contains 'multi' or color_down contains 'geometric' or color_down contains 'print' or color_down contains 'pattern' or color_down contains 'floral' or color_down contains 'stripe' or color_down contains 'abstract'
              assign is_multi = true
            endif
          -%}

          <button
            type="button"
            class="pp-color-swatches__item{% if is_selected %} is-selected{% endif %}{% if is_multi %} pp-color-swatches__item--multi{% elsif color_hex != '' and swatch_image == nil %} pp-color-swatches__item--hex{% endif %}"
            role="listitem"
            title="{{ color_label }}"
            aria-label="{{ color_label }}"
            aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
            data-color-swatch
            data-option-value="{{ color_label | escape }}"
            {% if swatch_image %}
              data-image-src="{{ swatch_image | image_url: width: 1200 }}"
              data-image-srcset="{{ swatch_image | image_url: width: 600 }} 600w, {{ swatch_image | image_url: width: 1200 }} 1200w"
            {% endif %}
            {% if swatch_url != blank %}
              data-product-url="{{ swatch_url }}"
            {% endif %}
            {% if color_hex != '' and is_multi == false and swatch_image == nil %}
              style="background-color: {{ color_hex }};"
            {% endif %}
          >
            {%- if swatch_image -%}
              {{
                swatch_image
                | image_url: width: 240
                | image_tag:
                  widths: '120, 180, 240',
                  sizes: '(max-width: 749px) 72px, 96px',
                  alt: color_label,
                  class: 'pp-color-swatches__img',
                  loading: 'lazy'
              }}
            {%- elsif color_hex == '' -%}
              <span class="pp-color-swatches__fallback">{{ color_label | slice: 0, 1 }}</span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-pp-media-map>
    [
      {%- for media in product.media -%}
        {
          "src": "{{ media | image_url: width: 1200 }}",
          "srcset": "{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w",
          "alt": {{ media.alt | default: '' | json }},
          "id": {{ media.id }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <script>
    (function () {
      var root = document.getElementById('pp-color-swatches-{{ block.id }}');
      if (!root) return;

      var colorMode = root.dataset.colorMode;
      var optionPosition = parseInt(root.dataset.optionPosition, 10);
      var swatches = root.querySelectorAll('[data-color-swatch]');
      var labelEl = root.querySelector('[data-color-label]');
      var variants = {{ product.variants | json }};
      var mediaMap = [];
      var mediaEl = root.querySelector('[data-pp-media-map]');
      if (mediaEl) {
        try { mediaMap = JSON.parse(mediaEl.textContent); } catch (e) {}
      }

      function getScope() {
        return root.closest('[id^="shopify-section-"]')
          || root.closest('.shopify-section')
          || root.closest('product-information')
          || root.closest('.product')
          || document;
      }

      function normValue(v) {
        return (v || '').toString().toLowerCase().trim();
      }

      function getSelectedOptions() {
        var scope = getScope();
        var sel = {};

        scope.querySelectorAll('select[name^="options"]').forEach(function (select) {
          var match = select.name.match(/\[(\d+)\]/);
          if (match && select.value) sel[parseInt(match[1], 10) + 1] = select.value;
        });

        scope.querySelectorAll('input[type="radio"][name^="options"]:checked').forEach(function (radio) {
          var match = radio.name.match(/\[(\d+)\]/);
          if (match) sel[parseInt(match[1], 10) + 1] = radio.value;
        });

        scope.querySelectorAll('.pp-option__btn.is-selected').forEach(function (btn) {
          if (btn.dataset.optionPosition) {
            sel[parseInt(btn.dataset.optionPosition, 10)] = btn.dataset.optionValue;
          }
        });

        return sel;
      }

      function findVariant(sel) {
        return variants.find(function (v) {
          return (!sel[1] || v.option1 === sel[1])
            && (!sel[2] || v.option2 === sel[2])
            && (!sel[3] || v.option3 === sel[3]);
        });
      }

      function syncNativePicker(value) {
        if (colorMode !== 'option') return;
        var scope = getScope();

        scope.querySelectorAll('input[type="radio"][name^="options"]').forEach(function (radio) {
          if (radio.value === value) {
            radio.checked = true;
            radio.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });

        scope.querySelectorAll('select[name^="options"]').forEach(function (select) {
          for (var i = 0; i < select.options.length; i++) {
            if (select.options[i].value === value) {
              select.selectedIndex = i;
              select.dispatchEvent(new Event('change', { bubbles: true }));
              break;
            }
          }
        });

        scope.querySelectorAll(
          'variant-picker button, variant-picker [data-option-value], [data-option-value], .variant-option__button'
        ).forEach(function (btn) {
          var btnValue = btn.value || btn.dataset.optionValue || btn.dataset.value;
          if (btnValue === value) btn.click();
        });

        scope.querySelectorAll('.pp-option__btn[data-option-position="' + optionPosition + '"]').forEach(function (btn) {
          btn.classList.toggle('is-selected', btn.dataset.optionValue === value);
        });
      }

      function findMediaByColor(colorValue) {
        var needle = normValue(colorValue);
        return mediaMap.find(function (m) {
          return m.alt && normValue(m.alt) === needle;
        });
      }

      function updateGallery(variant, swatch, colorValue) {
        var scope = getScope();
        var mediaId = variant && variant.featured_media && variant.featured_media.id;

        if (mediaId) {
          var gallery = scope.querySelector('media-gallery') || document.querySelector('media-gallery');
          if (gallery && typeof gallery.setActiveMedia === 'function') {
            gallery.setActiveMedia(mediaId, true);
            return;
          }
        }

        var src = swatch && swatch.dataset.imageSrc;
        var srcset = swatch && swatch.dataset.imageSrcset;

        if (!src && colorValue) {
          var fromMap = findMediaByColor(colorValue);
          if (fromMap) {
            src = fromMap.src;
            srcset = fromMap.srcset;
            mediaId = fromMap.id;
          }
        }

        if (mediaId) {
          var galleryEl = scope.querySelector('media-gallery') || document.querySelector('media-gallery');
          if (galleryEl && typeof galleryEl.setActiveMedia === 'function') {
            galleryEl.setActiveMedia(mediaId, true);
            return;
          }
        }

        if (!src) return;

        scope.querySelectorAll(
          '.product-media-container img, .product__media img, .pp-main-slide.is-active img, slideshow-slide[aria-hidden="false"] img, [data-main-image] img'
        ).forEach(function (img) {
          img.src = src;
          if (srcset) img.srcset = srcset;
        });
      }

      function setActiveSwatch(swatch, fromUser) {
        if (!swatch || swatch.disabled) return;

        var productUrl = swatch.dataset.productUrl;
        if (fromUser !== false && productUrl && productUrl !== window.location.pathname) {
          window.location.href = productUrl;
          return;
        }

        swatches.forEach(function (item) {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        swatch.classList.add('is-selected');
        swatch.setAttribute('aria-pressed', 'true');

        var value = swatch.dataset.optionValue;
        if (labelEl) labelEl.textContent = value;

        if (colorMode === 'option') {
          if (fromUser !== false) syncNativePicker(value);
          var sel = getSelectedOptions();
          sel[optionPosition] = value;
          var match = findVariant(sel);
          if (match) updateGallery(match, swatch, value);
        } else {
          updateGallery(null, swatch, value);
        }
      }

      swatches.forEach(function (swatch) {
        swatch.addEventListener('click', function () {
          setActiveSwatch(swatch, true);
        });
      });

      if (colorMode === 'option') {
        function onExternalVariantChange(event) {
          var detail = event.detail || {};
          var variant = detail.variant || (detail.data && detail.data.variant);
          if (!variant) return;
          var value = variant['option' + optionPosition];
          if (!value) return;
          swatches.forEach(function (swatch) {
            if (swatch.dataset.optionValue === value) setActiveSwatch(swatch, false);
          });
        }
        document.addEventListener('variant:change', onExternalVariantChange);
        document.addEventListener('variant:update', onExternalVariantChange);
      }
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="pp-color-swatches pp-color-swatches--empty" {{ block.shopify_attributes }}>
    <p class="pp-color-swatches__empty-title">Colour swatches — no colour data found</p>
    <p class="pp-color-swatches__empty-text">
      This product only has: <strong>{{ product.options | join: ', ' }}</strong>.
      Add colours via a <strong>Colour</strong> variant option <em>or</em> a colour metafield
      (<code>shopify.color-pattern</code>, <code>shopify.color</code>, or <code>custom.colors</code>) — same as your collection cards.
      Leave <em>Option name</em> blank.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .pp-color-swatches {
    width: 100%;
    margin: 20px 0 8px;
  }

  .pp-color-swatches--empty {
    padding: 14px 16px;
    border: 1px dashed #cccccc;
    border-radius: 8px;
    background: #fafafa;
  }

  .pp-color-swatches__empty-title {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 700;
    color: #111111;
  }

  .pp-color-swatches__empty-text {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: #555555;
  }

  .pp-color-swatches__empty-text code {
    font-size: 11px;
    background: #eeeeee;
    padding: 1px 4px;
    border-radius: 3px;
  }

  .pp-color-swatches__label {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.4;
    color: #111111;
  }

  .pp-color-swatches__label-name {
    font-weight: 700;
  }

  .pp-color-swatches__value {
    font-weight: 400;
  }

  .pp-color-swatches__list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--pp-cs-gap, 12px);
  }

  .pp-color-swatches__item {
    position: relative;
    width: var(--pp-cs-thumb-width, 88px);
    aspect-ratio: 4 / 4.6;
    padding: 0;
    border: var(--pp-cs-border-width, 2px) solid transparent;
    border-radius: var(--pp-cs-thumb-radius, 14px);
    background: #f5f5f5;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .pp-color-swatches__item.is-selected {
    border-color: #111111;
  }

  .pp-color-swatches__item.is-unavailable {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pp-color-swatches__item:not(.is-selected):not(:disabled):hover {
    border-color: #cccccc;
  }

  .pp-color-swatches__item--multi {
    background: linear-gradient(135deg, #e53935 0%, #4caf50 33%, #2196f3 66%, #ffeb3b 100%) !important;
  }

  .pp-color-swatches__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pp-color-swatches__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 18px;
    font-weight: 600;
    color: #111111;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Colour swatches",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label_name",
      "label": "Label",
      "default": "Colour",
      "info": "Used when colours come from metafields (no Colour variant option)."
    },
    {
      "type": "text",
      "id": "option_name",
      "label": "Option name",
      "info": "Leave blank to auto-detect. Only needed if product has a Colour variant option."
    },
    {
      "type": "checkbox",
      "id": "hide_unavailable",
      "label": "Hide sold out colours",
      "default": false
    },
    {
      "type": "range",
      "id": "thumbnail_width",
      "label": "Thumbnail width",
      "min": 56,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "Thumbnail corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "selected_border_width",
      "label": "Selected border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "label": "Gap between thumbnails",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Colour swatches",
      "category": "Product"
    }
  ]
}
{% endschema %}
