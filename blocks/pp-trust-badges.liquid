{% stylesheet %}
  .pp-trust-badges {
    margin-top: 28px;
    margin-bottom: 8px;
    width: 100%;
  }

  .pp-trust-badges__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pp-trust-badges__item {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1 1 0;
    min-width: 140px;
    max-width: 100%;
  }

  .pp-trust-badges__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #000;
  }

  .pp-trust-badges__icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .pp-trust-badges__text {
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: #000;
  }

  @media (max-width: 749px) {
    .pp-trust-badges__list {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .pp-trust-badges__item {
      flex: none;
      width: 100%;
      min-width: 0;
    }
  }
{% endstylesheet %}

