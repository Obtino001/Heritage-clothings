{% assign block_settings = block.settings %}

<div
  class="email-signup"
  data-block-id="{{ block.id }}"
  data-message-duration="{{ block_settings.message_duration | default: 5 }}"
  style="
    --email-signup-bg: {{ block_settings.background_color | default: '#F5EFE6' }};
    --email-signup-heading-color: {{ block_settings.heading_color | default: '#000000' }};
    --email-signup-text-color: {{ block_settings.text_color | default: '#000000' }};
    --email-signup-border-color: {{ block_settings.input_border_color | default: '#3D3D3D' }};
    --email-signup-button-bg: {{ block_settings.button_background_color | default: '#2D4635' }};
    --email-signup-button-text: {{ block_settings.button_text_color | default: '#FFFFFF' }};
    --email-signup-placeholder: {{ block_settings.placeholder_color | default: '#9A9A9A' }};
    padding-top: {{ block_settings.padding_top | default: 0 }}px;
    padding-bottom: {{ block_settings.padding_bottom | default: 0 }}px;
    padding-left: {{ block_settings.padding_left | default: 0 }}px;
    padding-right: {{ block_settings.padding_right | default: 0 }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="email-signup__inner" style="max-width: {{ block_settings.content_max_width | default: 520 }}px;">
    {% assign heading = block_settings.heading | default: 'Join The Community' %}
    {% if heading != blank %}
      <h2 class="email-signup__heading">{{ heading | escape }}</h2>
    {% endif %}

    {% assign subheading = block_settings.subheading | default: 'Early access. New drops. Exclusive pieces.' %}
    {% if subheading != blank %}
      <p class="email-signup__subheading">{{ subheading | escape }}</p>
    {% endif %}

    {% form 'customer', class: 'email-signup__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="email-signup__fields">
        {% assign placeholder = block_settings.placeholder | default: 'Your Email Address' %}
        <label for="EmailInput-{{ block.id }}" class="email-signup__label-visually-hidden">
          {{ placeholder | escape }}
        </label>
        <input
          id="EmailInput-{{ block.id }}"
          class="email-signup__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ placeholder | escape }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="Email-signup-error-{{ block.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="Email-signup-success-{{ block.id }}"
          {% endif %}
        >

        <button type="submit" class="email-signup__button">
          {{ block_settings.button_label | default: 'Sign Up' | escape }}
        </button>
      </div>

      {% if form.errors %}
        <p
          id="Email-signup-error-{{ block.id }}"
          class="email-signup__message email-signup__message--error"
          data-email-signup-feedback
        >
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {% endif %}

      {% if form.posted_successfully? %}
        <p
          id="Email-signup-success-{{ block.id }}"
          class="email-signup__message email-signup__message--success"
          data-email-signup-feedback
        >
          {{ block_settings.success_message | default: 'Thanks for subscribing!' | escape }}
        </p>
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .email-signup {
    background-color: var(--email-signup-bg);
    width: 100%;
  }

  .email-signup__inner {
    width: 100%;
    text-align: left;
  }


.email-signup__heading { padding-block: 16px 0; color: var(--email-signup-heading-color); }
.email-signup__subheading { margin: 0 0 1.5rem; color: var(--email-signup-text-color); font-weight: 400; font-size: 14px; line-height: 109.00000000000001%; letter-spacing: 0%; margin-block: 20px 22px; }

  .email-signup__form {
    width: 100%;
  }

  .email-signup__fields {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .email-signup__input,
  .email-signup__button {
    display: block;
    width: 100%;
    min-height: 3.25rem;
    border-radius: 9999px;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.2;
    box-sizing: border-box;
  }

.email-signup__input { padding: .875rem 1.5rem; border: 1px solid #5A3A2E !important; background-color: transparent !important; color: var(--email-signup-text-color); outline: none !important; appearance: none !important; }

.email-signup__input::placeholder { color: var(--email-signup-placeholder); font-weight: 400; font-style: Regular; font-size: 12px; line-height: 100%; letter-spacing: 0%; }

.email-signup__button { padding: 14px; border: none; background-color: #2F4A36; color: var(--email-signup-button-text); cursor: pointer; transition: opacity .2s ease,transform .2s ease; font-weight: 500; font-size: 14px; line-height: 100%; letter-spacing: 0%; text-align: center; }

  .email-signup__button:hover {
    opacity: 0.92;
  }

  .email-signup__button:active {
    transform: scale(0.99);
  }

  .email-signup__message {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .email-signup__message--error {
    color: #b42318;
  }

  .email-signup__message {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    margin-top: 16px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    animation: fadeInUp 0.4s ease;
}

.email-signup__message--success {
    color: #155724;
    background: #eaf8ef;
    border: 1px solid #b7e4c7;
    box-shadow: 0 4px 12px rgba(21, 87, 36, 0.08);
}

.email-signup__message[data-email-signup-feedback]:not(.email-signup__message--visible) {
    display: none;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeOutDown {
    from {
        opacity: 1;
        transform: translateY(0);
    }
    to {
        opacity: 0;
        transform: translateY(8px);
    }
}

.email-signup__message--dismissing {
    animation: fadeOutDown 0.4s ease forwards;
    pointer-events: none;
}

  .email-signup__label-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% javascript %}
  const EMAIL_SIGNUP_SUBMIT_PREFIX = 'email-signup-submit-';

  function cleanCustomerFormUrl() {
    const url = new URL(window.location.href);
    let changed = false;

    if (url.searchParams.has('customer_posted')) {
      url.searchParams.delete('customer_posted');
      changed = true;
    }

    if (url.searchParams.get('form_type') === 'customer') {
      url.searchParams.delete('form_type');
      changed = true;
    }

    for (const key of [...url.searchParams.keys()]) {
      if (key.startsWith('contact[')) {
        url.searchParams.delete(key);
        changed = true;
      }
    }

    if (changed) {
      const nextUrl = `${url.pathname}${url.search}${url.hash}`;
      history.replaceState({}, '', nextUrl);
    }
  }

  function resetEmailSignupInput(signup) {
    const input = signup.querySelector('.email-signup__input');
    if (!input) return;

    input.removeAttribute('aria-describedby');
    input.removeAttribute('aria-invalid');
  }

  function dismissEmailSignupMessage(signup, message, durationSeconds) {
    const dismissDelay = Number.isFinite(durationSeconds) && durationSeconds > 0
      ? durationSeconds * 1000
      : 5000;

    window.setTimeout(() => {
      message.classList.add('email-signup__message--dismissing');
      message.addEventListener(
        'animationend',
        () => {
          resetEmailSignupInput(signup);
          message.remove();
        },
        { once: true }
      );
    }, dismissDelay);
  }

  document.querySelectorAll('.email-signup').forEach((signup) => {
    const blockId = signup.dataset.blockId;
    const form = signup.querySelector('.email-signup__form');
    const feedbackMessages = signup.querySelectorAll('[data-email-signup-feedback]');
    const submitKey = `${EMAIL_SIGNUP_SUBMIT_PREFIX}${blockId}`;
    const durationSeconds = Number.parseInt(signup.dataset.messageDuration, 10);

    if (form) {
      form.addEventListener('submit', () => {
        sessionStorage.setItem(submitKey, '1');
      });
    }

    if (!feedbackMessages.length) return;

    const isFreshSubmission = sessionStorage.getItem(submitKey) === '1';

    if (isFreshSubmission) {
      sessionStorage.removeItem(submitKey);
      cleanCustomerFormUrl();

      feedbackMessages.forEach((message) => {
        message.classList.add('email-signup__message--visible');
        dismissEmailSignupMessage(signup, message, durationSeconds);
      });

      return;
    }

    feedbackMessages.forEach((message) => message.remove());
    resetEmailSignupInput(signup);
    cleanCustomerFormUrl();
  });
{% endjavascript %}

