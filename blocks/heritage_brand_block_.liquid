<style>

  .heritage_brand_block_{
  max-width:320px;
}

.heritage_brand_block_logo_{
  margin-bottom:14px;
}

.heritage_brand_block_logo_ img{
  width:100%;
  max-width:220px;
  display:block;
}

.heritage_brand_block_text_{
  margin-bottom: 22px;
  color: #000000;
  font-family: Neue Montreal;
font-weight: 400;
font-size: 14px;
line-height: 120.00000000000001%;
letter-spacing: 0%;

}

.heritage_brand_block_socials_{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}



.heritage_brand_block_socials_ a{
  width:32px;
  height:32px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;
    transition: all ease 0.5s;

  color:#fff;
  text-decoration:none;
  font-size:12px;
}

.heritage_brand_block_socials_ a:hover{    transform: scale(1.1);}



@media (max-width: 500px){
     .heritage_brand_block_socials_{
        display: flex; justify-content: center; position: absolute; bottom: 25px; width: -webkit-fill-available;
    }

     .heritage_brand_block_ {
    max-width: 100%;
}
}
</style>


